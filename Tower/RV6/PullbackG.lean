import Mathlib
import Tower.RV6.PullbackF
import Tower.RV6.ZeroG

/-!
# The pull-back for `g`: `v₀(x(y)) / Z(y)` is a quadratic in `y`

Generated by `tools/gen_pullbackg.py`.  `v_k(x) = -AJ(θ^{k+1} g)(x)/x²` (`vG0` … `vG3`):

* `hasDerivAt_vG0` … `vG2`: `v_k' = -(2v_k + v_{k+1})/x` (R1), the relation of `hk(θᵏ f)` in `HankelDeriv.lean`;
* `uGv`, the operator of `uF` applied to the `v_k`, equals `uG`, so `uGv = 0` (`uGv_zero`, from `uG_zero`);
* the pull-back of `PullbackF.lean` with `A_k` replaced by `v_k`: `hG0 = v₀/Z`, `hG1`, `hG2`,
  `D hG2 = -(π³/256) P Z uGv(x) = 0`, and **`vG0_xm_quad`**: `v₀(xm y) = (a + b y + c y²) Zax y` for `y > 0`.
-/

namespace Tower.RV6

open Real

/-- `v_0 = -AJ(θ^1 g)/x²`. -/
noncomputable def vG0 (x : ℝ) : ℝ := -(AJ thG1 x) / x ^ 2

/-- `v_1 = -AJ(θ^2 g)/x²`. -/
noncomputable def vG1 (x : ℝ) : ℝ := -(AJ thG2 x) / x ^ 2

/-- `v_2 = -AJ(θ^3 g)/x²`. -/
noncomputable def vG2 (x : ℝ) : ℝ := -(AJ thG3 x) / x ^ 2

/-- `v_3 = -AJ(θ^4 g)/x²`. -/
noncomputable def vG3 (x : ℝ) : ℝ := -(AJ thG4 x) / x ^ 2

theorem hasDerivAt_vG0 {x : ℝ} (hx : 0 < x) :
    HasDerivAt vG0 (-(2 * vG0 x + vG1 x) / x) x := by
  have hA := hasDerivAt_AJ_thG1 hx
  have h : HasDerivAt (fun y : ℝ => -(AJ thG1 y) / y ^ 2)
      ((-(-(AJ thG2 x) / x) * x ^ 2 - -(AJ thG1 x) * (2 * x)) / (x ^ 2) ^ 2) x :=
    (hA.neg).div (hasDerivAt_sqx x) (pow_ne_zero 2 hx.ne')
  have h' : HasDerivAt vG0
      ((-(-(AJ thG2 x) / x) * x ^ 2 - -(AJ thG1 x) * (2 * x)) / (x ^ 2) ^ 2) x := h
  refine h'.congr_deriv ?_
  have hxi : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  unfold vG0 vG1
  linear_combination (2*AJ thG1 x*x⁻¹^3 + AJ thG2 x*x*x⁻¹^4 + AJ thG2 x*x⁻¹^3) * hxi

theorem hasDerivAt_vG1 {x : ℝ} (hx : 0 < x) :
    HasDerivAt vG1 (-(2 * vG1 x + vG2 x) / x) x := by
  have hA := hasDerivAt_AJ_thG2 hx
  have h : HasDerivAt (fun y : ℝ => -(AJ thG2 y) / y ^ 2)
      ((-(-(AJ thG3 x) / x) * x ^ 2 - -(AJ thG2 x) * (2 * x)) / (x ^ 2) ^ 2) x :=
    (hA.neg).div (hasDerivAt_sqx x) (pow_ne_zero 2 hx.ne')
  have h' : HasDerivAt vG1
      ((-(-(AJ thG3 x) / x) * x ^ 2 - -(AJ thG2 x) * (2 * x)) / (x ^ 2) ^ 2) x := h
  refine h'.congr_deriv ?_
  have hxi : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  unfold vG1 vG2
  linear_combination (2*AJ thG2 x*x⁻¹^3 + AJ thG3 x*x*x⁻¹^4 + AJ thG3 x*x⁻¹^3) * hxi

theorem hasDerivAt_vG2 {x : ℝ} (hx : 0 < x) :
    HasDerivAt vG2 (-(2 * vG2 x + vG3 x) / x) x := by
  have hA := hasDerivAt_AJ_thG3 hx
  have h : HasDerivAt (fun y : ℝ => -(AJ thG3 y) / y ^ 2)
      ((-(-(AJ thG4 x) / x) * x ^ 2 - -(AJ thG3 x) * (2 * x)) / (x ^ 2) ^ 2) x :=
    (hA.neg).div (hasDerivAt_sqx x) (pow_ne_zero 2 hx.ne')
  have h' : HasDerivAt vG2
      ((-(-(AJ thG4 x) / x) * x ^ 2 - -(AJ thG3 x) * (2 * x)) / (x ^ 2) ^ 2) x := h
  refine h'.congr_deriv ?_
  have hxi : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  unfold vG2 vG3
  linear_combination (2*AJ thG3 x*x⁻¹^3 + AJ thG4 x*x*x⁻¹^4 + AJ thG4 x*x⁻¹^3) * hxi

/-- The operator of `uF` on the `v_k`. -/
noncomputable def uGv (x : ℝ) : ℝ :=
  ((-1) * x ^ 4 + (-20) * x ^ 2 + (-64)) * vG3 x +
    (0 * x ^ 4 + (-60) * x ^ 2 + (-384)) * vG2 x +
    (0 * x ^ 4 + (-72) * x ^ 2 + (-768)) * vG1 x +
    (0 * x ^ 4 + (-32) * x ^ 2 + (-512)) * vG0 x

theorem uGv_eq_uG {x : ℝ} (hx : 0 < x) : uGv x = uG x := by
  have hxi : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  unfold uGv uG vG0 vG1 vG2 vG3
  linear_combination (32*AJ thG1 x*x*x⁻¹ + 32*AJ thG1 x + 72*AJ thG2 x*x*x⁻¹ + 72*AJ thG2 x + 60*AJ thG3 x*x*x⁻¹ + 60*AJ thG3 x + AJ thG4 x*x^3*x⁻¹ + AJ thG4 x*x^2 + 20*AJ thG4 x*x*x⁻¹ + 20*AJ thG4 x) * hxi

theorem uGv_zero {x : ℝ} (hx : 0 < x) : uGv x = 0 := by
  rw [uGv_eq_uG hx, uG_zero hx]

/-- `D A_0 = (π/4) P (2 A_0 + A_1)`. -/
theorem hasDerivAt_vGxm0 {y : ℝ} (hy : 0 < y) :
    HasDerivAt (fun y : ℝ => vG0 (xm y))
      (π / 4 * Pax y * (2 * vG0 (xm y) + vG1 (xm y))) y := by
  have h := (hasDerivAt_vG0 (xm_pos y)).comp y (hasDerivAt_xm hy)
  have h' : HasDerivAt (fun y : ℝ => vG0 (xm y))
      (-(2 * vG0 (xm y) + vG1 (xm y)) / xm y * (-(π / 4) * Pax y * xm y)) y := h
  have hx : xm y * (xm y)⁻¹ = 1 := mul_inv_cancel₀ (xm_pos y).ne'
  exact h'.congr_deriv (by
    linear_combination (π / 4 * Pax y * (2 * vG0 (xm y) + vG1 (xm y))) * hx)


/-- `D A_1 = (π/4) P (2 A_1 + A_2)`. -/
theorem hasDerivAt_vGxm1 {y : ℝ} (hy : 0 < y) :
    HasDerivAt (fun y : ℝ => vG1 (xm y))
      (π / 4 * Pax y * (2 * vG1 (xm y) + vG2 (xm y))) y := by
  have h := (hasDerivAt_vG1 (xm_pos y)).comp y (hasDerivAt_xm hy)
  have h' : HasDerivAt (fun y : ℝ => vG1 (xm y))
      (-(2 * vG1 (xm y) + vG2 (xm y)) / xm y * (-(π / 4) * Pax y * xm y)) y := h
  have hx : xm y * (xm y)⁻¹ = 1 := mul_inv_cancel₀ (xm_pos y).ne'
  exact h'.congr_deriv (by
    linear_combination (π / 4 * Pax y * (2 * vG1 (xm y) + vG2 (xm y))) * hx)


/-- `D A_2 = (π/4) P (2 A_2 + A_3)`. -/
theorem hasDerivAt_vGxm2 {y : ℝ} (hy : 0 < y) :
    HasDerivAt (fun y : ℝ => vG2 (xm y))
      (π / 4 * Pax y * (2 * vG2 (xm y) + vG3 (xm y))) y := by
  have h := (hasDerivAt_vG2 (xm_pos y)).comp y (hasDerivAt_xm hy)
  have h' : HasDerivAt (fun y : ℝ => vG2 (xm y))
      (-(2 * vG2 (xm y) + vG3 (xm y)) / xm y * (-(π / 4) * Pax y * xm y)) y := h
  have hx : xm y * (xm y)⁻¹ = 1 := mul_inv_cancel₀ (xm_pos y).ne'
  exact h'.congr_deriv (by
    linear_combination (π / 4 * Pax y * (2 * vG2 (xm y) + vG3 (xm y))) * hx)


/-- `A₀ / Z`. -/
noncomputable def hG0 (y : ℝ) : ℝ := vG0 (xm y) * (Zax y)⁻¹

/-- `D (A₀ / Z)`. -/
noncomputable def hG1 (y : ℝ) : ℝ :=
  ((2 : ℝ) * π) * (vG0 (xm y) * Eax y * (Zax y)⁻¹) +
    ((1 / 2 : ℝ) * π) * (vG0 (xm y) * Pax y * (Zax y)⁻¹) +
    ((1 / 4 : ℝ) * π) * (vG1 (xm y) * Pax y * (Zax y)⁻¹)

/-- `D² (A₀ / Z)`. -/
noncomputable def hG2 (y : ℝ) : ℝ :=
  ((2 : ℝ) * π ^ 2) * (vG0 (xm y) * Eax y * Eax y * (Zax y)⁻¹) +
    ((1 : ℝ) * π ^ 2) * (vG0 (xm y) * Pax y * Eax y * (Zax y)⁻¹) +
    ((1 / 4 : ℝ) * π ^ 2) * (vG0 (xm y) * Pax y * Pax y * (Zax y)⁻¹) +
    ((-24 : ℝ) * π ^ 2) * (vG0 (xm y) * Uax y) +
    ((-128 : ℝ) * π ^ 2) * (vG0 (xm y) * Uax y * Uax y * (Zax y)⁻¹) +
    ((1 / 2 : ℝ) * π ^ 2) * (vG1 (xm y) * Pax y * Eax y * (Zax y)⁻¹) +
    ((1 / 4 : ℝ) * π ^ 2) * (vG1 (xm y) * Pax y * Pax y * (Zax y)⁻¹) +
    ((-20 : ℝ) * π ^ 2) * (vG1 (xm y) * Uax y) +
    ((-128 : ℝ) * π ^ 2) * (vG1 (xm y) * Uax y * Uax y * (Zax y)⁻¹) +
    ((1 / 16 : ℝ) * π ^ 2) * (vG2 (xm y) * Pax y * Pax y * (Zax y)⁻¹)

theorem hasDerivAt_hG0 {y : ℝ} (hy : 0 < y) : HasDerivAt hG0 (hG1 y) y := by
  have hinv : Zax y * (Zax y)⁻¹ = 1 := mul_inv_cancel₀ (Zax_pos hy).ne'
  have dA0 := hasDerivAt_vGxm0 hy
  have dW := (hasDerivAt_Zax hy).inv (Zax_pos hy).ne'
  have h := dA0.mul dW
  exact h.congr_deriv (by
    unfold hG1
    linear_combination (((2 : ℝ) * π) * (vG0 (xm y) * Eax y * (Zax y)⁻¹)) * hinv)

theorem hasDerivAt_hG1 {y : ℝ} (hy : 0 < y) : HasDerivAt hG1 (hG2 y) y := by
  have hinv : Zax y * (Zax y)⁻¹ = 1 := mul_inv_cancel₀ (Zax_pos hy).ne'
  have dA0 := hasDerivAt_vGxm0 hy
  have dA1 := hasDerivAt_vGxm1 hy
  have dP := hasDerivAt_Pax hy
  have dE := hasDerivAt_Eax hy
  have dW := (hasDerivAt_Zax hy).inv (Zax_pos hy).ne'
  have m1 := ((dA0.mul dE).mul dW).const_mul ((2 : ℝ) * π)
  have m2 := ((dA0.mul dP).mul dW).const_mul ((1 / 2 : ℝ) * π)
  have m3 := ((dA1.mul dP).mul dW).const_mul ((1 / 4 : ℝ) * π)
  have h := (m1.add m2).add m3
  exact h.congr_deriv (by
    unfold hG2
    simp only [Pi.mul_apply, Pi.inv_apply]
    linear_combination (((4 : ℝ) * π ^ 2) * (vG0 (xm y) * Eax y * Eax y * (Zax y)⁻¹) + ((1 : ℝ) * π ^ 2) * (vG0 (xm y) * Pax y * Eax y * (Zax y)⁻¹) + ((-24 : ℝ) * π ^ 2) * (vG0 (xm y) * Uax y) + ((1 / 2 : ℝ) * π ^ 2) * (vG1 (xm y) * Pax y * Eax y * (Zax y)⁻¹) + ((-20 : ℝ) * π ^ 2) * (vG1 (xm y) * Uax y)) * hinv)

/-- **`D³ (A₀ / Z) = -(π³/256) P Z uGv(x)`**. -/
theorem hasDerivAt_hG2 {y : ℝ} (hy : 0 < y) :
    HasDerivAt hG2 (-(π ^ 3 / 256) * Pax y * Zax y * uGv (xm y)) y := by
  have hinv : Zax y * (Zax y)⁻¹ = 1 := mul_inv_cancel₀ (Zax_pos hy).ne'
  have dA0 := hasDerivAt_vGxm0 hy
  have dA1 := hasDerivAt_vGxm1 hy
  have dA2 := hasDerivAt_vGxm2 hy
  have dP := hasDerivAt_Pax hy
  have dE := hasDerivAt_Eax hy
  have dU := hasDerivAt_Uax hy
  have dW := (hasDerivAt_Zax hy).inv (Zax_pos hy).ne'
  have hP2 := Pax_sq hy
  have hx2 : xm y ^ 2 = 64 * Uax y * (Zax y)⁻¹ := by
    rw [xm_sq hy, div_eq_mul_inv]
  have m1 := (((dA0.mul dE).mul dE).mul dW).const_mul ((2 : ℝ) * π ^ 2)
  have m2 := (((dA0.mul dP).mul dE).mul dW).const_mul ((1 : ℝ) * π ^ 2)
  have m3 := (((dA0.mul dP).mul dP).mul dW).const_mul ((1 / 4 : ℝ) * π ^ 2)
  have m4 := (dA0.mul dU).const_mul ((-24 : ℝ) * π ^ 2)
  have m5 := (((dA0.mul dU).mul dU).mul dW).const_mul ((-128 : ℝ) * π ^ 2)
  have m6 := (((dA1.mul dP).mul dE).mul dW).const_mul ((1 / 2 : ℝ) * π ^ 2)
  have m7 := (((dA1.mul dP).mul dP).mul dW).const_mul ((1 / 4 : ℝ) * π ^ 2)
  have m8 := (dA1.mul dU).const_mul ((-20 : ℝ) * π ^ 2)
  have m9 := (((dA1.mul dU).mul dU).mul dW).const_mul ((-128 : ℝ) * π ^ 2)
  have m10 := (((dA2.mul dP).mul dP).mul dW).const_mul ((1 / 16 : ℝ) * π ^ 2)
  have h := ((((((((m1.add m2).add m3).add m4).add m5).add m6).add m7).add m8).add m9).add m10
  exact h.congr_deriv (by
    unfold uGv
    simp only [Pi.mul_apply, Pi.inv_apply]
    linear_combination (((4 : ℝ) * π ^ 3) * (vG0 (xm y) * Eax y * Eax y * Eax y * (Zax y)⁻¹) + ((-48 : ℝ) * π ^ 3) * (vG0 (xm y) * Eax y * Uax y) + ((256 : ℝ) * π ^ 3) * (vG0 (xm y) * Eax y * Uax y * Uax y * (Zax y)⁻¹) + ((2 : ℝ) * π ^ 3) * (vG0 (xm y) * Pax y * Eax y * Eax y * (Zax y)⁻¹) + ((2 : ℝ) * π ^ 3) * (vG0 (xm y) * Pax y * Zax y) + ((160 : ℝ) * π ^ 3) * (vG0 (xm y) * Zax y * Eax y * Uax y * (Zax y)⁻¹) + ((8 : ℝ) * π ^ 3) * (vG0 (xm y) * Zax y * Zax y * Eax y * (Zax y)⁻¹) + ((-40 : ℝ) * π ^ 3) * (vG1 (xm y) * Eax y * Uax y) + ((256 : ℝ) * π ^ 3) * (vG1 (xm y) * Eax y * Uax y * Uax y * (Zax y)⁻¹) + ((1 : ℝ) * π ^ 3) * (vG1 (xm y) * Pax y * Eax y * Eax y * (Zax y)⁻¹) + ((6 : ℝ) * π ^ 3) * (vG1 (xm y) * Pax y * Uax y) + ((3 : ℝ) * π ^ 3) * (vG1 (xm y) * Pax y * Zax y) + ((160 : ℝ) * π ^ 3) * (vG1 (xm y) * Zax y * Eax y * Uax y * (Zax y)⁻¹) + ((8 : ℝ) * π ^ 3) * (vG1 (xm y) * Zax y * Zax y * Eax y * (Zax y)⁻¹) + ((128 : ℝ) * π ^ 3) * (vG2 (xm y) * Eax y * Uax y * Uax y * (Zax y)⁻¹) + ((5 : ℝ) * π ^ 3) * (vG2 (xm y) * Pax y * Uax y) + ((3 / 2 : ℝ) * π ^ 3) * (vG2 (xm y) * Pax y * Zax y) + ((40 : ℝ) * π ^ 3) * (vG2 (xm y) * Zax y * Eax y * Uax y * (Zax y)⁻¹) + ((2 : ℝ) * π ^ 3) * (vG2 (xm y) * Zax y * Zax y * Eax y * (Zax y)⁻¹) + ((-16 : ℝ) * π ^ 3) * (vG3 (xm y) * Pax y * Uax y * Uax y * (Zax y)⁻¹) + ((1 / 4 : ℝ) * π ^ 3) * (vG3 (xm y) * Pax y * Zax y)) * hinv + (((-1 / 2 : ℝ) * π ^ 3) * (vG0 (xm y) * Eax y * (Zax y)⁻¹) + ((1 / 8 : ℝ) * π ^ 3) * (vG0 (xm y) * Pax y * (Zax y)⁻¹) + ((1 / 2 : ℝ) * π ^ 3) * (vG0 (xm y) * Zax y * Eax y * (Zax y)⁻¹ * (Zax y)⁻¹) + ((-1 / 2 : ℝ) * π ^ 3) * (vG1 (xm y) * Eax y * (Zax y)⁻¹) + ((3 / 16 : ℝ) * π ^ 3) * (vG1 (xm y) * Pax y * (Zax y)⁻¹) + ((1 / 2 : ℝ) * π ^ 3) * (vG1 (xm y) * Zax y * Eax y * (Zax y)⁻¹ * (Zax y)⁻¹) + ((-1 / 8 : ℝ) * π ^ 3) * (vG2 (xm y) * Eax y * (Zax y)⁻¹) + ((3 / 32 : ℝ) * π ^ 3) * (vG2 (xm y) * Pax y * (Zax y)⁻¹) + ((1 / 8 : ℝ) * π ^ 3) * (vG2 (xm y) * Zax y * Eax y * (Zax y)⁻¹ * (Zax y)⁻¹) + ((1 / 64 : ℝ) * π ^ 3) * (vG3 (xm y) * Pax y * (Zax y)⁻¹)) * hP2 + (((-1 / 8 : ℝ) * π ^ 3) * (vG0 (xm y) * Pax y * Zax y) + ((-9 / 32 : ℝ) * π ^ 3) * (vG1 (xm y) * Pax y * Zax y) + ((-15 / 64 : ℝ) * π ^ 3) * (vG2 (xm y) * Pax y * Zax y) + ((-5 / 64 : ℝ) * π ^ 3) * (vG3 (xm y) * Pax y * Zax y) + ((-1 / 4 : ℝ) * π ^ 3) * (vG3 (xm y) * Pax y * Zax y * Uax y * (Zax y)⁻¹) + ((-1 / 256 : ℝ) * π ^ 3) * (vG3 (xm y) * Pax y * Zax y * xm y * xm y)) * hx2)

theorem hasDerivAt_hG2_zero {y : ℝ} (hy : 0 < y) : HasDerivAt hG2 0 y := by
  have h := hasDerivAt_hG2 hy
  rw [uGv_zero (xm_pos y), mul_zero] at h
  exact h


/-- **`v₀(xm y) = (a + b y + c y²) Zax y`** for `y > 0`. -/
theorem vG0_xm_quad : ∃ a b c : ℝ, ∀ y : ℝ, 0 < y →
    vG0 (xm y) = (a + b * y + c * y ^ 2) * Zax y := by
  obtain ⟨a, b, c, h⟩ := quad_of_third_deriv_zero (g := hG0) (g1 := hG1) (g2 := hG2)
    (fun y hy => hasDerivAt_hG0 hy) (fun y hy => hasDerivAt_hG1 hy)
    (fun y hy => hasDerivAt_hG2_zero hy)
  refine ⟨a, b, c, fun y hy => ?_⟩
  have e : vG0 (xm y) * (Zax y)⁻¹ = a + b * y + c * y ^ 2 := h y hy
  have hz : Zax y * (Zax y)⁻¹ = 1 := mul_inv_cancel₀ (Zax_pos hy).ne'
  linear_combination (Zax y) * e + (-(vG0 (xm y))) * hz

