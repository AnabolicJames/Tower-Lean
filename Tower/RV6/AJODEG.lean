import Mathlib
import Tower.RV6.DomG
import Tower.RV6.Bilin
import Tower.RV6.HankelODEF

/-!
# The dual equation of `g = I₀² K₀²` under the `J₁` transform

Generated by `tools/gen_ajodeg.py`.  With `A_k = AJ (θᵏ g)`:

* `AJ_lin3`, `AJ_lin4`, `AJ_lin5`, `AJ_const_mul`: `AJ` is linear on `PDom`;
* `hasDerivAt_AJ_thG0` … `hasDerivAt_AJ_thG4`: R1, `A_k' = -A_{k+1}/x`;
* `AJ_R2_gQ1`, `AJ_R2_gQ2`, `AJ_R2_gR`: R2 on `(θ+2)²g`, `(θ+2)³g` and `-θ⁵g/(4t²)`;
* **`AJ_rel`**: `64 θ(θ+2)³(θ+4) A + 4x² θ(θ+2)P₃(θ) A + x⁴ A₅ = 0`;
* **`uG_eq`**: `uG = x² A₄ + 4(5A₄ + 15A₃ + 18A₂ + 8A₁) + 64 x⁻² (A₄ + 6A₃ + 12A₂ + 8A₁) = c x²`
  (`x uG' - 2uG = -rel/x² = 0`).
-/

namespace Tower.RV6

open Real MeasureTheory

/-! ## Linearity of `AJ` on `PDom` -/

theorem integrable_J1_mul_of_pdom {ψ : ℝ → ℝ} (hψ : PDom ψ) {x : ℝ} (hx : 0 < x) :
    Integrable (fun t : ℝ => besselJ1 (x * t) * ψ t) (volume.restrict (Set.Ioi (0 : ℝ))) := by
  have hi : Integrable ψ (volume.restrict (Set.Ioi (0 : ℝ))) := pdom_integrableOn hψ
  have hm : AEStronglyMeasurable (fun t : ℝ => besselJ1 (x * t) * ψ t)
      (volume.restrict (Set.Ioi (0 : ℝ))) :=
    ((continuous_besselJ1_mul' x).continuousOn.mul hψ.1).aestronglyMeasurable measurableSet_Ioi
  refine hi.norm.mono' hm (ae_restrict_of_forall_mem measurableSet_Ioi (fun t ht => ?_))
  have ht0 : (0 : ℝ) < t := ht
  have hJ := abs_besselJ1_le_one (mul_nonneg hx.le ht0.le)
  show ‖besselJ1 (x * t) * ψ t‖ ≤ ‖ψ t‖
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_mul]
  calc |besselJ1 (x * t)| * |ψ t| ≤ 1 * |ψ t| := mul_le_mul_of_nonneg_right hJ (abs_nonneg _)
    _ = |ψ t| := one_mul _

theorem AJ_const_mul (c : ℝ) (ψ : ℝ → ℝ) (x : ℝ) : AJ (fun t : ℝ => c * ψ t) x = c * AJ ψ x := by
  have h : (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c * ψ t))
      = c * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * ψ t := by
    rw [← integral_const_mul]
    congr 1
    funext t
    ring
  show x * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c * ψ t))
    = c * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * ψ t)
  rw [h]
  ring

theorem AJ_lin3 {f1 f2 f3 : ℝ → ℝ} (h1 : PDom f1) (h2 : PDom f2) (h3 : PDom f3) (c1 c2 c3 : ℝ) {x : ℝ} (hx : 0 < x) :
    AJ (fun t : ℝ => c1 * f1 t + c2 * f2 t + c3 * f3 t) x = c1 * AJ f1 x + c2 * AJ f2 x + c3 * AJ f3 x := by
  have i1 := integrable_J1_mul_of_pdom h1 hx
  have i2 := integrable_J1_mul_of_pdom h2 hx
  have i3 := integrable_J1_mul_of_pdom h3 hx
  have hI : (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c1 * f1 t + c2 * f2 t + c3 * f3 t))
      = ∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t)) := by
    congr 1
    funext t
    ring
  have hL : (∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t))) = c1 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f1 t) + c2 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f2 t) + c3 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f3 t) :=
    integral_lin3 i1 i2 i3 c1 c2 c3
  show x * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c1 * f1 t + c2 * f2 t + c3 * f3 t))
    = c1 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f1 t) + c2 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f2 t) + c3 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f3 t)
  rw [hI, hL]
  ring

theorem AJ_lin4 {f1 f2 f3 f4 : ℝ → ℝ} (h1 : PDom f1) (h2 : PDom f2) (h3 : PDom f3) (h4 : PDom f4) (c1 c2 c3 c4 : ℝ) {x : ℝ} (hx : 0 < x) :
    AJ (fun t : ℝ => c1 * f1 t + c2 * f2 t + c3 * f3 t + c4 * f4 t) x = c1 * AJ f1 x + c2 * AJ f2 x + c3 * AJ f3 x + c4 * AJ f4 x := by
  have i1 := integrable_J1_mul_of_pdom h1 hx
  have i2 := integrable_J1_mul_of_pdom h2 hx
  have i3 := integrable_J1_mul_of_pdom h3 hx
  have i4 := integrable_J1_mul_of_pdom h4 hx
  have hI : (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c1 * f1 t + c2 * f2 t + c3 * f3 t + c4 * f4 t))
      = ∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t)) := by
    congr 1
    funext t
    ring
  have hL : (∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t))) = c1 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f1 t) + c2 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f2 t) + c3 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f3 t) + c4 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f4 t) :=
    integral_lin4 i1 i2 i3 i4 c1 c2 c3 c4
  show x * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c1 * f1 t + c2 * f2 t + c3 * f3 t + c4 * f4 t))
    = c1 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f1 t) + c2 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f2 t) + c3 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f3 t) + c4 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f4 t)
  rw [hI, hL]
  ring

theorem AJ_lin5 {f1 f2 f3 f4 f5 : ℝ → ℝ} (h1 : PDom f1) (h2 : PDom f2) (h3 : PDom f3) (h4 : PDom f4) (h5 : PDom f5) (c1 c2 c3 c4 c5 : ℝ) {x : ℝ} (hx : 0 < x) :
    AJ (fun t : ℝ => c1 * f1 t + c2 * f2 t + c3 * f3 t + c4 * f4 t + c5 * f5 t) x = c1 * AJ f1 x + c2 * AJ f2 x + c3 * AJ f3 x + c4 * AJ f4 x + c5 * AJ f5 x := by
  have i1 := integrable_J1_mul_of_pdom h1 hx
  have i2 := integrable_J1_mul_of_pdom h2 hx
  have i3 := integrable_J1_mul_of_pdom h3 hx
  have i4 := integrable_J1_mul_of_pdom h4 hx
  have i5 := integrable_J1_mul_of_pdom h5 hx
  have hI : (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c1 * f1 t + c2 * f2 t + c3 * f3 t + c4 * f4 t + c5 * f5 t))
      = ∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t) + c5 * (besselJ1 (x * t) * f5 t)) := by
    congr 1
    funext t
    ring
  have j4 : Integrable (fun t : ℝ => c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t)) (volume.restrict (Set.Ioi (0 : ℝ))) :=
    (integrable_lin3 i1 i2 i3 c1 c2 c3).add (i4.const_mul c4)
  have j5 : Integrable (fun t : ℝ => c5 * (besselJ1 (x * t) * f5 t)) (volume.restrict (Set.Ioi (0 : ℝ))) :=
    i5.const_mul c5
  have e5 : (∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t) + c5 * (besselJ1 (x * t) * f5 t)))
      = (∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t))) + ∫ t in Set.Ioi (0 : ℝ), c5 * (besselJ1 (x * t) * f5 t) :=
    integral_add j4 j5
  have hL : (∫ t in Set.Ioi (0 : ℝ), (c1 * (besselJ1 (x * t) * f1 t) + c2 * (besselJ1 (x * t) * f2 t) + c3 * (besselJ1 (x * t) * f3 t) + c4 * (besselJ1 (x * t) * f4 t))) = c1 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f1 t) + c2 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f2 t) + c3 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f3 t) + c4 * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f4 t) :=
    integral_lin4 i1 i2 i3 i4 c1 c2 c3 c4
  have m5 : (∫ t in Set.Ioi (0 : ℝ), c5 * (besselJ1 (x * t) * f5 t))
      = c5 * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f5 t :=
    integral_const_mul c5 (fun t : ℝ => besselJ1 (x * t) * f5 t)
  show x * (∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * (c1 * f1 t + c2 * f2 t + c3 * f3 t + c4 * f4 t + c5 * f5 t))
    = c1 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f1 t) + c2 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f2 t) + c3 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f3 t) + c4 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f4 t) + c5 * (x * ∫ t in Set.Ioi (0 : ℝ), besselJ1 (x * t) * f5 t)
  rw [hI, e5, hL, m5]
  ring

/-- `t² φ` is in `PDom` when `φ` is and `t⁴ |φ|` is bounded on `[1, ∞)`. -/
theorem pdom_tsq {φ : ℝ → ℝ} (hφ : PDom φ) {C4 : ℝ} (h4 : ∀ t : ℝ, 1 ≤ t → t ^ 4 * |φ t| ≤ C4) :
    PDom (fun t : ℝ => t ^ 2 * φ t) := by
  obtain ⟨hc, C, hC, hn, hf⟩ := hφ
  refine ⟨((continuous_pow 2 : Continuous fun s : ℝ => s ^ 2).continuousOn).mul hc, max C C4,
    le_max_of_le_left hC, fun t ht ht1 => ?_,
    fun t ht => ?_⟩
  · have h := hn t ht ht1
    have ht2 : t ^ 2 ≤ 1 := pow_le_one₀ ht.le ht1
    have hp : 0 ≤ Real.sqrt t * |φ t| := mul_nonneg (Real.sqrt_nonneg t) (abs_nonneg _)
    rw [abs_mul, abs_of_nonneg (sq_nonneg t)]
    have e : Real.sqrt t * (t ^ 2 * |φ t|) = t ^ 2 * (Real.sqrt t * |φ t|) := by ring
    rw [e]
    have h1 : t ^ 2 * (Real.sqrt t * |φ t|) ≤ 1 * C := mul_le_mul ht2 h hp zero_le_one
    have h2 : C ≤ max C C4 := le_max_left _ _
    linarith
  · rw [abs_mul, abs_of_nonneg (sq_nonneg t)]
    have e : t ^ 2 * (t ^ 2 * |φ t|) = t ^ 4 * |φ t| := by ring
    rw [e]
    exact (h4 t ht).trans (le_max_right _ _)

/-! ## R1 for `θᵏ g` -/

theorem hasDerivAt_AJ_thG0 {x : ℝ} (hx : 0 < x) :
    HasDerivAt (AJ thG0) (-(AJ thG1 x) / x) x :=
  hasDerivAt_AJ pdom_thG0 pdom_thG1 (fun t ht => hasDerivAt_thG0 ht) hx

theorem hasDerivAt_AJ_thG1 {x : ℝ} (hx : 0 < x) :
    HasDerivAt (AJ thG1) (-(AJ thG2 x) / x) x :=
  hasDerivAt_AJ pdom_thG1 pdom_thG2 (fun t ht => hasDerivAt_thG1 ht) hx

theorem hasDerivAt_AJ_thG2 {x : ℝ} (hx : 0 < x) :
    HasDerivAt (AJ thG2) (-(AJ thG3 x) / x) x :=
  hasDerivAt_AJ pdom_thG2 pdom_thG3 (fun t ht => hasDerivAt_thG2 ht) hx

theorem hasDerivAt_AJ_thG3 {x : ℝ} (hx : 0 < x) :
    HasDerivAt (AJ thG3) (-(AJ thG4 x) / x) x :=
  hasDerivAt_AJ pdom_thG3 pdom_thG4 (fun t ht => hasDerivAt_thG3 ht) hx

theorem hasDerivAt_AJ_thG4 {x : ℝ} (hx : 0 < x) :
    HasDerivAt (AJ thG4) (-(AJ thG5 x) / x) x :=
  hasDerivAt_AJ pdom_thG4 pdom_thG5 (fun t ht => hasDerivAt_thG4 ht) hx

/-! ## R2 for the three auxiliary chains -/

theorem AJ_R2_gQ1 {x : ℝ} (hx : 0 < x) :
    AJ gQ1b x + 2 * AJ gQ1a x = -x ^ 2 * AJ (fun t : ℝ => t ^ 2 * gQ1 t) x :=
  AJ_theta2 pdom_gQ1 pdom_gQ1a pdom_gQ1b (fun t ht => hasDerivAt_gQ1 ht) (fun t ht => hasDerivAt_gQ1a ht)
    pdom4_gQ1 hx

theorem AJ_R2_gQ2 {x : ℝ} (hx : 0 < x) :
    AJ gQ2b x + 2 * AJ gQ2a x = -x ^ 2 * AJ (fun t : ℝ => t ^ 2 * gQ2 t) x :=
  AJ_theta2 pdom_gQ2 pdom_gQ2a pdom_gQ2b (fun t ht => hasDerivAt_gQ2 ht) (fun t ht => hasDerivAt_gQ2a ht)
    pdom4_gQ2 hx

theorem AJ_R2_gR {x : ℝ} (hx : 0 < x) :
    AJ gR2 x + 2 * AJ gR1 x = -x ^ 2 * AJ (fun t : ℝ => t ^ 2 * gR t) x :=
  AJ_theta2 pdom_gR pdom_gR1 pdom_gR2 (fun t ht => hasDerivAt_gR ht) (fun t ht => hasDerivAt_gR1 ht)
    pdom4_gR hx

theorem AJ_tsq_gR (x : ℝ) : AJ (fun t : ℝ => t ^ 2 * gR t) x = (-1 / 4 : ℝ) * AJ thG5 x := by
  have hf : (fun t : ℝ => t ^ 2 * gR t) = fun t : ℝ => (-1 / 4 : ℝ) * thG5 t := by
    funext t
    have h := gR_eq t
    linear_combination (1 / 4 : ℝ) * h
  rw [hf]
  exact AJ_const_mul (-1 / 4 : ℝ) thG5 x

/-! ## The relation -/

theorem AJ_rel {x : ℝ} (hx : 0 < x) :
    64 * (AJ thG5 x + 10 * AJ thG4 x + 36 * AJ thG3 x + 56 * AJ thG2 x + 32 * AJ thG1 x)
      + 4 * x ^ 2 * (5 * AJ thG5 x + 25 * AJ thG4 x + 48 * AJ thG3 x + 44 * AJ thG2 x + 16 * AJ thG1 x)
      + x ^ 4 * AJ thG5 x = 0 := by
  have q1a : AJ gQ1a x = 4 * AJ thG1 x + 4 * AJ thG2 x + 1 * AJ thG3 x :=
    AJ_lin3 pdom_thG1 pdom_thG2 pdom_thG3 4 4 1 hx
  have q1b : AJ gQ1b x = 4 * AJ thG2 x + 4 * AJ thG3 x + 1 * AJ thG4 x :=
    AJ_lin3 pdom_thG2 pdom_thG3 pdom_thG4 4 4 1 hx
  have q2a : AJ gQ2a x = 8 * AJ thG1 x + 12 * AJ thG2 x + 6 * AJ thG3 x + 1 * AJ thG4 x :=
    AJ_lin4 pdom_thG1 pdom_thG2 pdom_thG3 pdom_thG4 8 12 6 1 hx
  have q2b : AJ gQ2b x = 8 * AJ thG2 x + 12 * AJ thG3 x + 6 * AJ thG4 x + 1 * AJ thG5 x :=
    AJ_lin4 pdom_thG2 pdom_thG3 pdom_thG4 pdom_thG5 8 12 6 1 hx
  have r1 : AJ gR1 x = 16 * AJ (fun t : ℝ => t ^ 2 * gQ1 t) x + (-8) * AJ thG1 x + (-18) * AJ thG2 x
      + (-15) * AJ thG3 x + (-5) * AJ thG4 x := by
    have hf : gR1 = fun t : ℝ => 16 * (t ^ 2 * gQ1 t) + (-8) * thG1 t + (-18) * thG2 t
        + (-15) * thG3 t + (-5) * thG4 t := by
      funext t
      unfold gR1 gQ1
      ring
    rw [hf]
    exact AJ_lin5 (pdom_tsq pdom_gQ1 pdom4_gQ1) pdom_thG1 pdom_thG2 pdom_thG3 pdom_thG4
      16 (-8) (-18) (-15) (-5) hx
  have r2 : AJ gR2 x = 16 * AJ (fun t : ℝ => t ^ 2 * gQ2 t) x + (-8) * AJ thG2 x + (-18) * AJ thG3 x
      + (-15) * AJ thG4 x + (-5) * AJ thG5 x := by
    have hf : gR2 = fun t : ℝ => 16 * (t ^ 2 * gQ2 t) + (-8) * thG2 t + (-18) * thG3 t
        + (-15) * thG4 t + (-5) * thG5 t := by
      funext t
      unfold gR2 gQ2
      ring
    rw [hf]
    exact AJ_lin5 (pdom_tsq pdom_gQ2 pdom4_gQ2) pdom_thG2 pdom_thG3 pdom_thG4 pdom_thG5
      16 (-8) (-18) (-15) (-5) hx
  have e1 := AJ_R2_gQ1 hx
  have e2 := AJ_R2_gQ2 hx
  have e3 := AJ_R2_gR hx
  have hF := AJ_tsq_gR x
  linear_combination (-256) * q1a + (-128) * q1b + (-128) * q2a + (-64) * q2b + (8*x^2) * r1 + (4*x^2) * r2 + (128) * e1 + (64) * e2 + (-4*x^2) * e3 + (4*x^4) * hF

/-! ## `uG = c x²` -/

/-- `uG = x² A₄ + 4 (5A₄ + 15A₃ + 18A₂ + 8A₁) + 64 x⁻² (A₄ + 6A₃ + 12A₂ + 8A₁)`. -/
noncomputable def uG (x : ℝ) : ℝ :=
  x ^ 2 * AJ thG4 x + 4 * (5 * AJ thG4 x + 15 * AJ thG3 x + 18 * AJ thG2 x + 8 * AJ thG1 x)
    + 64 * (AJ thG4 x + 6 * AJ thG3 x + 12 * AJ thG2 x + 8 * AJ thG1 x) / x ^ 2

/-- The derivative of `uG`, as R1 gives it. -/
noncomputable def uGd (x : ℝ) : ℝ :=
  2 * x * AJ thG4 x + x ^ 2 * (-(AJ thG5 x) / x)
    + 4 * (5 * (-(AJ thG5 x) / x) + 15 * (-(AJ thG4 x) / x) + 18 * (-(AJ thG3 x) / x) + 8 * (-(AJ thG2 x) / x))
    + (64 * ((-(AJ thG5 x) / x) + 6 * (-(AJ thG4 x) / x) + 12 * (-(AJ thG3 x) / x) + 8 * (-(AJ thG2 x) / x)) * x ^ 2 - 64 * (AJ thG4 x + 6 * AJ thG3 x + 12 * AJ thG2 x + 8 * AJ thG1 x) * (2 * x)) / (x ^ 2) ^ 2

theorem hasDerivAt_uG {x : ℝ} (hx : 0 < x) : HasDerivAt uG (uGd x) x := by
  have h1 := hasDerivAt_AJ_thG1 hx
  have h2 := hasDerivAt_AJ_thG2 hx
  have h3 := hasDerivAt_AJ_thG3 hx
  have h4 := hasDerivAt_AJ_thG4 hx
  have hA : HasDerivAt (fun y : ℝ => y ^ 2 * AJ thG4 y) (2 * x * AJ thG4 x + x ^ 2 * (-(AJ thG5 x) / x)) x :=
    (hasDerivAt_sqx x).mul h4
  have hB : HasDerivAt (fun y : ℝ => 4 * (5 * AJ thG4 y + 15 * AJ thG3 y + 18 * AJ thG2 y + 8 * AJ thG1 y))
      (4 * (5 * (-(AJ thG5 x) / x) + 15 * (-(AJ thG4 x) / x) + 18 * (-(AJ thG3 x) / x) + 8 * (-(AJ thG2 x) / x))) x :=
    ((((h4.const_mul (5 : ℝ)).add (h3.const_mul (15 : ℝ))).add (h2.const_mul (18 : ℝ))).add
      (h1.const_mul (8 : ℝ))).const_mul (4 : ℝ)
  have hC : HasDerivAt
      (fun y : ℝ => 64 * (AJ thG4 y + 6 * AJ thG3 y + 12 * AJ thG2 y + 8 * AJ thG1 y) / y ^ 2)
      ((64 * ((-(AJ thG5 x) / x) + 6 * (-(AJ thG4 x) / x) + 12 * (-(AJ thG3 x) / x) + 8 * (-(AJ thG2 x) / x)) * x ^ 2 - 64 * (AJ thG4 x + 6 * AJ thG3 x + 12 * AJ thG2 x + 8 * AJ thG1 x) * (2 * x)) / (x ^ 2) ^ 2) x :=
    ((((h4.add (h3.const_mul (6 : ℝ))).add (h2.const_mul (12 : ℝ))).add (h1.const_mul (8 : ℝ))).const_mul
      (64 : ℝ)).div (hasDerivAt_sqx x) (pow_ne_zero 2 hx.ne')
  have hU := (hA.add hB).add hC
  have hfun : uG = fun y : ℝ => y ^ 2 * AJ thG4 y
      + 4 * (5 * AJ thG4 y + 15 * AJ thG3 y + 18 * AJ thG2 y + 8 * AJ thG1 y)
      + 64 * (AJ thG4 y + 6 * AJ thG3 y + 12 * AJ thG2 y + 8 * AJ thG1 y) / y ^ 2 := rfl
  rw [hfun]
  refine hU.congr_deriv ?_
  unfold uGd
  ring

theorem uG_ode {x : ℝ} (hx : 0 < x) : x * uGd x - 2 * uG x = 0 := by
  have hrel := AJ_rel hx
  have hxi : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  unfold uGd uG
  linear_combination (-x⁻¹ ^ 2) * hrel + (-1024*AJ thG1 x*x*x⁻¹^3 + 64*AJ thG1 x*x*x⁻¹ - 1024*AJ thG1 x*x⁻¹^2 + 64*AJ thG1 x - 512*AJ thG2 x*x^2*x⁻¹^4 - 2048*AJ thG2 x*x*x⁻¹^3 + 176*AJ thG2 x*x*x⁻¹ - 2048*AJ thG2 x*x⁻¹^2 + 144*AJ thG2 x - 768*AJ thG3 x*x^2*x⁻¹^4 - 1536*AJ thG3 x*x*x⁻¹^3 + 192*AJ thG3 x*x*x⁻¹ - 1536*AJ thG3 x*x⁻¹^2 + 120*AJ thG3 x - 384*AJ thG4 x*x^2*x⁻¹^4 - 512*AJ thG4 x*x*x⁻¹^3 + 100*AJ thG4 x*x*x⁻¹ - 512*AJ thG4 x*x⁻¹^2 + 40*AJ thG4 x + AJ thG5 x*x^3*x⁻¹ - 64*AJ thG5 x*x^2*x⁻¹^4 - 64*AJ thG5 x*x*x⁻¹^3 + 20*AJ thG5 x*x*x⁻¹ - 64*AJ thG5 x*x⁻¹^2) * hxi

/-- **The dual equation**: `uG = c x²` on `(0, ∞)`. -/
theorem uG_eq : ∃ c : ℝ, ∀ x : ℝ, 0 < x → uG x = c * x ^ 2 :=
  ode_theta_two (fun x hx => hasDerivAt_uG hx) (fun x hx => uG_ode hx)

end Tower.RV6
