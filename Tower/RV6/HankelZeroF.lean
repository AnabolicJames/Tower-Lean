/-!
# `L₃′ hjF = 0` on `(0, ∞)`

The constants of `uF_eq` vanish.  With `a_k = hk(θᵏ f)(0) = ∫ t θᵏ f` and `b_k = hk(t² θᵏ f)(0) = ∫ t³ θᵏ f`:

* `a_{k+1} = -2 a_k`, `b_{k+1} = -4 b_k` (`hk_shift_zero`, `hk_shift3_zero`);
* the `s = 0` relation of `L₅` (`hk_s0_F`): `θ⁵ f / t = (θ⁴ f)'` and `θ⁴ f = t² ψ₄` with `ψ₄ ∈ HDom`
  (`thF4_eq_sq`, `hdom_psiF4`), so `θ⁴ f → 0` at `0+` and at `∞` and `∫₀^∞ θ⁵ f / t = 0`; by `L5_thF` this is
  `20 a₃ + 60 a₂ + 72 a₁ + 32 a₀ - 64 b₁ - 128 b₀ = 0`, i.e. `a₀ = 4 b₀` (numerically `π²/16 = 4 · π²/64`);
* the `x⁰` and `x²` coefficients of `uF` vanish (`hk_mom0F`, `hk_mom2F`), so by `hk_taylor`
  `|uF x| ≤ K x³` on `(0, 1]` (`uF_small`);
* **`uF_zero`**: `uF x = 0` for `x > 0` (`uF_eq` and `log_consts_eq_zero`).

Generated by `tools/gen_hankelzerof.py`, which checks every certificate in exact arithmetic.
-/

namespace Tower.RV6

open MeasureTheory

/-- `θ⁴ f = t² ψ₄` (`I₁(t) = (t/2) B(t²/4)`). -/
noncomputable def psiF4 (t : ℝ) : ℝ :=
  (-24) * (Bser (t / 2 * (t / 2)) / 2 * (t * besselK1 t) * (t * besselK1 t) * (t * besselK1 t)) +
    32 * ldF2 t + 28 * ldF1 t + 16 * ldF0 t + 40 * (t ^ 2 * ldF0 t)

theorem hdom_psiF4 : HDom psiF4 := by
  have h : HDom (fun t : ℝ => (-24) * (Bser (t / 2 * (t / 2)) / 2 * (t * besselK1 t) *
      (t * besselK1 t) * (t * besselK1 t)) + 32 * ldF2 t + 28 * ldF1 t + 16 * ldF0 t +
      40 * (t ^ 2 * ldF0 t)) :=
    hdom_add (hdom_add (hdom_add (hdom_add (hdom_const_mul (-24)
      (hdom_prod4 ity_bserI1 kty_mul_besselK1 kty_mul_besselK1 kty_mul_besselK1))
      (hdom_const_mul 32 hdom_ldF2)) (hdom_const_mul 28 hdom_ldF1)) (hdom_const_mul 16 hdom_ldF0))
      (hdom_const_mul 40 (hdom_pow_mul 2 hdom_ldF0))
  exact h

theorem thF4_eq_sq (t : ℝ) : thF4 t = t ^ 2 * psiF4 t := by
  unfold thF4 psiF4 ldF4
  rw [besselI1_eq]
  ring

theorem thF4_zero : thF4 0 = 0 := by
  rw [thF4_eq_sq]
  ring

theorem tendsto_thF4_zero : Filter.Tendsto thF4 (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
  have h : Filter.Tendsto (fun t : ℝ => t ^ 2 * psiF4 t * (fun _ : ℝ => (1 : ℝ)) t)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) :=
    tendsto_hdom_zero (g := fun _ : ℝ => (1 : ℝ)) hdom_psiF4 (G := 1) (fun _ _ => by simp)
  refine Filter.Tendsto.congr (fun t => ?_) h
  show t ^ 2 * psiF4 t * 1 = thF4 t
  rw [mul_one, thF4_eq_sq]

theorem tendsto_thF4_atTop : Filter.Tendsto thF4 Filter.atTop (nhds 0) := by
  have h : Filter.Tendsto (fun t : ℝ => t ^ 2 * psiF4 t * (fun _ : ℝ => (1 : ℝ)) t)
      Filter.atTop (nhds 0) :=
    tendsto_hdom_atTop (g := fun _ : ℝ => (1 : ℝ)) hdom_psiF4 (G := 1) (fun _ _ => by simp)
  refine Filter.Tendsto.congr (fun t => ?_) h
  show t ^ 2 * psiF4 t * 1 = thF4 t
  rw [mul_one, thF4_eq_sq]


/-- The `s = 0` relation of `L₅`: `∫₀^∞ θ⁵ f / t = 0`, written through `a_k`, `b_k`. -/
theorem hk_s0_F :
    20 * hk thF3 0 + 60 * hk thF2 0 + 72 * hk thF1 0 + 32 * hk thF0 0 + (-64) * hk (fun t => t ^ 2 * thF1 t) 0 + (-128) * hk (fun t => t ^ 2 * thF0 t) 0 = 0 := by
  have hP : HDom (fun t : ℝ => 20 * thF3 t + 60 * thF2 t + 72 * thF1 t + 32 * thF0 t + (-64) * (t ^ 2 * thF1 t) + (-128) * (t ^ 2 * thF0 t)) :=
    (hdom_add (hdom_add (hdom_add (hdom_add (hdom_add (hdom_const_mul 20 hdom_thF3) (hdom_const_mul 60 hdom_thF2)) (hdom_const_mul 72 hdom_thF1)) (hdom_const_mul 32 hdom_thF0)) (hdom_const_mul (-64) (hdom_pow_mul 2 hdom_thF1))) (hdom_const_mul (-128) (hdom_pow_mul 2 hdom_thF0)))
  have pt : ∀ t : ℝ, 0 < t →
      besselJ0 (0 * t) * (20 * thF3 t + 60 * thF2 t + 72 * thF1 t + 32 * thF0 t + (-64) * (t ^ 2 * thF1 t) + (-128) * (t ^ 2 * thF0 t)) * t = thF5 t / t := by
    intro t ht
    rw [zero_mul, besselJ0_zero, eq_div_iff ht.ne']
    linear_combination (-1 : ℝ) * L5_thF t
  have i0 : IntegrableOn (fun t : ℝ => besselJ0 (0 * t) * (20 * thF3 t + 60 * thF2 t + 72 * thF1 t + 32 * thF0 t + (-64) * (t ^ 2 * thF1 t) + (-128) * (t ^ 2 * thF0 t)) * t)
      (Set.Ioi 0) := integrableOn_hk hP (le_refl 0)
  have hint : IntegrableOn (fun t : ℝ => thF5 t / t) (Set.Ioi 0) :=
    i0.congr_fun (fun t ht => pt t ht) measurableSet_Ioi
  have hz : ∫ t in Set.Ioi (0 : ℝ), thF5 t / t = 0 :=
    integral_Ioi_deriv_eq_zero thF4_zero (fun t ht => hasDerivAt_thF4 ht) tendsto_thF4_zero
      tendsto_thF4_atTop hint
  have e : hk (fun t => 20 * thF3 t + 60 * thF2 t + 72 * thF1 t + 32 * thF0 t + (-64) * (t ^ 2 * thF1 t) + (-128) * (t ^ 2 * thF0 t)) 0
      = ∫ t in Set.Ioi (0 : ℝ), thF5 t / t := by
    unfold hk
    exact setIntegral_congr_fun measurableSet_Ioi (fun t ht => pt t ht)
  have h0 : hk (fun t => 20 * thF3 t + 60 * thF2 t + 72 * thF1 t + 32 * thF0 t + (-64) * (t ^ 2 * thF1 t) + (-128) * (t ^ 2 * thF0 t)) 0 = 0 := by
    rw [e, hz]
  rw [hk_add_cmul (hdom_add (hdom_add (hdom_add (hdom_add (hdom_const_mul 20 hdom_thF3) (hdom_const_mul 60 hdom_thF2)) (hdom_const_mul 72 hdom_thF1)) (hdom_const_mul 32 hdom_thF0)) (hdom_const_mul (-64) (hdom_pow_mul 2 hdom_thF1))) (hdom_pow_mul 2 hdom_thF0) (-128) (le_refl 0),
    hk_add_cmul (hdom_add (hdom_add (hdom_add (hdom_const_mul 20 hdom_thF3) (hdom_const_mul 60 hdom_thF2)) (hdom_const_mul 72 hdom_thF1)) (hdom_const_mul 32 hdom_thF0)) (hdom_pow_mul 2 hdom_thF1) (-64) (le_refl 0),
    hk_add_cmul (hdom_add (hdom_add (hdom_const_mul 20 hdom_thF3) (hdom_const_mul 60 hdom_thF2)) (hdom_const_mul 72 hdom_thF1)) hdom_thF0 32 (le_refl 0),
    hk_add_cmul (hdom_add (hdom_const_mul 20 hdom_thF3) (hdom_const_mul 60 hdom_thF2)) hdom_thF1 72 (le_refl 0),
    hk_add_cmul (hdom_const_mul 20 hdom_thF3) hdom_thF2 60 (le_refl 0),
    hk_const_mul 20 thF3 0] at h0
  exact h0

/-- The `x⁰` coefficient of `uF`: `-64 a₃ - 384 a₂ - 768 a₁ - 512 a₀ = 0`. -/
theorem hk_mom0F : (-64) * hk thF3 0 + (-384) * hk thF2 0 + (-768) * hk thF1 0 + (-512) * hk thF0 0 = 0 := by
  have s0 := hk_shift_zero hchain_thF0
  have s1 := hk_shift_zero hchain_thF1
  have s2 := hk_shift_zero hchain_thF2
  linear_combination (-64) * s2 + (-256) * s1 + (-256) * s0

/-- The `x²` coefficient of `uF`. -/
theorem hk_mom2F :
    (-20) * hk thF3 0 + (-60) * hk thF2 0 + (-72) * hk thF1 0 + (-32) * hk thF0 0 + 16 * hk (fun t => t ^ 2 * thF3 t) 0 + 96 * hk (fun t => t ^ 2 * thF2 t) 0 + 192 * hk (fun t => t ^ 2 * thF1 t) 0 + 128 * hk (fun t => t ^ 2 * thF0 t) 0 = 0 := by
  have z := hk_s0_F
  have u1 := hk_shift3_zero hchain_thF1
  have u2 := hk_shift3_zero hchain_thF2
  linear_combination (-1) * z + 16 * u2 + 32 * u1

/-- `|uF x| ≤ K x³` on `(0, 1]`. -/
theorem uF_small : ∃ K : ℝ, ∀ x : ℝ, 0 < x → x ≤ 1 → |uF x| ≤ K * x ^ 3 := by
  refine ⟨|((-1) * hk thF3 0 + 5 * hk (fun t => t ^ 2 * thF3 t) 0 + 15 * hk (fun t => t ^ 2 * thF2 t) 0 + 18 * hk (fun t => t ^ 2 * thF1 t) 0 + 8 * hk (fun t => t ^ 2 * thF0 t) 0)| + |((1 / 4) * hk (fun t => t ^ 2 * thF3 t) 0)| + (-((-1) + (-20) + (-64))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF3 t|) + (-(0 + (-60) + (-384))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF2 t|) + (-(0 + (-72) + (-768))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF1 t|) + (-(0 + (-32) + (-512))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF0 t|), fun x hx hx1 => ?_⟩
  have m0 := hk_mom0F
  have m2 := hk_mom2F
  have t3 := hk_taylor hdom_thF3 hx.le
  have p3 : |((-1) * x ^ 4 + (-20) * x ^ 2 + (-64))| ≤ (-((-1) + (-20) + (-64))) :=
    abs_quart_le hx.le hx1 (by norm_num) (by norm_num) (by norm_num)
  have b3 := abs_mul_le_mul_of p3 t3
  have t2 := hk_taylor hdom_thF2 hx.le
  have p2 : |(0 * x ^ 4 + (-60) * x ^ 2 + (-384))| ≤ (-(0 + (-60) + (-384))) :=
    abs_quart_le hx.le hx1 (by norm_num) (by norm_num) (by norm_num)
  have b2 := abs_mul_le_mul_of p2 t2
  have t1 := hk_taylor hdom_thF1 hx.le
  have p1 : |(0 * x ^ 4 + (-72) * x ^ 2 + (-768))| ≤ (-(0 + (-72) + (-768))) :=
    abs_quart_le hx.le hx1 (by norm_num) (by norm_num) (by norm_num)
  have b1 := abs_mul_le_mul_of p1 t1
  have t0 := hk_taylor hdom_thF0 hx.le
  have p0 : |(0 * x ^ 4 + (-32) * x ^ 2 + (-512))| ≤ (-(0 + (-32) + (-512))) :=
    abs_quart_le hx.le hx1 (by norm_num) (by norm_num) (by norm_num)
  have b0 := abs_mul_le_mul_of p0 t0
  have hq := abs_x4_le (q4 := ((-1) * hk thF3 0 + 5 * hk (fun t => t ^ 2 * thF3 t) 0 + 15 * hk (fun t => t ^ 2 * thF2 t) 0 + 18 * hk (fun t => t ^ 2 * thF1 t) 0 + 8 * hk (fun t => t ^ 2 * thF0 t) 0)) (q6 := ((1 / 4) * hk (fun t => t ^ 2 * thF3 t) 0)) hx.le hx1
  have e : uF x = x ^ 4 * (((-1) * hk thF3 0 + 5 * hk (fun t => t ^ 2 * thF3 t) 0 + 15 * hk (fun t => t ^ 2 * thF2 t) 0 + 18 * hk (fun t => t ^ 2 * thF1 t) 0 + 8 * hk (fun t => t ^ 2 * thF0 t) 0) + ((1 / 4) * hk (fun t => t ^ 2 * thF3 t) 0) * x ^ 2)
      + ((-1) * x ^ 4 + (-20) * x ^ 2 + (-64)) * (hk thF3 x - hk thF3 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF3 t) 0)
      + (0 * x ^ 4 + (-60) * x ^ 2 + (-384)) * (hk thF2 x - hk thF2 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF2 t) 0)
      + (0 * x ^ 4 + (-72) * x ^ 2 + (-768)) * (hk thF1 x - hk thF1 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF1 t) 0)
      + (0 * x ^ 4 + (-32) * x ^ 2 + (-512)) * (hk thF0 x - hk thF0 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF0 t) 0)
      := by
    unfold uF
    linear_combination m0 + x ^ 2 * m2
  rw [e]
  have h5 := abs_add5_le (x ^ 4 * (((-1) * hk thF3 0 + 5 * hk (fun t => t ^ 2 * thF3 t) 0 + 15 * hk (fun t => t ^ 2 * thF2 t) 0 + 18 * hk (fun t => t ^ 2 * thF1 t) 0 + 8 * hk (fun t => t ^ 2 * thF0 t) 0) + ((1 / 4) * hk (fun t => t ^ 2 * thF3 t) 0) * x ^ 2))
    (((-1) * x ^ 4 + (-20) * x ^ 2 + (-64)) * (hk thF3 x - hk thF3 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF3 t) 0))
    ((0 * x ^ 4 + (-60) * x ^ 2 + (-384)) * (hk thF2 x - hk thF2 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF2 t) 0))
    ((0 * x ^ 4 + (-72) * x ^ 2 + (-768)) * (hk thF1 x - hk thF1 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF1 t) 0))
    ((0 * x ^ 4 + (-32) * x ^ 2 + (-512)) * (hk thF0 x - hk thF0 0 + x ^ 2 / 4 * hk (fun t => t ^ 2 * thF0 t) 0))
  have hK : (|((-1) * hk thF3 0 + 5 * hk (fun t => t ^ 2 * thF3 t) 0 + 15 * hk (fun t => t ^ 2 * thF2 t) 0 + 18 * hk (fun t => t ^ 2 * thF1 t) 0 + 8 * hk (fun t => t ^ 2 * thF0 t) 0)| + |((1 / 4) * hk (fun t => t ^ 2 * thF3 t) 0)| + (-((-1) + (-20) + (-64))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF3 t|) + (-(0 + (-60) + (-384))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF2 t|) + (-(0 + (-72) + (-768))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF1 t|) + (-(0 + (-32) + (-512))) * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF0 t|)) * x ^ 3 = x ^ 3 * (|((-1) * hk thF3 0 + 5 * hk (fun t => t ^ 2 * thF3 t) 0 + 15 * hk (fun t => t ^ 2 * thF2 t) 0 + 18 * hk (fun t => t ^ 2 * thF1 t) 0 + 8 * hk (fun t => t ^ 2 * thF0 t) 0)| + |((1 / 4) * hk (fun t => t ^ 2 * thF3 t) 0)|) + (-((-1) + (-20) + (-64))) * (x ^ 3 * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF3 t|)) + (-(0 + (-60) + (-384))) * (x ^ 3 * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF2 t|)) + (-(0 + (-72) + (-768))) * (x ^ 3 * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF1 t|)) + (-(0 + (-32) + (-512))) * (x ^ 3 * (∫ t in Set.Ioi (0 : ℝ), |t ^ 4 * thF0 t|)) := by ring
  linarith [h5, hq, b3, b2, b1, b0, hK]

/-- **`L₃′ hjF = 0`**: `uF x = 0` for every `x > 0`. -/
theorem uF_zero {x : ℝ} (hx : 0 < x) : uF x = 0 := by
  obtain ⟨c1, c2, hc⟩ := uF_eq
  obtain ⟨K, hK⟩ := uF_small
  have hb : ∀ y : ℝ, 0 < y → y ≤ 1 → |c1 + c2 * Real.log y| ≤ K * y := by
    intro y hy hy1
    have h1 := hK y hy hy1
    rw [hc y hy, abs_mul, abs_of_nonneg (pow_nonneg hy.le 2)] at h1
    have e : K * y ^ 3 = y ^ 2 * (K * y) := by ring
    rw [e] at h1
    exact le_of_mul_le_mul_left h1 (pow_pos hy 2)
  obtain ⟨h1, h2⟩ := log_consts_eq_zero hb
  rw [hc x hx, h1, h2]
  ring

