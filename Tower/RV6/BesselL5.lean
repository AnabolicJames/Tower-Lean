import Mathlib
import Tower.RV6.BesselI
import Tower.RV6.BesselK
import Tower.RV6.BesselW
import Tower.RV6.LadderB

/-!
# The fifth-order equation of `f = I₀ K₀³` and `g = I₀² K₀²`

With `θ = t d/dt`, `u = I₀`, `p = t I₁`, `v = K₀`, `q = t K₁`, the four derivative lemmas give, for `t > 0`,
`θu = p`, `θp = t²u`, `θv = -q`, `θq = -t²v`.  For a product of four factors put
`e_k = ∑_{|S| = k} ∏_{S} θ(factor) ∏_{not S} factor` (the ladder).  Then

`θ e_k = (k + 1) e_{k+1} + (5 - k) t² e_{k-1}`,  `e_{-1} = e_5 = 0`

(`hasDerivAt_ldFk`, `hasDerivAt_ldGk`, stated as `HasDerivAt e_k (R_k / t)`), with no use of the Wronskian.  The θ-powers of
`e₀` are explicit combinations of the ladder (`thFk`, `thGk`, with `HasDerivAt th_k (th_{k+1} t / t)`), and

`L₅ = θ⁵ - 4t²(5θ³ + 15θ² + 18θ + 8) + 64t⁴(θ + 2)`

annihilates them identically (`L5_thF`, `L5_thG`; it is `5! e₅ = 0`).  With `thF0 = fB`, `thG0 = gB`: `L₅ f = L₅ g = 0`
(`l5_fB`, `l5_gB`).  This is item 1 of the plan for `ZhouF` and `ZhouG`; the Hankel duals come next.

Generated by `tools/gen_besselL5.py`, which checks every identity and every `linear_combination` cofactor in exact rational
arithmetic first (`t⁻¹` an independent variable).
-/

namespace Tower.RV6

/-- The product rule for four factors. -/
theorem hasDerivAt_prod4 {a b c d : ℝ → ℝ} {a1 b1 c1 d1 t : ℝ} (ha : HasDerivAt a a1 t)
    (hb : HasDerivAt b b1 t) (hc : HasDerivAt c c1 t) (hd : HasDerivAt d d1 t) :
    HasDerivAt (fun x => a x * b x * c x * d x)
      (a1 * b t * c t * d t + a t * b1 * c t * d t + a t * b t * c1 * d t
        + a t * b t * c t * d1) t := by
  have h0 := ((ha.mul hb).mul hc).mul hd
  have h1 : HasDerivAt (fun x => a x * b x * c x * d x)
      (((a1 * b t + a t * b1) * c t + a t * b t * c1) * d t + a t * b t * c t * d1) t := h0
  exact h1.congr_deriv (by ring)

theorem hasDerivAt_sqx (t : ℝ) : HasDerivAt (fun x : ℝ => x ^ 2) (2 * t) t :=
  (hasDerivAt_pow 2 t).congr_deriv (by norm_num)

theorem hasDerivAt_powfour (t : ℝ) : HasDerivAt (fun x : ℝ => x ^ 4) (4 * t ^ 3) t :=
  (hasDerivAt_pow 4 t).congr_deriv (by norm_num)

/-! ## `f = I₀ K₀³` -/


/-- `e0` of the ladder of `f = I₀ K₀³`. -/
noncomputable def ldF0 (t : ℝ) : ℝ :=
  besselI0 t * besselK0 t ^ 3

/-- `e1` of the ladder of `f = I₀ K₀³`. -/
noncomputable def ldF1 (t : ℝ) : ℝ :=
  (t * besselI1 t) * besselK0 t ^ 3 + (-3) * (besselI0 t * besselK0 t ^ 2 * (t * besselK1 t))

/-- `e2` of the ladder of `f = I₀ K₀³`. -/
noncomputable def ldF2 (t : ℝ) : ℝ :=
  (-3) * ((t * besselI1 t) * besselK0 t ^ 2 * (t * besselK1 t)) +
    3 * (besselI0 t * besselK0 t * (t * besselK1 t) ^ 2)

/-- `e3` of the ladder of `f = I₀ K₀³`. -/
noncomputable def ldF3 (t : ℝ) : ℝ :=
  3 * ((t * besselI1 t) * besselK0 t * (t * besselK1 t) ^ 2) +
    (-1) * (besselI0 t * (t * besselK1 t) ^ 3)

/-- `e4` of the ladder of `f = I₀ K₀³`. -/
noncomputable def ldF4 (t : ℝ) : ℝ :=
  (-1) * ((t * besselI1 t) * (t * besselK1 t) ^ 3)

/-- `θ e0 = e1`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldF0 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldF0 (ldF1 t / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hv := hasDerivAt_besselK0 ht
  have m1 := (hasDerivAt_prod4 hu hv hv hv).const_mul (1 : ℝ)
  have h0 := m1
  have hfun : ldF0 = fun x : ℝ =>
      1 * (besselI0 x * besselK0 x * besselK0 x * besselK0 x) := by
    funext x
    unfold ldF0
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldF1
  ring

/-- `θ e1 = 2 e2 + 4 t² e0`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldF1 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldF1 ((2 * ldF2 t + 4 * t ^ 2 * ldF0 t) / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hp := hasDerivAt_mul_besselI1 t
  have hv := hasDerivAt_besselK0 ht
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hp hv hv hv).const_mul (1 : ℝ)
  have m2 := (hasDerivAt_prod4 hu hv hv hq).const_mul (-3 : ℝ)
  have h0 := m1.add m2
  have hfun : ldF1 = fun x : ℝ =>
      1 * ((x * besselI1 x) * besselK0 x * besselK0 x * besselK0 x) +
        (-3) * (besselI0 x * besselK0 x * besselK0 x * (x * besselK1 x)) := by
    funext x
    unfold ldF1
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldF2 ldF0
  ring

/-- `θ e2 = 3 e3 + 3 t² e1`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldF2 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldF2 ((3 * ldF3 t + 3 * t ^ 2 * ldF1 t) / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hp := hasDerivAt_mul_besselI1 t
  have hv := hasDerivAt_besselK0 ht
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hp hv hv hq).const_mul (-3 : ℝ)
  have m2 := (hasDerivAt_prod4 hu hv hq hq).const_mul (3 : ℝ)
  have h0 := m1.add m2
  have hfun : ldF2 = fun x : ℝ =>
      (-3) * ((x * besselI1 x) * besselK0 x * besselK0 x * (x * besselK1 x)) +
        3 * (besselI0 x * besselK0 x * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldF2
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldF3 ldF1
  ring

/-- `θ e3 = 4 e4 + 2 t² e2`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldF3 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldF3 ((4 * ldF4 t + 2 * t ^ 2 * ldF2 t) / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hp := hasDerivAt_mul_besselI1 t
  have hv := hasDerivAt_besselK0 ht
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hp hv hq hq).const_mul (3 : ℝ)
  have m2 := (hasDerivAt_prod4 hu hq hq hq).const_mul (-1 : ℝ)
  have h0 := m1.add m2
  have hfun : ldF3 = fun x : ℝ =>
      3 * ((x * besselI1 x) * besselK0 x * (x * besselK1 x) * (x * besselK1 x)) +
        (-1) * (besselI0 x * (x * besselK1 x) * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldF3
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldF4 ldF2
  ring

/-- `θ e4 = t² e3`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldF4 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldF4 (t ^ 2 * ldF3 t / t) t := by
  have hp := hasDerivAt_mul_besselI1 t
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hp hq hq hq).const_mul (-1 : ℝ)
  have h0 := m1
  have hfun : ldF4 = fun x : ℝ =>
      (-1) * ((x * besselI1 x) * (x * besselK1 x) * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldF4
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldF3
  ring

/-- `θ^0 f`. -/
noncomputable def thF0 (t : ℝ) : ℝ :=
  ldF0 t

/-- `θ^1 f`. -/
noncomputable def thF1 (t : ℝ) : ℝ :=
  ldF1 t

/-- `θ^2 f`. -/
noncomputable def thF2 (t : ℝ) : ℝ :=
  2 * ldF2 t + 4 * (t ^ 2 * ldF0 t)

/-- `θ^3 f`. -/
noncomputable def thF3 (t : ℝ) : ℝ :=
  6 * ldF3 t + 10 * (t ^ 2 * ldF1 t) + 8 * (t ^ 2 * ldF0 t)

/-- `θ^4 f`. -/
noncomputable def thF4 (t : ℝ) : ℝ :=
  24 * ldF4 t + 32 * (t ^ 2 * ldF2 t) + 28 * (t ^ 2 * ldF1 t) + 16 * (t ^ 2 * ldF0 t) +
    40 * (t ^ 4 * ldF0 t)

/-- `θ^5 f`. -/
noncomputable def thF5 (t : ℝ) : ℝ :=
  120 * (t ^ 2 * ldF3 t) + 120 * (t ^ 2 * ldF2 t) + 72 * (t ^ 2 * ldF1 t) + 32 * (t ^ 2 * ldF0 t) +
    136 * (t ^ 4 * ldF1 t) + 272 * (t ^ 4 * ldF0 t)

theorem hasDerivAt_thF0 {t : ℝ} (ht : 0 < t) : HasDerivAt thF0 (thF1 t / t) t := by
  have e0 := hasDerivAt_ldF0 ht
  have h0 := e0
  have hfun : thF0 = ldF0 := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thF1
  linear_combination (1 * ldF1 t) * hinv

theorem hasDerivAt_thF1 {t : ℝ} (ht : 0 < t) : HasDerivAt thF1 (thF2 t / t) t := by
  have e1 := hasDerivAt_ldF1 ht
  have h0 := e1
  have hfun : thF1 = ldF1 := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thF2
  linear_combination (2 * ldF2 t + 4 * t ^ 2 * ldF0 t) * hinv

theorem hasDerivAt_thF2 {t : ℝ} (ht : 0 < t) : HasDerivAt thF2 (thF3 t / t) t := by
  have e0 := hasDerivAt_ldF0 ht
  have e2 := hasDerivAt_ldF2 ht
  have s2 := hasDerivAt_sqx t
  have m1 := e2.const_mul (2 : ℝ)
  have m2 := (s2.mul e0).const_mul (4 : ℝ)
  have h0 := m1.add m2
  have hfun : thF2 = fun x : ℝ =>
      2 * ldF2 x + 4 * (x ^ 2 * ldF0 x) := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thF3
  linear_combination (6 * ldF3 t + 10 * t ^ 2 * ldF1 t) * hinv

theorem hasDerivAt_thF3 {t : ℝ} (ht : 0 < t) : HasDerivAt thF3 (thF4 t / t) t := by
  have e0 := hasDerivAt_ldF0 ht
  have e1 := hasDerivAt_ldF1 ht
  have e3 := hasDerivAt_ldF3 ht
  have s2 := hasDerivAt_sqx t
  have m1 := e3.const_mul (6 : ℝ)
  have m2 := (s2.mul e1).const_mul (10 : ℝ)
  have m3 := (s2.mul e0).const_mul (8 : ℝ)
  have h0 := (m1.add m2).add m3
  have hfun : thF3 = fun x : ℝ =>
      6 * ldF3 x + 10 * (x ^ 2 * ldF1 x) + 8 * (x ^ 2 * ldF0 x) := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thF4
  linear_combination (24 * ldF4 t + 32 * t ^ 2 * ldF2 t + 8 * t ^ 2 * ldF1 t +
    40 * t ^ 4 * ldF0 t) * hinv

theorem hasDerivAt_thF4 {t : ℝ} (ht : 0 < t) : HasDerivAt thF4 (thF5 t / t) t := by
  have e0 := hasDerivAt_ldF0 ht
  have e1 := hasDerivAt_ldF1 ht
  have e2 := hasDerivAt_ldF2 ht
  have e4 := hasDerivAt_ldF4 ht
  have s2 := hasDerivAt_sqx t
  have s4 := hasDerivAt_powfour t
  have m1 := e4.const_mul (24 : ℝ)
  have m2 := (s2.mul e2).const_mul (32 : ℝ)
  have m3 := (s2.mul e1).const_mul (28 : ℝ)
  have m4 := (s2.mul e0).const_mul (16 : ℝ)
  have m5 := (s4.mul e0).const_mul (40 : ℝ)
  have h0 := (((m1.add m2).add m3).add m4).add m5
  have hfun : thF4 = fun x : ℝ =>
      24 * ldF4 x + 32 * (x ^ 2 * ldF2 x) + 28 * (x ^ 2 * ldF1 x) + 16 * (x ^ 2 * ldF0 x) +
        40 * (x ^ 4 * ldF0 x) := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thF5
  linear_combination (120 * t ^ 2 * ldF3 t + 56 * t ^ 2 * ldF2 t + 16 * t ^ 2 * ldF1 t +
    136 * t ^ 4 * ldF1 t + 112 * t ^ 4 * ldF0 t) * hinv

/-- **`L₅` annihilates the θ-chain**: `θ⁵ - 4t²(5θ³ + 15θ² + 18θ + 8) + 64t⁴(θ + 2)`. -/
theorem L5_thF (t : ℝ) :
    thF5 t - 4 * t ^ 2 * (5 * thF3 t + 15 * thF2 t + 18 * thF1 t + 8 * thF0 t)
      + 64 * t ^ 4 * (thF1 t + 2 * thF0 t) = 0 := by
  unfold thF5 thF3 thF2 thF1 thF0
  ring

theorem thF0_eq_fB : thF0 = fB := by
  funext x
  rfl

/-- `L₅ fB = 0` on `t > 0`, as a chain of derivatives: `thFk = θ^k fB` and the equation. -/
theorem l5_fB : thF0 = fB ∧
    (∀ t : ℝ, 0 < t → HasDerivAt thF0 (thF1 t / t) t ∧ HasDerivAt thF1 (thF2 t / t) t ∧
      HasDerivAt thF2 (thF3 t / t) t ∧ HasDerivAt thF3 (thF4 t / t) t ∧
      HasDerivAt thF4 (thF5 t / t) t) ∧
    ∀ t : ℝ, thF5 t - 4 * t ^ 2 * (5 * thF3 t + 15 * thF2 t + 18 * thF1 t + 8 * thF0 t)
      + 64 * t ^ 4 * (thF1 t + 2 * thF0 t) = 0 :=
  ⟨thF0_eq_fB, fun _ ht => ⟨hasDerivAt_thF0 ht, hasDerivAt_thF1 ht, hasDerivAt_thF2 ht,
    hasDerivAt_thF3 ht, hasDerivAt_thF4 ht⟩, L5_thF⟩

/-! ## `g = I₀² K₀²` -/

/-- `e0` of the ladder of `g = I₀² K₀²`. -/
noncomputable def ldG0 (t : ℝ) : ℝ :=
  besselI0 t ^ 2 * besselK0 t ^ 2

/-- `e1` of the ladder of `g = I₀² K₀²`. -/
noncomputable def ldG1 (t : ℝ) : ℝ :=
  2 * (besselI0 t * (t * besselI1 t) * besselK0 t ^ 2) +
    (-2) * (besselI0 t ^ 2 * besselK0 t * (t * besselK1 t))

/-- `e2` of the ladder of `g = I₀² K₀²`. -/
noncomputable def ldG2 (t : ℝ) : ℝ :=
  (t * besselI1 t) ^ 2 * besselK0 t ^ 2 +
    (-4) * (besselI0 t * (t * besselI1 t) * besselK0 t * (t * besselK1 t)) +
    besselI0 t ^ 2 * (t * besselK1 t) ^ 2

/-- `e3` of the ladder of `g = I₀² K₀²`. -/
noncomputable def ldG3 (t : ℝ) : ℝ :=
  2 * (besselI0 t * (t * besselI1 t) * (t * besselK1 t) ^ 2) +
    (-2) * ((t * besselI1 t) ^ 2 * besselK0 t * (t * besselK1 t))

/-- `e4` of the ladder of `g = I₀² K₀²`. -/
noncomputable def ldG4 (t : ℝ) : ℝ :=
  (t * besselI1 t) ^ 2 * (t * besselK1 t) ^ 2

/-- `θ e0 = e1`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldG0 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldG0 (ldG1 t / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hv := hasDerivAt_besselK0 ht
  have m1 := (hasDerivAt_prod4 hu hu hv hv).const_mul (1 : ℝ)
  have h0 := m1
  have hfun : ldG0 = fun x : ℝ =>
      1 * (besselI0 x * besselI0 x * besselK0 x * besselK0 x) := by
    funext x
    unfold ldG0
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldG1
  ring

/-- `θ e1 = 2 e2 + 4 t² e0`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldG1 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldG1 ((2 * ldG2 t + 4 * t ^ 2 * ldG0 t) / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hp := hasDerivAt_mul_besselI1 t
  have hv := hasDerivAt_besselK0 ht
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hu hp hv hv).const_mul (2 : ℝ)
  have m2 := (hasDerivAt_prod4 hu hu hv hq).const_mul (-2 : ℝ)
  have h0 := m1.add m2
  have hfun : ldG1 = fun x : ℝ =>
      2 * (besselI0 x * (x * besselI1 x) * besselK0 x * besselK0 x) +
        (-2) * (besselI0 x * besselI0 x * besselK0 x * (x * besselK1 x)) := by
    funext x
    unfold ldG1
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldG2 ldG0
  ring

/-- `θ e2 = 3 e3 + 3 t² e1`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldG2 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldG2 ((3 * ldG3 t + 3 * t ^ 2 * ldG1 t) / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hp := hasDerivAt_mul_besselI1 t
  have hv := hasDerivAt_besselK0 ht
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hp hp hv hv).const_mul (1 : ℝ)
  have m2 := (hasDerivAt_prod4 hu hp hv hq).const_mul (-4 : ℝ)
  have m3 := (hasDerivAt_prod4 hu hu hq hq).const_mul (1 : ℝ)
  have h0 := (m1.add m2).add m3
  have hfun : ldG2 = fun x : ℝ =>
      1 * ((x * besselI1 x) * (x * besselI1 x) * besselK0 x * besselK0 x) +
        (-4) * (besselI0 x * (x * besselI1 x) * besselK0 x * (x * besselK1 x)) +
        1 * (besselI0 x * besselI0 x * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldG2
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldG3 ldG1
  ring

/-- `θ e3 = 4 e4 + 2 t² e2`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldG3 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldG3 ((4 * ldG4 t + 2 * t ^ 2 * ldG2 t) / t) t := by
  have hu := hasDerivAt_besselI0 t
  have hp := hasDerivAt_mul_besselI1 t
  have hv := hasDerivAt_besselK0 ht
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hu hp hq hq).const_mul (2 : ℝ)
  have m2 := (hasDerivAt_prod4 hp hp hv hq).const_mul (-2 : ℝ)
  have h0 := m1.add m2
  have hfun : ldG3 = fun x : ℝ =>
      2 * (besselI0 x * (x * besselI1 x) * (x * besselK1 x) * (x * besselK1 x)) +
        (-2) * ((x * besselI1 x) * (x * besselI1 x) * besselK0 x * (x * besselK1 x)) := by
    funext x
    unfold ldG3
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldG4 ldG2
  ring

/-- `θ e4 = t² e3`, as `HasDerivAt` (`θ = t d/dt`). -/
theorem hasDerivAt_ldG4 {t : ℝ} (ht : 0 < t) :
    HasDerivAt ldG4 (t ^ 2 * ldG3 t / t) t := by
  have hp := hasDerivAt_mul_besselI1 t
  have hq := hasDerivAt_mul_besselK1 ht
  have m1 := (hasDerivAt_prod4 hp hp hq hq).const_mul (1 : ℝ)
  have h0 := m1
  have hfun : ldG4 = fun x : ℝ =>
      1 * ((x * besselI1 x) * (x * besselI1 x) * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldG4
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold ldG3
  ring

/-- `θ^0 g`. -/
noncomputable def thG0 (t : ℝ) : ℝ :=
  ldG0 t

/-- `θ^1 g`. -/
noncomputable def thG1 (t : ℝ) : ℝ :=
  ldG1 t

/-- `θ^2 g`. -/
noncomputable def thG2 (t : ℝ) : ℝ :=
  2 * ldG2 t + 4 * (t ^ 2 * ldG0 t)

/-- `θ^3 g`. -/
noncomputable def thG3 (t : ℝ) : ℝ :=
  6 * ldG3 t + 10 * (t ^ 2 * ldG1 t) + 8 * (t ^ 2 * ldG0 t)

/-- `θ^4 g`. -/
noncomputable def thG4 (t : ℝ) : ℝ :=
  24 * ldG4 t + 32 * (t ^ 2 * ldG2 t) + 28 * (t ^ 2 * ldG1 t) + 16 * (t ^ 2 * ldG0 t) +
    40 * (t ^ 4 * ldG0 t)

/-- `θ^5 g`. -/
noncomputable def thG5 (t : ℝ) : ℝ :=
  120 * (t ^ 2 * ldG3 t) + 120 * (t ^ 2 * ldG2 t) + 72 * (t ^ 2 * ldG1 t) + 32 * (t ^ 2 * ldG0 t) +
    136 * (t ^ 4 * ldG1 t) + 272 * (t ^ 4 * ldG0 t)

theorem hasDerivAt_thG0 {t : ℝ} (ht : 0 < t) : HasDerivAt thG0 (thG1 t / t) t := by
  have e0 := hasDerivAt_ldG0 ht
  have h0 := e0
  have hfun : thG0 = ldG0 := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thG1
  linear_combination (1 * ldG1 t) * hinv

theorem hasDerivAt_thG1 {t : ℝ} (ht : 0 < t) : HasDerivAt thG1 (thG2 t / t) t := by
  have e1 := hasDerivAt_ldG1 ht
  have h0 := e1
  have hfun : thG1 = ldG1 := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thG2
  linear_combination (2 * ldG2 t + 4 * t ^ 2 * ldG0 t) * hinv

theorem hasDerivAt_thG2 {t : ℝ} (ht : 0 < t) : HasDerivAt thG2 (thG3 t / t) t := by
  have e0 := hasDerivAt_ldG0 ht
  have e2 := hasDerivAt_ldG2 ht
  have s2 := hasDerivAt_sqx t
  have m1 := e2.const_mul (2 : ℝ)
  have m2 := (s2.mul e0).const_mul (4 : ℝ)
  have h0 := m1.add m2
  have hfun : thG2 = fun x : ℝ =>
      2 * ldG2 x + 4 * (x ^ 2 * ldG0 x) := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thG3
  linear_combination (6 * ldG3 t + 10 * t ^ 2 * ldG1 t) * hinv

theorem hasDerivAt_thG3 {t : ℝ} (ht : 0 < t) : HasDerivAt thG3 (thG4 t / t) t := by
  have e0 := hasDerivAt_ldG0 ht
  have e1 := hasDerivAt_ldG1 ht
  have e3 := hasDerivAt_ldG3 ht
  have s2 := hasDerivAt_sqx t
  have m1 := e3.const_mul (6 : ℝ)
  have m2 := (s2.mul e1).const_mul (10 : ℝ)
  have m3 := (s2.mul e0).const_mul (8 : ℝ)
  have h0 := (m1.add m2).add m3
  have hfun : thG3 = fun x : ℝ =>
      6 * ldG3 x + 10 * (x ^ 2 * ldG1 x) + 8 * (x ^ 2 * ldG0 x) := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thG4
  linear_combination (24 * ldG4 t + 32 * t ^ 2 * ldG2 t + 8 * t ^ 2 * ldG1 t +
    40 * t ^ 4 * ldG0 t) * hinv

theorem hasDerivAt_thG4 {t : ℝ} (ht : 0 < t) : HasDerivAt thG4 (thG5 t / t) t := by
  have e0 := hasDerivAt_ldG0 ht
  have e1 := hasDerivAt_ldG1 ht
  have e2 := hasDerivAt_ldG2 ht
  have e4 := hasDerivAt_ldG4 ht
  have s2 := hasDerivAt_sqx t
  have s4 := hasDerivAt_powfour t
  have m1 := e4.const_mul (24 : ℝ)
  have m2 := (s2.mul e2).const_mul (32 : ℝ)
  have m3 := (s2.mul e1).const_mul (28 : ℝ)
  have m4 := (s2.mul e0).const_mul (16 : ℝ)
  have m5 := (s4.mul e0).const_mul (40 : ℝ)
  have h0 := (((m1.add m2).add m3).add m4).add m5
  have hfun : thG4 = fun x : ℝ =>
      24 * ldG4 x + 32 * (x ^ 2 * ldG2 x) + 28 * (x ^ 2 * ldG1 x) + 16 * (x ^ 2 * ldG0 x) +
        40 * (x ^ 4 * ldG0 x) := rfl
  have hinv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  rw [hfun]
  refine h0.congr_deriv ?_
  beta_reduce
  rw [eq_div_iff ht.ne']
  unfold thG5
  linear_combination (120 * t ^ 2 * ldG3 t + 56 * t ^ 2 * ldG2 t + 16 * t ^ 2 * ldG1 t +
    136 * t ^ 4 * ldG1 t + 112 * t ^ 4 * ldG0 t) * hinv

/-- **`L₅` annihilates the θ-chain**: `θ⁵ - 4t²(5θ³ + 15θ² + 18θ + 8) + 64t⁴(θ + 2)`. -/
theorem L5_thG (t : ℝ) :
    thG5 t - 4 * t ^ 2 * (5 * thG3 t + 15 * thG2 t + 18 * thG1 t + 8 * thG0 t)
      + 64 * t ^ 4 * (thG1 t + 2 * thG0 t) = 0 := by
  unfold thG5 thG3 thG2 thG1 thG0
  ring

theorem thG0_eq_gB : thG0 = gB := by
  funext x
  rfl

/-- `L₅ gB = 0` on `t > 0`, as a chain of derivatives: `thGk = θ^k gB` and the equation. -/
theorem l5_gB : thG0 = gB ∧
    (∀ t : ℝ, 0 < t → HasDerivAt thG0 (thG1 t / t) t ∧ HasDerivAt thG1 (thG2 t / t) t ∧
      HasDerivAt thG2 (thG3 t / t) t ∧ HasDerivAt thG3 (thG4 t / t) t ∧
      HasDerivAt thG4 (thG5 t / t) t) ∧
    ∀ t : ℝ, thG5 t - 4 * t ^ 2 * (5 * thG3 t + 15 * thG2 t + 18 * thG1 t + 8 * thG0 t)
      + 64 * t ^ 4 * (thG1 t + 2 * thG0 t) = 0 :=
  ⟨thG0_eq_gB, fun _ ht => ⟨hasDerivAt_thG0 ht, hasDerivAt_thG1 ht, hasDerivAt_thG2 ht,
    hasDerivAt_thG3 ht, hasDerivAt_thG4 ht⟩, L5_thG⟩

end Tower.RV6
