/-!
# The rotation of the contour, II: the two rectangles

In the variable `w = log z` the rotated integrand is

`rotE s w = G(J₀(e^w), hE(e^w)) e^{sw}`,  `rotK s w = G(J₀(e^w), hK(e^w)) e^{sw}`

(`G = gpoly`; `hE`, `hK` are the two forms of `H₀⁽¹⁾`, `CKZero.lean`).  `rotE s` is differentiable
where `Re e^w > 0`, `rotK s` where `Im e^w > 0`, and they agree where both hold (`hE_eq_hK`).

* `rect_rotE`: Cauchy's theorem for `rotE s` on `[-R, R] × [0, π/4]`.
* `rect_rotK`: Cauchy's theorem for `rotK s` on `[-R, R] × [π/4, π/2]`.
* **`rect_rot`**: the sum; the common side `Im w = π/4` cancels:
  `∫_{-R}^{R} rotE s (x) dx - ∫_{-R}^{R} rotK s (x + iπ/2) dx + i sideInt s R - i sideInt s (-R) = 0`,
  where `sideInt s U = ∫₀^{π/4} rotE s (U + iy) dy + ∫_{π/4}^{π/2} rotK s (U + iy) dy`.

This file is generated by `tools/gen_rotrect.py`, which only substitutes repeated expressions.
-/

namespace Tower.RV6

open Real MeasureTheory

/-! ## Points `a + ib` -/

theorem re_add_mul_I (a b : ℝ) : ((a : ℂ) + (b : ℂ) * Complex.I).re = a := by
  rw [Complex.add_re, Complex.ofReal_re, Complex.mul_I_re, Complex.ofReal_im, neg_zero, add_zero]

theorem im_add_mul_I (a b : ℝ) : ((a : ℂ) + (b : ℂ) * Complex.I).im = b := by
  rw [Complex.add_im, Complex.ofReal_im, Complex.mul_I_im, Complex.ofReal_re, zero_add]

theorem cexp_add_mul_I_re (a b : ℝ) :
    (Complex.exp ((a : ℂ) + (b : ℂ) * Complex.I)).re = Real.exp a * Real.cos b := by
  rw [Complex.exp_re, re_add_mul_I, im_add_mul_I]

theorem cexp_add_mul_I_im (a b : ℝ) :
    (Complex.exp ((a : ℂ) + (b : ℂ) * Complex.I)).im = Real.exp a * Real.sin b := by
  rw [Complex.exp_im, re_add_mul_I, im_add_mul_I]

/-! ## The rotated integrands -/

/-- `G(J₀(e^w), hE(e^w)) e^{sw}`. -/
noncomputable def rotE (s : ℝ) (w : ℂ) : ℂ :=
  gpoly (cJ0 (Complex.exp w)) (hE (Complex.exp w)) * Complex.exp ((s : ℂ) * w)

/-- `G(J₀(e^w), hK(e^w)) e^{sw}`. -/
noncomputable def rotK (s : ℝ) (w : ℂ) : ℂ :=
  gpoly (cJ0 (Complex.exp w)) (hK (Complex.exp w)) * Complex.exp ((s : ℂ) * w)

theorem differentiableAt_gpoly_mul {J H E : ℂ → ℂ} {w : ℂ} (hJ : DifferentiableAt ℂ J w)
    (hH : DifferentiableAt ℂ H w) (hEx : DifferentiableAt ℂ E w) :
    DifferentiableAt ℂ (fun y : ℂ => gpoly (J y) (H y) * E y) w := by
  have t1 : DifferentiableAt ℂ (fun y : ℂ => 3 / 8 * J y * H y ^ 5) w :=
    (hJ.const_mul (3 / 8 : ℂ)).fun_mul (hH.fun_pow 5)
  have t2 : DifferentiableAt ℂ (fun y : ℂ => 15 / 8 * J y ^ 2 * H y ^ 4) w :=
    ((hJ.fun_pow 2).const_mul (15 / 8 : ℂ)).fun_mul (hH.fun_pow 4)
  have t3 : DifferentiableAt ℂ (fun y : ℂ => 5 / 2 * J y ^ 3 * H y ^ 3) w :=
    ((hJ.fun_pow 3).const_mul (5 / 2 : ℂ)).fun_mul (hH.fun_pow 3)
  have t4 : DifferentiableAt ℂ (fun y : ℂ =>
      3 / 8 * J y * H y ^ 5 - 15 / 8 * J y ^ 2 * H y ^ 4 + 5 / 2 * J y ^ 3 * H y ^ 3) w :=
    (t1.fun_sub t2).fun_add t3
  have t5 : DifferentiableAt ℂ (fun y : ℂ =>
      (3 / 8 * J y * H y ^ 5 - 15 / 8 * J y ^ 2 * H y ^ 4 + 5 / 2 * J y ^ 3 * H y ^ 3) * E y) w :=
    t4.fun_mul hEx
  exact t5

/-- `rotE s` is differentiable where `Re e^w > 0`. -/
theorem differentiableAt_rotE (s : ℝ) {w : ℂ} (hw : 0 < (Complex.exp w).re) :
    DifferentiableAt ℂ (rotE s) w := by
  have hexp : HasDerivAt Complex.exp (Complex.exp w) w := Complex.hasDerivAt_exp w
  have hJ0 : HasDerivAt cJ0 (deriv cJ0 (Complex.exp w)) (Complex.exp w) :=
    (differentiable_cJ0 (Complex.exp w)).hasDerivAt
  have hJ1 := HasDerivAt.comp w hJ0 hexp
  have dJ : DifferentiableAt ℂ (fun y : ℂ => cJ0 (Complex.exp y)) w := hJ1.differentiableAt
  have hH0 : HasDerivAt hE (deriv hE (Complex.exp w)) (Complex.exp w) :=
    (differentiableAt_hE hw).hasDerivAt
  have hH1 := HasDerivAt.comp w hH0 hexp
  have dH : DifferentiableAt ℂ (fun y : ℂ => hE (Complex.exp y)) w := hH1.differentiableAt
  have hs : HasDerivAt (fun y : ℂ => (s : ℂ) * y) ((s : ℂ) * 1) w :=
    (hasDerivAt_id' w).const_mul (s : ℂ)
  have hEx : HasDerivAt (fun y : ℂ => Complex.exp ((s : ℂ) * y))
      (Complex.exp ((s : ℂ) * w) * ((s : ℂ) * 1)) w := hs.cexp
  have h := differentiableAt_gpoly_mul dJ dH hEx.differentiableAt
  show DifferentiableAt ℂ (fun y : ℂ =>
    gpoly (cJ0 (Complex.exp y)) (hE (Complex.exp y)) * Complex.exp ((s : ℂ) * y)) w
  exact h

/-- `rotK s` is differentiable where `Im e^w > 0`. -/
theorem differentiableAt_rotK (s : ℝ) {w : ℂ} (hw : 0 < (Complex.exp w).im) :
    DifferentiableAt ℂ (rotK s) w := by
  have hexp : HasDerivAt Complex.exp (Complex.exp w) w := Complex.hasDerivAt_exp w
  have hJ0 : HasDerivAt cJ0 (deriv cJ0 (Complex.exp w)) (Complex.exp w) :=
    (differentiable_cJ0 (Complex.exp w)).hasDerivAt
  have hJ1 := HasDerivAt.comp w hJ0 hexp
  have dJ : DifferentiableAt ℂ (fun y : ℂ => cJ0 (Complex.exp y)) w := hJ1.differentiableAt
  have hH0 : HasDerivAt hK (deriv hK (Complex.exp w)) (Complex.exp w) :=
    (differentiableAt_hK hw).hasDerivAt
  have hH1 := HasDerivAt.comp w hH0 hexp
  have dH : DifferentiableAt ℂ (fun y : ℂ => hK (Complex.exp y)) w := hH1.differentiableAt
  have hs : HasDerivAt (fun y : ℂ => (s : ℂ) * y) ((s : ℂ) * 1) w :=
    (hasDerivAt_id' w).const_mul (s : ℂ)
  have hEx : HasDerivAt (fun y : ℂ => Complex.exp ((s : ℂ) * y))
      (Complex.exp ((s : ℂ) * w) * ((s : ℂ) * 1)) w := hs.cexp
  have h := differentiableAt_gpoly_mul dJ dH hEx.differentiableAt
  show DifferentiableAt ℂ (fun y : ℂ =>
    gpoly (cJ0 (Complex.exp y)) (hK (Complex.exp y)) * Complex.exp ((s : ℂ) * y)) w
  exact h

/-- The two integrands agree for `0 < Im w < π/2`. -/
theorem rotE_eq_rotK (s U : ℝ) {y : ℝ} (hy0 : 0 < y) (hy1 : y < π / 2) :
    rotE s ((U : ℂ) + (y : ℂ) * Complex.I) = rotK s ((U : ℂ) + (y : ℂ) * Complex.I) := by
  have hpi : 0 < π := Real.pi_pos
  have hx : 0 < (Complex.exp ((U : ℂ) + (y : ℂ) * Complex.I)).re := by
    rw [cexp_add_mul_I_re]
    exact mul_pos (Real.exp_pos U) (Real.cos_pos_of_mem_Ioo ⟨by linarith, hy1⟩)
  have hyp : 0 < (Complex.exp ((U : ℂ) + (y : ℂ) * Complex.I)).im := by
    rw [cexp_add_mul_I_im]
    exact mul_pos (Real.exp_pos U) (Real.sin_pos_of_pos_of_lt_pi hy0 (by linarith))
  show gpoly (cJ0 (Complex.exp ((U : ℂ) + (y : ℂ) * Complex.I))) (hE (Complex.exp ((U : ℂ) + (y : ℂ) * Complex.I)))
        * Complex.exp ((s : ℂ) * ((U : ℂ) + (y : ℂ) * Complex.I))
      = gpoly (cJ0 (Complex.exp ((U : ℂ) + (y : ℂ) * Complex.I))) (hK (Complex.exp ((U : ℂ) + (y : ℂ) * Complex.I)))
        * Complex.exp ((s : ℂ) * ((U : ℂ) + (y : ℂ) * Complex.I))
  rw [hE_eq_hK hx hyp]

/-! ## Cauchy's theorem on the two rectangles -/

/-- `rotE s` on `[-R, R] × [0, π/4]`. -/
theorem rect_rotE (s R : ℝ) :
    (∫ x in (-R)..R, rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))
      - (∫ x in (-R)..R, rotE s ((x : ℂ) + ((π / 4 : ℝ) : ℂ) * Complex.I))
      + Complex.I * (∫ y in (0 : ℝ)..(π / 4), rotE s ((R : ℂ) + (y : ℂ) * Complex.I))
      - Complex.I * (∫ y in (0 : ℝ)..(π / 4), rotE s (((-R : ℝ) : ℂ) + (y : ℂ) * Complex.I)) = 0 := by
  have hpi : 0 < π := Real.pi_pos
  have h4 : (0 : ℝ) ≤ π / 4 := by linarith
  have hd : DifferentiableOn ℂ (rotE s)
      (Complex.reProdIm (Set.uIcc (-R) R) (Set.uIcc (0 : ℝ) (π / 4))) := by
    intro w hw
    have him : w.im ∈ Set.uIcc (0 : ℝ) (π / 4) := (Complex.mem_reProdIm.mp hw).2
    rw [Set.uIcc_of_le h4] at him
    have hpos : 0 < (Complex.exp w).re := by
      rw [Complex.exp_re]
      exact mul_pos (Real.exp_pos _)
        (Real.cos_pos_of_mem_Ioo ⟨by linarith [him.1], by linarith [him.2]⟩)
    exact (differentiableAt_rotE s hpos).differentiableWithinAt
  have h := Complex.integral_boundary_rect_eq_zero_of_differentiableOn (rotE s)
    (⟨-R, 0⟩ : ℂ) (⟨R, π / 4⟩ : ℂ) hd
  have h' : (∫ x in (-R)..R, rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))
      - (∫ x in (-R)..R, rotE s ((x : ℂ) + ((π / 4 : ℝ) : ℂ) * Complex.I))
      + Complex.I • (∫ y in (0 : ℝ)..(π / 4), rotE s ((R : ℂ) + (y : ℂ) * Complex.I))
      - Complex.I • (∫ y in (0 : ℝ)..(π / 4), rotE s (((-R : ℝ) : ℂ) + (y : ℂ) * Complex.I)) = 0 := h
  rw [smul_eq_mul, smul_eq_mul] at h'
  exact h'

/-- `rotK s` on `[-R, R] × [π/4, π/2]`. -/
theorem rect_rotK (s R : ℝ) :
    (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 4 : ℝ) : ℂ) * Complex.I))
      - (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I))
      + Complex.I * (∫ y in (π / 4)..(π / 2), rotK s ((R : ℂ) + (y : ℂ) * Complex.I))
      - Complex.I * (∫ y in (π / 4)..(π / 2), rotK s (((-R : ℝ) : ℂ) + (y : ℂ) * Complex.I)) = 0 := by
  have hpi : 0 < π := Real.pi_pos
  have h42 : π / 4 ≤ π / 2 := by linarith
  have hd : DifferentiableOn ℂ (rotK s)
      (Complex.reProdIm (Set.uIcc (-R) R) (Set.uIcc (π / 4) (π / 2))) := by
    intro w hw
    have him : w.im ∈ Set.uIcc (π / 4) (π / 2) := (Complex.mem_reProdIm.mp hw).2
    rw [Set.uIcc_of_le h42] at him
    have hpos : 0 < (Complex.exp w).im := by
      rw [Complex.exp_im]
      exact mul_pos (Real.exp_pos _)
        (Real.sin_pos_of_pos_of_lt_pi (by linarith [him.1]) (by linarith [him.2]))
    exact (differentiableAt_rotK s hpos).differentiableWithinAt
  have h := Complex.integral_boundary_rect_eq_zero_of_differentiableOn (rotK s)
    (⟨-R, π / 4⟩ : ℂ) (⟨R, π / 2⟩ : ℂ) hd
  have h' : (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 4 : ℝ) : ℂ) * Complex.I))
      - (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I))
      + Complex.I • (∫ y in (π / 4)..(π / 2), rotK s ((R : ℂ) + (y : ℂ) * Complex.I))
      - Complex.I • (∫ y in (π / 4)..(π / 2), rotK s (((-R : ℝ) : ℂ) + (y : ℂ) * Complex.I)) = 0 := h
  rw [smul_eq_mul, smul_eq_mul] at h'
  exact h'

/-! ## The sum -/

/-- The two vertical pieces at abscissa `U`:
`∫₀^{π/4} rotE s (U + iy) dy + ∫_{π/4}^{π/2} rotK s (U + iy) dy`. -/
noncomputable def sideInt (s U : ℝ) : ℂ :=
  (∫ y in (0 : ℝ)..(π / 4), rotE s ((U : ℂ) + (y : ℂ) * Complex.I))
    + ∫ y in (π / 4)..(π / 2), rotK s ((U : ℂ) + (y : ℂ) * Complex.I)

/-- **The rotated contour at finite `R`.** -/
theorem rect_rot (s R : ℝ) :
    (∫ x in (-R)..R, rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))
      - (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I))
      + Complex.I * sideInt s R - Complex.I * sideInt s (-R) = 0 := by
  have hpi : 0 < π := Real.pi_pos
  have h4 : (0 : ℝ) < π / 4 := by linarith
  have h42 : π / 4 < π / 2 := by linarith
  have h1 := rect_rotE s R
  have h2 := rect_rotK s R
  have hfun : (fun x : ℝ => rotE s ((x : ℂ) + ((π / 4 : ℝ) : ℂ) * Complex.I))
      = fun x : ℝ => rotK s ((x : ℂ) + ((π / 4 : ℝ) : ℂ) * Complex.I) :=
    funext (fun x => rotE_eq_rotK s x h4 h42)
  rw [hfun] at h1
  show (∫ x in (-R)..R, rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I))
      - (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I))
      + Complex.I * ((∫ y in (0 : ℝ)..(π / 4), rotE s ((R : ℂ) + (y : ℂ) * Complex.I))
          + ∫ y in (π / 4)..(π / 2), rotK s ((R : ℂ) + (y : ℂ) * Complex.I))
      - Complex.I * ((∫ y in (0 : ℝ)..(π / 4), rotE s (((-R : ℝ) : ℂ) + (y : ℂ) * Complex.I))
          + ∫ y in (π / 4)..(π / 2), rotK s (((-R : ℝ) : ℂ) + (y : ℂ) * Complex.I)) = 0
  linear_combination h1 + h2

