/-- The real part of an interval integral. -/
theorem re_intervalIntegral {f : ℝ → ℂ} {a b : ℝ} (hf : IntervalIntegrable f volume a b) :
    (∫ x in a..b, f x).re = ∫ x in a..b, (f x).re := by
