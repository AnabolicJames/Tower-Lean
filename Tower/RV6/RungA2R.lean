/-! ## The real identity at finite `R` -/

/-- **The rotated contour at finite `R`, real parts.** -/
theorem rot_real_identity (s R : ℝ) :
    (∫ x in (-R)..R, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x)) - (∫ x in (-R)..R, topRe s x) + (Complex.I * sideInt s R - Complex.I * sideInt s (-R)).re = 0 := by
  have h := rect_rot s R
  have hA1 : (∫ x in (-R)..R, rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I)).re = ∫ x in (-R)..R, (rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I)).re :=
    re_intervalIntegral ((continuous_rotE_bottom s).intervalIntegrable (-R) R)
  have hAf : (fun x : ℝ => (rotE s ((x : ℂ) + ((0 : ℝ) : ℂ) * Complex.I)).re) = fun x : ℝ => besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x) :=
    funext (fun x => rotE_bottom_re s x)
  rw [hAf] at hA1
  have hB1 : (∫ x in (-R)..R, rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I)).re = ∫ x in (-R)..R, (rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I)).re :=
    re_intervalIntegral ((continuous_rotK_top s).intervalIntegrable (-R) R)
  have hBf : (fun x : ℝ => (rotK s ((x : ℂ) + ((π / 2 : ℝ) : ℂ) * Complex.I)).re) = fun x : ℝ => topRe s x :=
    funext (fun x => rotK_top_re s x)
  rw [hBf] at hB1
  have h2 := congrArg Complex.re h
  simp only [Complex.sub_re, Complex.add_re, Complex.zero_re] at h2
  rw [hA1, hB1] at h2
  rw [Complex.sub_re]
  linarith

/-! ## The limit `R → ∞` -/

/-- **Sub-rung A2R.** -/
theorem rungA2R : RungA2R := by
  unfold RungA2R
  intro s hs0 hs1
  have hs3 : s < 3 := by linarith
  have ha : Filter.Tendsto (fun R : ℝ => ∫ x in (-R)..R, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x)) Filter.atTop
      (nhds (∫ x : ℝ, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x))) :=
    intervalIntegral_tendsto_integral (integrable_besselJ0_pow_six_exp hs0 hs3)
      Filter.tendsto_neg_atTop_atBot Filter.tendsto_id
  have hb : Filter.Tendsto (fun R : ℝ => ∫ x in (-R)..R, topRe s x) Filter.atTop
      (nhds (∫ x : ℝ, topRe s x)) :=
    intervalIntegral_tendsto_integral (integrable_topRe hs0 hs3)
      Filter.tendsto_neg_atTop_atBot Filter.tendsto_id
  have hS1 : Filter.Tendsto (fun R : ℝ => Complex.I * sideInt s R) Filter.atTop
      (nhds (Complex.I * 0)) := (tendsto_sideInt_atTop hs0 hs1).const_mul Complex.I
  have hS2 : Filter.Tendsto (fun R : ℝ => Complex.I * sideInt s (-R)) Filter.atTop
      (nhds (Complex.I * 0)) := (tendsto_sideInt_neg hs0 hs1).const_mul Complex.I
  have hS : Filter.Tendsto
      (fun R : ℝ => Complex.I * sideInt s R - Complex.I * sideInt s (-R)) Filter.atTop
      (nhds (Complex.I * 0 - Complex.I * 0)) := hS1.sub hS2
  have hSre0 := (Complex.continuous_re.tendsto (Complex.I * 0 - Complex.I * 0)).comp hS
  have hSre : Filter.Tendsto (fun R : ℝ => (Complex.I * sideInt s R - Complex.I * sideInt s (-R)).re) Filter.atTop
      (nhds (Complex.I * 0 - Complex.I * 0).re) := hSre0
  have hlim : Filter.Tendsto
      (fun R : ℝ => (∫ x in (-R)..R, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x)) - (∫ x in (-R)..R, topRe s x) + (Complex.I * sideInt s R - Complex.I * sideInt s (-R)).re)
      Filter.atTop
      (nhds ((∫ x : ℝ, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x)) - (∫ x : ℝ, topRe s x)
        + (Complex.I * 0 - Complex.I * 0).re)) := (ha.sub hb).add hSre
  have hconst : (fun R : ℝ =>
        (∫ x in (-R)..R, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x)) - (∫ x in (-R)..R, topRe s x) + (Complex.I * sideInt s R - Complex.I * sideInt s (-R)).re)
      = fun _ : ℝ => (0 : ℝ) := funext (fun R => rot_real_identity s R)
  rw [hconst] at hlim
  have h0 : (∫ x : ℝ, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x)) - (∫ x : ℝ, topRe s x)
      + (Complex.I * 0 - Complex.I * 0).re = 0 :=
    tendsto_nhds_unique hlim tendsto_const_nhds
  have hz : (Complex.I * (0 : ℂ) - Complex.I * 0).re = 0 := by
    rw [mul_zero, sub_zero, Complex.zero_re]
  rw [hz, add_zero, integral_topRe hs0 hs3] at h0
  have hN : mellN s = ∫ x : ℝ, besselJ0 (Real.exp x) ^ 6 * Real.exp (s * x) := rfl
  linarith

/-- **The six-step theorem from Rung B alone.** -/
theorem rv6_of_B (hB : RungB) : mu6 = 648 / π ^ 6 * Lf5 :=
  rv6_of_A2R_B rungA2R hB

end Tower.RV6
