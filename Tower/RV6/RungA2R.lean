/-- A function differentiable at every point of a horizontal line is continuous along it. -/
theorem continuous_comp_line (F : ℂ → ℂ) (b : ℝ)
    (hF : ∀ x : ℝ, DifferentiableAt ℂ F ((x : ℂ) + (b : ℂ) * Complex.I)) :
    Continuous (fun x : ℝ => F ((x : ℂ) + (b : ℂ) * Complex.I)) := by
  have hline : Continuous (fun x : ℝ => (x : ℂ) + (b : ℂ) * Complex.I) :=
    Complex.continuous_ofReal.add continuous_const
  refine continuous_iff_continuousAt.mpr (fun x => ?_)
  have h1 : ContinuousAt F ((x : ℂ) + (b : ℂ) * Complex.I) := (hF x).continuousAt
  have h2 : ContinuousAt (F ∘ (fun x : ℝ => (x : ℂ) + (b : ℂ) * Complex.I)) x :=
    ContinuousAt.comp h1 hline.continuousAt
  exact h2

