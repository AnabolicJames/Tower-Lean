theorem hasDerivAt_m1F {w : ℝ} (hw : 0 < w) : HasDerivAt m1F (m1dF w) w := by
  have hP : Pax w * (Pax w)⁻¹ = 1 := mul_inv_cancel₀ (Pax_ne_zero hw)
  have dw : HasDerivAt (fun x : ℝ => x) 1 w := hasDerivAt_id' w
  have dZ := hasDerivAt_Zax hw
  have dE := hasDerivAt_Eax hw
  have dPi := (hasDerivAt_Pax hw).inv (Pax_ne_zero hw)
  have m1 := ((dw.mul dZ).mul dPi).const_mul ((384 : ℝ) * hk thF0 0 * π⁻¹)
  have m2 := ((((dw.mul dw).mul dZ).mul dE).mul dPi).const_mul ((-384 : ℝ) * hk thF0 0)
  have h := m1.add m2
  exact h.congr_deriv (by
    unfold m1dF
    simp only [Pi.mul_apply, Pi.inv_apply]
    linear_combination (((768 : ℝ) * hk thF0 0 * π * π⁻¹) * (w * Zax w * Eax w * (Pax w)⁻¹) + ((-768 : ℝ) * hk thF0 0 * π) * (w * w * Zax w * Eax w * Eax w * (Pax w)⁻¹)) * hP)

/-- **`Φ₁(X(w)) = m1F w`** (uniqueness of the derivative of `Φ₀(X(w)) = 48 a₀ w² Z(w)`). -/
theorem phi1_eq {w : ℝ} (hw : 0 < w) : -(Xc w ^ 2 * hk thF1 (Xc w)) = m1F w := by
  have hc := hasDerivAt_g0 hw
  have he : HasDerivAt (fun w : ℝ => 48 * hk thF0 0 * w ^ 2 * Zax w)
      (48 * hk thF0 0 * (2 * w) * Zax w + 48 * hk thF0 0 * w ^ 2 * (-(2 * π) * (Zax w * Eax w))) w :=
    ((hasDerivAt_sqx w).const_mul (48 * hk thF0 0)).mul (hasDerivAt_Zax hw)
  have heq : (fun w : ℝ => Xc w ^ 2 * hk thF0 (Xc w))
      =ᶠ[nhds w] (fun w : ℝ => 48 * hk thF0 0 * w ^ 2 * Zax w) := by
    filter_upwards [Ioi_mem_nhds hw] with s hs
    exact g0_eq hs
  have hu := hc.unique (he.congr_of_eventuallyEq heq)
  have hP : Pax w * (Pax w)⁻¹ = 1 := mul_inv_cancel₀ (Pax_ne_zero hw)
  have hpi : π * π⁻¹ = 1 := mul_inv_cancel₀ Real.pi_ne_zero
  unfold m1F
  linear_combination (4 * π⁻¹ * (Pax w)⁻¹) * hu + (((-1 : ℝ) * π * π⁻¹) * ((-(Xc w ^ 2 * hk thF1 (Xc w))))) * hP + (((-1 : ℝ)) * ((-(Xc w ^ 2 * hk thF1 (Xc w)))) + ((-384 : ℝ) * hk thF0 0) * (w * w * Zax w * Eax w * (Pax w)⁻¹)) * hpi

/-- **`Φ₂(X(w)) = m2F w`**. -/
theorem phi2_eq {w : ℝ} (hw : 0 < w) : Xc w ^ 2 * hk thF2 (Xc w) = m2F w := by
  have hc := hasDerivAt_g1 hw
  have he := hasDerivAt_m1F hw
  have heq : (fun w : ℝ => -(Xc w ^ 2 * hk thF1 (Xc w))) =ᶠ[nhds w] m1F := by
    filter_upwards [Ioi_mem_nhds hw] with s hs
    exact phi1_eq hs
  have hu := hc.unique (he.congr_of_eventuallyEq heq)
  have hP : Pax w * (Pax w)⁻¹ = 1 := mul_inv_cancel₀ (Pax_ne_zero hw)
  have hpi : π * π⁻¹ = 1 := mul_inv_cancel₀ Real.pi_ne_zero
  unfold m1dF at hu
  unfold m2F
  linear_combination (4 * π⁻¹ * (Pax w)⁻¹) * hu + (((-1 : ℝ) * π * π⁻¹) * ((Xc w ^ 2 * hk thF2 (Xc w)))) * hP + (((-1 : ℝ)) * ((Xc w ^ 2 * hk thF2 (Xc w))) + ((786432 : ℝ) * hk thF0 0 * π⁻¹) * (w * Zax w * Uax w * Uax w * (Pax w)⁻¹ * (Pax w)⁻¹ * (Pax w)⁻¹) + ((122880 : ℝ) * hk thF0 0 * π⁻¹) * (w * Zax w * Zax w * Uax w * (Pax w)⁻¹ * (Pax w)⁻¹ * (Pax w)⁻¹) + ((1536 : ℝ) * hk thF0 0) * (w * w * Zax w * Eax w * Eax w * (Pax w)⁻¹ * (Pax w)⁻¹) + ((-786432 : ℝ) * hk thF0 0) * (w * w * Zax w * Eax w * Uax w * Uax w * (Pax w)⁻¹ * (Pax w)⁻¹ * (Pax w)⁻¹) + ((-98304 : ℝ) * hk thF0 0) * (w * w * Zax w * Uax w * Uax w * (Pax w)⁻¹ * (Pax w)⁻¹) + ((-122880 : ℝ) * hk thF0 0) * (w * w * Zax w * Zax w * Eax w * Uax w * (Pax w)⁻¹ * (Pax w)⁻¹ * (Pax w)⁻¹) + ((-12288 : ℝ) * hk thF0 0) * (w * w * Zax w * Zax w * Uax w * (Pax w)⁻¹ * (Pax w)⁻¹)) * hpi

/-- `m2F → 96 a₀/π²` as `w → ∞`. -/
theorem tendsto_m2F : Tendsto m2F atTop (nhds (96 * hk thF0 0 * π⁻¹ ^ 2)) := by
