  have l8 := ((((((tE.mul tPi).mul tPi).mul tPi).mul tZ).mul tZ).mul tW2U).const_mul ((-122880 : ℝ) * hk thF0 0)
  have l9 := ((((tPi.mul tPi).mul tZ).mul tZ).mul tW2U).const_mul ((-12288 : ℝ) * hk thF0 0)
