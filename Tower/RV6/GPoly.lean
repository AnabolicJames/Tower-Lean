/-! ## The polynomial -/

/-- `G(J, H) = (3/8) J H⁵ - (15/8) J² H⁴ + (5/2) J³ H³`. -/
noncomputable def gpoly (J H : ℂ) : ℂ :=
  3 / 8 * J * H ^ 5 - 15 / 8 * J ^ 2 * H ^ 4 + 5 / 2 * J ^ 3 * H ^ 3

/-- `G(j, j + iy) = j⁶ + i ((15/8) j⁵ y + (5/4) j³ y³ + (3/8) j y⁵)` for real `j`, `y`. -/
theorem gpoly_ofReal_add (j y : ℝ) :
    gpoly (j : ℂ) ((j : ℂ) + (y : ℂ) * Complex.I)
      = ((j ^ 6 : ℝ) : ℂ)
        + ((15 / 8 * j ^ 5 * y + 5 / 4 * j ^ 3 * y ^ 3 + 3 / 8 * j * y ^ 5 : ℝ) : ℂ)
          * Complex.I := by
  show 3 / 8 * (j : ℂ) * ((j : ℂ) + (y : ℂ) * Complex.I) ^ 5
        - 15 / 8 * (j : ℂ) ^ 2 * ((j : ℂ) + (y : ℂ) * Complex.I) ^ 4
        + 5 / 2 * (j : ℂ) ^ 3 * ((j : ℂ) + (y : ℂ) * Complex.I) ^ 3
      = ((j ^ 6 : ℝ) : ℂ)
        + ((15 / 8 * j ^ 5 * y + 5 / 4 * j ^ 3 * y ^ 3 + 3 / 8 * j * y ^ 5 : ℝ) : ℂ)
          * Complex.I
  push_cast
  linear_combination ((-3 / 8 : ℂ) * Complex.I * (j : ℂ) * (y : ℂ) ^ 5
      + (-5 / 4 : ℂ) * Complex.I * (j : ℂ) ^ 3 * (y : ℂ) ^ 3
      + (3 / 8 : ℂ) * Complex.I ^ 3 * (j : ℂ) * (y : ℂ) ^ 5) * Complex.I_sq

/-- **`Re G(J, H) = J⁶`** when `J` is real and `Re H = J`. -/
theorem gpoly_re (J : ℝ) (H : ℂ) (hH : H.re = J) : (gpoly (J : ℂ) H).re = J ^ 6 := by
  have h0 : (H.re : ℂ) + (H.im : ℂ) * Complex.I = H := Complex.re_add_im H
  rw [hH] at h0
  have key := gpoly_ofReal_add J H.im
  rw [h0] at key
  rw [key, Complex.add_re, Complex.ofReal_re, Complex.mul_I_re, Complex.ofReal_im, neg_zero,
    add_zero]

/-- On the imaginary axis: `G(a, -(2i/π) k) · r (c + iσ)` for real `a, k, r, c, σ`. -/
theorem gpoly_I_axis_mul (a k r c σ : ℝ) :
    gpoly (a : ℂ) (-(2 * Complex.I / (π : ℂ)) * (k : ℂ)) * ((r : ℂ) * ((c : ℂ) + (σ : ℂ) * Complex.I))
      = ((r * (12 / π ^ 5 * σ * (a * k ^ 5) - 30 / π ^ 4 * c * (a ^ 2 * k ^ 4)
            - 20 / π ^ 3 * σ * (a ^ 3 * k ^ 3)) : ℝ) : ℂ)
        + ((r * (-(12 / π ^ 5 * c * (a * k ^ 5)) - 30 / π ^ 4 * σ * (a ^ 2 * k ^ 4)
            + 20 / π ^ 3 * c * (a ^ 3 * k ^ 3)) : ℝ) : ℂ) * Complex.I := by
  show (3 / 8 * (a : ℂ) * (-(2 * Complex.I / (π : ℂ)) * (k : ℂ)) ^ 5
        - 15 / 8 * (a : ℂ) ^ 2 * (-(2 * Complex.I / (π : ℂ)) * (k : ℂ)) ^ 4
        + 5 / 2 * (a : ℂ) ^ 3 * (-(2 * Complex.I / (π : ℂ)) * (k : ℂ)) ^ 3)
        * ((r : ℂ) * ((c : ℂ) + (σ : ℂ) * Complex.I))
      = ((r * (12 / π ^ 5 * σ * (a * k ^ 5) - 30 / π ^ 4 * c * (a ^ 2 * k ^ 4)
            - 20 / π ^ 3 * σ * (a ^ 3 * k ^ 3)) : ℝ) : ℂ)
        + ((r * (-(12 / π ^ 5 * c * (a * k ^ 5)) - 30 / π ^ 4 * σ * (a ^ 2 * k ^ 4)
            + 20 / π ^ 3 * c * (a ^ 3 * k ^ 3)) : ℝ) : ℂ) * Complex.I
  push_cast
  linear_combination ((12 : ℂ) * (a : ℂ) * (c : ℂ) * Complex.I * (k : ℂ) ^ 5 * (π : ℂ)⁻¹ ^ 5 * (r : ℂ)
      + (-12 : ℂ) * (a : ℂ) * (c : ℂ) * Complex.I ^ 3 * (k : ℂ) ^ 5 * (π : ℂ)⁻¹ ^ 5 * (r : ℂ)
      + (12 : ℂ) * (a : ℂ) * Complex.I ^ 2 * (k : ℂ) ^ 5 * (π : ℂ)⁻¹ ^ 5 * (r : ℂ) * (σ : ℂ)
      + (-12 : ℂ) * (a : ℂ) * Complex.I ^ 4 * (k : ℂ) ^ 5 * (π : ℂ)⁻¹ ^ 5 * (r : ℂ) * (σ : ℂ)
      + (-12 : ℂ) * (a : ℂ) * (k : ℂ) ^ 5 * (π : ℂ)⁻¹ ^ 5 * (r : ℂ) * (σ : ℂ)
      + (-30 : ℂ) * (a : ℂ) ^ 2 * (c : ℂ) * Complex.I ^ 2 * (k : ℂ) ^ 4 * (π : ℂ)⁻¹ ^ 4 * (r : ℂ)
      + (30 : ℂ) * (a : ℂ) ^ 2 * (c : ℂ) * (k : ℂ) ^ 4 * (π : ℂ)⁻¹ ^ 4 * (r : ℂ)
      + (30 : ℂ) * (a : ℂ) ^ 2 * Complex.I * (k : ℂ) ^ 4 * (π : ℂ)⁻¹ ^ 4 * (r : ℂ) * (σ : ℂ)
      + (-30 : ℂ) * (a : ℂ) ^ 2 * Complex.I ^ 3 * (k : ℂ) ^ 4 * (π : ℂ)⁻¹ ^ 4 * (r : ℂ) * (σ : ℂ)
      + (-20 : ℂ) * (a : ℂ) ^ 3 * (c : ℂ) * Complex.I * (k : ℂ) ^ 3 * (π : ℂ)⁻¹ ^ 3 * (r : ℂ)
      + (-20 : ℂ) * (a : ℂ) ^ 3 * Complex.I ^ 2 * (k : ℂ) ^ 3 * (π : ℂ)⁻¹ ^ 3 * (r : ℂ) * (σ : ℂ)
      + (20 : ℂ) * (a : ℂ) ^ 3 * (k : ℂ) ^ 3 * (π : ℂ)⁻¹ ^ 3 * (r : ℂ) * (σ : ℂ)) * Complex.I_sq

/-- **The real part on the imaginary axis.** -/
theorem gpoly_I_axis_mul_re (a k r c σ : ℝ) :
    (gpoly (a : ℂ) (-(2 * Complex.I / (π : ℂ)) * (k : ℂ)) * ((r : ℂ) * ((c : ℂ) + (σ : ℂ) * Complex.I))).re
      = r * (12 / π ^ 5 * σ * (a * k ^ 5) - 30 / π ^ 4 * c * (a ^ 2 * k ^ 4)
          - 20 / π ^ 3 * σ * (a ^ 3 * k ^ 3)) := by
  rw [gpoly_I_axis_mul, Complex.add_re, Complex.ofReal_re, Complex.mul_I_re, Complex.ofReal_im,
    neg_zero, add_zero]

/-! ## The triangle inequality for `G` -/

theorem norm_gpoly_le (J H : ℂ) :
    ‖gpoly J H‖
      ≤ 3 / 8 * ‖J‖ * ‖H‖ ^ 5 + 15 / 8 * ‖J‖ ^ 2 * ‖H‖ ^ 4 + 5 / 2 * ‖J‖ ^ 3 * ‖H‖ ^ 3 := by
  have c1 : ‖(3 / 8 : ℂ)‖ = 3 / 8 := by
    rw [norm_div, Complex.norm_ofNat, Complex.norm_ofNat]
  have c2 : ‖(15 / 8 : ℂ)‖ = 15 / 8 := by
    rw [norm_div, Complex.norm_ofNat, Complex.norm_ofNat]
  have c3 : ‖(5 / 2 : ℂ)‖ = 5 / 2 := by
    rw [norm_div, Complex.norm_ofNat, Complex.norm_ofNat]
  have n1 : ‖3 / 8 * J * H ^ 5‖ = 3 / 8 * ‖J‖ * ‖H‖ ^ 5 := by
    rw [norm_mul, norm_mul, norm_pow, c1]
  have n2 : ‖15 / 8 * J ^ 2 * H ^ 4‖ = 15 / 8 * ‖J‖ ^ 2 * ‖H‖ ^ 4 := by
    rw [norm_mul, norm_mul, norm_pow, norm_pow, c2]
  have n3 : ‖5 / 2 * J ^ 3 * H ^ 3‖ = 5 / 2 * ‖J‖ ^ 3 * ‖H‖ ^ 3 := by
    rw [norm_mul, norm_mul, norm_pow, norm_pow, c3]
  have t1 : ‖3 / 8 * J * H ^ 5 - 15 / 8 * J ^ 2 * H ^ 4 + 5 / 2 * J ^ 3 * H ^ 3‖
      ≤ ‖3 / 8 * J * H ^ 5 - 15 / 8 * J ^ 2 * H ^ 4‖ + ‖5 / 2 * J ^ 3 * H ^ 3‖ :=
    norm_add_le _ _
  have t2 : ‖3 / 8 * J * H ^ 5 - 15 / 8 * J ^ 2 * H ^ 4‖
      ≤ ‖3 / 8 * J * H ^ 5‖ + ‖15 / 8 * J ^ 2 * H ^ 4‖ := norm_sub_le _ _
  rw [n1, n2] at t2
  rw [n3] at t1
  show ‖3 / 8 * J * H ^ 5 - 15 / 8 * J ^ 2 * H ^ 4 + 5 / 2 * J ^ 3 * H ^ 3‖
    ≤ 3 / 8 * ‖J‖ * ‖H‖ ^ 5 + 15 / 8 * ‖J‖ ^ 2 * ‖H‖ ^ 4 + 5 / 2 * ‖J‖ ^ 3 * ‖H‖ ^ 3
  linarith

theorem gpoly_bound_mono {j h a b : ℝ} (hj0 : 0 ≤ j) (hja : j ≤ a) (hh0 : 0 ≤ h) (hhb : h ≤ b) :
    3 / 8 * j * h ^ 5 + 15 / 8 * j ^ 2 * h ^ 4 + 5 / 2 * j ^ 3 * h ^ 3
      ≤ 3 / 8 * a * b ^ 5 + 15 / 8 * a ^ 2 * b ^ 4 + 5 / 2 * a ^ 3 * b ^ 3 := by
  have ha0 : 0 ≤ a := le_trans hj0 hja
  have a1 : j * h ^ 5 ≤ a * b ^ 5 :=
    mul_le_mul hja (pow_le_pow_left₀ hh0 hhb 5) (pow_nonneg hh0 5) ha0
  have a2 : j ^ 2 * h ^ 4 ≤ a ^ 2 * b ^ 4 :=
    mul_le_mul (pow_le_pow_left₀ hj0 hja 2) (pow_le_pow_left₀ hh0 hhb 4) (pow_nonneg hh0 4)
      (pow_nonneg ha0 2)
  have a3 : j ^ 3 * h ^ 3 ≤ a ^ 3 * b ^ 3 :=
    mul_le_mul (pow_le_pow_left₀ hj0 hja 3) (pow_le_pow_left₀ hh0 hhb 3) (pow_nonneg hh0 3)
      (pow_nonneg ha0 3)
  linarith

/-! ## `‖J₀(z)‖ ≤ I₀(Im z)` -/

/-- `‖cos w‖ ≤ cosh(Im w)`. -/
theorem norm_ccos_le (w : ℂ) : ‖Complex.cos w‖ ≤ Real.cosh w.im := by
  have h2 : 2 * Complex.cos w = Complex.exp (w * Complex.I) + Complex.exp (-w * Complex.I) :=
    Complex.two_cos w
  have n1 : ‖Complex.exp (w * Complex.I)‖ = Real.exp (-w.im) := by
    rw [Complex.norm_exp, Complex.mul_I_re]
  have n2 : ‖Complex.exp (-w * Complex.I)‖ = Real.exp w.im := by
    rw [Complex.norm_exp, Complex.mul_I_re, Complex.neg_im, neg_neg]
  have h3 : ‖2 * Complex.cos w‖
      ≤ ‖Complex.exp (w * Complex.I)‖ + ‖Complex.exp (-w * Complex.I)‖ := by
    rw [h2]
    exact norm_add_le _ _
  have h4 : ‖2 * Complex.cos w‖ = 2 * ‖Complex.cos w‖ := by
    rw [norm_mul, Complex.norm_two]
  have h5 : Real.cosh w.im = (Real.exp w.im + Real.exp (-w.im)) / 2 := Real.cosh_eq w.im
  rw [n1, n2, h4] at h3
  rw [h5]
  linarith

/-- `∫₀^{π/2} cosh(y sin t) dt = (π/2) I₀(y)` for real `y`. -/
theorem integral_cosh_mul_sin_eq (y : ℝ) :
    (∫ t in (0 : ℝ)..(π / 2), Real.cosh (y * Real.sin t)) = π / 2 * besselI0 y := by
  have hfun : (fun t : ℝ => Complex.cos (Complex.I * (y : ℂ) * (Real.sin t : ℂ)))
      = fun t : ℝ => ((Real.cosh (y * Real.sin t) : ℝ) : ℂ) := by
    funext t
    show Complex.cos (Complex.I * (y : ℂ) * (Real.sin t : ℂ))
      = ((Real.cosh (y * Real.sin t) : ℝ) : ℂ)
    have e : Complex.I * (y : ℂ) * (Real.sin t : ℂ)
        = ((y * Real.sin t : ℝ) : ℂ) * Complex.I := by
      rw [Complex.ofReal_mul]
      ring
    rw [e, Complex.cos_mul_I, Complex.ofReal_cosh]
  have h1 : cJ0 (Complex.I * (y : ℂ))
      = 2 / (π : ℂ) * ∫ t in (0 : ℝ)..(π / 2),
          Complex.cos (Complex.I * (y : ℂ) * (Real.sin t : ℂ)) :=
    cJ0_eq_integral (Complex.I * (y : ℂ))
  have h2 : (∫ t in (0 : ℝ)..(π / 2), ((Real.cosh (y * Real.sin t) : ℝ) : ℂ))
      = (((∫ t in (0 : ℝ)..(π / 2), Real.cosh (y * Real.sin t)) : ℝ) : ℂ) :=
    intervalIntegral.integral_ofReal
  rw [hfun, h2, cJ0_I_mul] at h1
  have h3 : ((2 / π * ∫ t in (0 : ℝ)..(π / 2), Real.cosh (y * Real.sin t) : ℝ) : ℂ)
      = 2 / (π : ℂ) * (((∫ t in (0 : ℝ)..(π / 2), Real.cosh (y * Real.sin t)) : ℝ) : ℂ) := by
    rw [Complex.ofReal_mul, Complex.ofReal_div, Complex.ofReal_ofNat]
  have h4 : besselI0 y = 2 / π * ∫ t in (0 : ℝ)..(π / 2), Real.cosh (y * Real.sin t) :=
    Complex.ofReal_injective (h1.trans h3.symm)
  have hpi : π * π⁻¹ = 1 := mul_inv_cancel₀ Real.pi_ne_zero
  linear_combination (-(π / 2)) * h4
    - (∫ t in (0 : ℝ)..(π / 2), Real.cosh (y * Real.sin t)) * hpi

/-- **`‖J₀(z)‖ ≤ I₀(Im z)`.** -/
theorem norm_cJ0_le_besselI0 (z : ℂ) : ‖cJ0 z‖ ≤ besselI0 z.im := by
  have hpt : ∀ t : ℝ,
      ‖Complex.cos (z * (Real.sin t : ℂ))‖ ≤ Real.cosh (z.im * Real.sin t) := by
    intro t
    have h := norm_ccos_le (z * (Real.sin t : ℂ))
    rw [Complex.im_mul_ofReal] at h
    exact h
  have hin : Continuous (fun t : ℝ => z.im * Real.sin t) :=
    continuous_const.mul Real.continuous_sin
  have hcont : Continuous (fun t : ℝ => Real.cosh (z.im * Real.sin t)) :=
    Real.continuous_cosh.comp hin
  have h1 : ‖∫ t in (0 : ℝ)..(π / 2), Complex.cos (z * (Real.sin t : ℂ))‖
      ≤ ∫ t in (0 : ℝ)..(π / 2), Real.cosh (z.im * Real.sin t) :=
    intervalIntegral.norm_integral_le_of_norm_le Real.pi_div_two_pos.le
      (Filter.Eventually.of_forall (fun t _ => hpt t)) (hcont.intervalIntegrable 0 (π / 2))
  rw [integral_cosh_mul_sin_eq z.im] at h1
  have h2pi : (0 : ℝ) < 2 / π := div_pos two_pos Real.pi_pos
  have hn : ‖(2 / (π : ℂ))‖ = 2 / π := by
    have e1 : 2 / (π : ℂ) = ((2 / π : ℝ) : ℂ) := by
      rw [Complex.ofReal_div, Complex.ofReal_ofNat]
    rw [e1, Complex.norm_real, Real.norm_eq_abs, abs_of_pos h2pi]
  have h3 := mul_le_mul_of_nonneg_left h1 h2pi.le
  have hpi : π * π⁻¹ = 1 := mul_inv_cancel₀ Real.pi_ne_zero
  have e : 2 / π * (π / 2 * besselI0 z.im) = besselI0 z.im := by
    linear_combination (besselI0 z.im) * hpi
  rw [e] at h3
  rw [cJ0_eq_integral, norm_mul, hn]
  exact h3

/-! ## The majorant on the sides -/

/-- `(3/8) I₀ ((2/π) K₀)⁵ + (15/8) I₀² ((2/π) K₀)⁴ + (5/2) I₀³ ((2/π) K₀)³` at `v`. -/
noncomputable def sidePhi (v : ℝ) : ℝ :=
  3 / 8 * besselI0 v * (2 / π * besselK0 v) ^ 5
    + 15 / 8 * besselI0 v ^ 2 * (2 / π * besselK0 v) ^ 4
    + 5 / 2 * besselI0 v ^ 3 * (2 / π * besselK0 v) ^ 3

/-- **`‖G(J₀(z), hK z)‖ ≤ sidePhi (Im z)`.** -/
theorem norm_gpoly_cJ0_hK_le (z : ℂ) : ‖gpoly (cJ0 z) (hK z)‖ ≤ sidePhi z.im := by
  have h1 := norm_gpoly_le (cJ0 z) (hK z)
  have h2 := gpoly_bound_mono (norm_nonneg (cJ0 z)) (norm_cJ0_le_besselI0 z)
    (norm_nonneg (hK z)) (norm_hK_le z)
  show ‖gpoly (cJ0 z) (hK z)‖
    ≤ 3 / 8 * besselI0 z.im * (2 / π * besselK0 z.im) ^ 5
      + 15 / 8 * besselI0 z.im ^ 2 * (2 / π * besselK0 z.im) ^ 4
      + 5 / 2 * besselI0 z.im ^ 3 * (2 / π * besselK0 z.im) ^ 3
  exact le_trans h1 h2

/-- If `I₀^a K₀^b (e^u) ≤ B e^{-3u}` for `u > 0`, then for `0 < δ ≤ 3` there is `C` with
`I₀^a K₀^b (e^u) ≤ C e^{-δu}` for every real `u`. -/
theorem exists_besselIK_exp_le (a b : ℕ) {B : ℝ} (hB : 0 ≤ B)
    (hlarge : ∀ u : ℝ, 0 < u → |besselI0 (Real.exp u) ^ a * besselK0 (Real.exp u) ^ b| ≤ B * Real.exp (-3 * u))
    {δ : ℝ} (hδ : 0 < δ) (hδ3 : δ ≤ 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : ℝ, besselI0 (Real.exp u) ^ a * besselK0 (Real.exp u) ^ b ≤ C * Real.exp (-δ * u) := by
  have hA : 0 ≤ Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ)) := by
    have h1 : (0 : ℝ) ≤ Real.exp 1 ^ a := pow_nonneg (Real.exp_pos 1).le a
    have h2 : (0 : ℝ) ≤ (b.factorial : ℝ) := Nat.cast_nonneg _
    have h3 : (0 : ℝ) ≤ (1 / δ) ^ b := pow_nonneg (one_div_nonneg.mpr hδ.le) b
    have h4 : (0 : ℝ) ≤ Real.exp (2 * δ) := (Real.exp_pos _).le
    exact mul_nonneg h1 (mul_nonneg (mul_nonneg h2 h3) h4)
  refine ⟨Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ)) + B, add_nonneg hA hB, fun u => ?_⟩
  have hEx : 0 < Real.exp (-δ * u) := Real.exp_pos _
  have h4 : besselI0 (Real.exp u) ^ a * besselK0 (Real.exp u) ^ b ≤ |besselI0 (Real.exp u) ^ a * besselK0 (Real.exp u) ^ b| := le_abs_self _
  have e : Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ) * Real.exp (-δ * u)) + B * Real.exp (-δ * u)
      = (Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ)) + B) * Real.exp (-δ * u) := by ring
  have h6 : besselI0 (Real.exp u) ^ a * besselK0 (Real.exp u) ^ b
      ≤ Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ) * Real.exp (-δ * u)) + B * Real.exp (-δ * u) := by
    rcases lt_or_ge 0 u with hu | hu
    · have h1 := hlarge u hu
      have h2 : Real.exp (-3 * u) ≤ Real.exp (-δ * u) := by
        apply Real.exp_le_exp.mpr
        have h := mul_nonneg (sub_nonneg.mpr hδ3) hu.le
        linarith
      have h3 : B * Real.exp (-3 * u) ≤ B * Real.exp (-δ * u) :=
        mul_le_mul_of_nonneg_left h2 hB
      have h5 : 0 ≤ Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ) * Real.exp (-δ * u)) := by
        have h7 := mul_nonneg hA hEx.le
        have e7 : Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ)) * Real.exp (-δ * u)
            = Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ) * Real.exp (-δ * u)) := by ring
        rw [e7] at h7
        exact h7
      linarith
    · have h1 := besselIK_exp_abs_le_small a b hu
      have h2 := two_sub_pow_le hδ b hu
      have h3 : Real.exp 1 ^ a * (2 - u) ^ b
          ≤ Real.exp 1 ^ a * ((b.factorial : ℝ) * (1 / δ) ^ b * Real.exp (2 * δ) * Real.exp (-δ * u)) :=
        mul_le_mul_of_nonneg_left h2 (pow_nonneg (Real.exp_pos 1).le a)
      have h5 : 0 ≤ B * Real.exp (-δ * u) := mul_nonneg hB hEx.le
      linarith
  rw [e] at h6
  exact h6

/-- **For `0 < δ ≤ 3` there is `C` with `sidePhi(e^u) ≤ C e^{-δu}` for every real `u`.** -/
theorem sidePhi_exp_le {δ : ℝ} (hδ : 0 < δ) (hδ3 : δ ≤ 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ u : ℝ, sidePhi (Real.exp u) ≤ C * Real.exp (-δ * u) := by
  have hκ : 0 ≤ Real.exp 1 * besselK0 1 :=
    mul_nonneg (Real.exp_pos 1).le (besselK0_nonneg 1)
  have hB15 : (0 : ℝ) ≤ 27 / 8 * (Real.exp 1 * besselK0 1) ^ 5 :=
    mul_nonneg (by norm_num) (pow_nonneg hκ 5)
  have hB24 : (0 : ℝ) ≤ 27 / 8 * (Real.exp 1 * besselK0 1) ^ 4 :=
    mul_nonneg (by norm_num) (pow_nonneg hκ 4)
  have l15 : ∀ u : ℝ, 0 < u → |besselI0 (Real.exp u) ^ 1 * besselK0 (Real.exp u) ^ 5|
      ≤ 27 / 8 * (Real.exp 1 * besselK0 1) ^ 5 * Real.exp (-3 * u) :=
    fun u hu => besselIK_exp_abs_le_large 1 2 hu
  have l24 : ∀ u : ℝ, 0 < u → |besselI0 (Real.exp u) ^ 2 * besselK0 (Real.exp u) ^ 4|
      ≤ 27 / 8 * (Real.exp 1 * besselK0 1) ^ 4 * Real.exp (-3 * u) :=
    fun u hu => besselIK_exp_abs_le_large 2 0 hu
  have l33 : ∀ u : ℝ, 0 < u → |besselI0 (Real.exp u) ^ 3 * besselK0 (Real.exp u) ^ 3| ≤ 1 * Real.exp (-3 * u) :=
    fun u _ => besselIK_cube_exp_abs_le_large u
  obtain ⟨C15, hC15, k15⟩ := exists_besselIK_exp_le 1 5 hB15 l15 hδ hδ3
  obtain ⟨C24, hC24, k24⟩ := exists_besselIK_exp_le 2 4 hB24 l24 hδ hδ3
  obtain ⟨C33, hC33, k33⟩ := exists_besselIK_exp_le 3 3 zero_le_one l33 hδ hδ3
  have hc : (0 : ℝ) ≤ 2 / π := (div_pos two_pos Real.pi_pos).le
  have hc15 : (0 : ℝ) ≤ 3 / 8 * (2 / π) ^ 5 := mul_nonneg (by norm_num) (pow_nonneg hc 5)
  have hc24 : (0 : ℝ) ≤ 15 / 8 * (2 / π) ^ 4 := mul_nonneg (by norm_num) (pow_nonneg hc 4)
  have hc33 : (0 : ℝ) ≤ 5 / 2 * (2 / π) ^ 3 := mul_nonneg (by norm_num) (pow_nonneg hc 3)
  refine ⟨3 / 8 * (2 / π) ^ 5 * C15 + 15 / 8 * (2 / π) ^ 4 * C24 + 5 / 2 * (2 / π) ^ 3 * C33,
    add_nonneg (add_nonneg (mul_nonneg hc15 hC15) (mul_nonneg hc24 hC24))
      (mul_nonneg hc33 hC33), fun u => ?_⟩
  have e1 : sidePhi (Real.exp u)
      = 3 / 8 * (2 / π) ^ 5 * (besselI0 (Real.exp u) ^ 1 * besselK0 (Real.exp u) ^ 5)
        + 15 / 8 * (2 / π) ^ 4 * (besselI0 (Real.exp u) ^ 2 * besselK0 (Real.exp u) ^ 4)
        + 5 / 2 * (2 / π) ^ 3 * (besselI0 (Real.exp u) ^ 3 * besselK0 (Real.exp u) ^ 3) := by
    show 3 / 8 * besselI0 (Real.exp u) * (2 / π * besselK0 (Real.exp u)) ^ 5
        + 15 / 8 * besselI0 (Real.exp u) ^ 2 * (2 / π * besselK0 (Real.exp u)) ^ 4
        + 5 / 2 * besselI0 (Real.exp u) ^ 3 * (2 / π * besselK0 (Real.exp u)) ^ 3
      = 3 / 8 * (2 / π) ^ 5 * (besselI0 (Real.exp u) ^ 1 * besselK0 (Real.exp u) ^ 5)
        + 15 / 8 * (2 / π) ^ 4 * (besselI0 (Real.exp u) ^ 2 * besselK0 (Real.exp u) ^ 4)
        + 5 / 2 * (2 / π) ^ 3 * (besselI0 (Real.exp u) ^ 3 * besselK0 (Real.exp u) ^ 3)
    ring
  have e2 : 3 / 8 * (2 / π) ^ 5 * (C15 * Real.exp (-δ * u))
        + 15 / 8 * (2 / π) ^ 4 * (C24 * Real.exp (-δ * u))
        + 5 / 2 * (2 / π) ^ 3 * (C33 * Real.exp (-δ * u))
      = (3 / 8 * (2 / π) ^ 5 * C15 + 15 / 8 * (2 / π) ^ 4 * C24 + 5 / 2 * (2 / π) ^ 3 * C33)
        * Real.exp (-δ * u) := by ring
  have h : 3 / 8 * (2 / π) ^ 5 * (besselI0 (Real.exp u) ^ 1 * besselK0 (Real.exp u) ^ 5)
        + 15 / 8 * (2 / π) ^ 4 * (besselI0 (Real.exp u) ^ 2 * besselK0 (Real.exp u) ^ 4)
        + 5 / 2 * (2 / π) ^ 3 * (besselI0 (Real.exp u) ^ 3 * besselK0 (Real.exp u) ^ 3)
      ≤ 3 / 8 * (2 / π) ^ 5 * (C15 * Real.exp (-δ * u))
        + 15 / 8 * (2 / π) ^ 4 * (C24 * Real.exp (-δ * u))
        + 5 / 2 * (2 / π) ^ 3 * (C33 * Real.exp (-δ * u)) :=
    add_le_add (add_le_add (mul_le_mul_of_nonneg_left (k15 u) hc15)
      (mul_le_mul_of_nonneg_left (k24 u) hc24)) (mul_le_mul_of_nonneg_left (k33 u) hc33)
  exact le_trans (le_of_eq e1) (le_trans h (le_of_eq e2))

/-- **On the sides: `sidePhi(e^U sin y) ≤ C e^{-δU} y^{-δ}` for `0 < y ≤ π/2`.** -/
theorem sidePhi_side_le {δ : ℝ} (hδ : 0 < δ) (hδ3 : δ ≤ 3) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ U y : ℝ, 0 < y → y ≤ π / 2 →
      sidePhi (Real.exp U * Real.sin y) ≤ C * Real.exp (-δ * U) * y ^ (-δ) := by
  obtain ⟨C, hC, h⟩ := sidePhi_exp_le hδ hδ3
  refine ⟨C * Real.exp (-δ * Real.log (2 / π)), mul_nonneg hC (Real.exp_pos _).le,
    fun U y hy0 hy1 => ?_⟩
  have h2pi : (0 : ℝ) < 2 / π := div_pos two_pos Real.pi_pos
  have hsin : 2 / π * y ≤ Real.sin y := Real.mul_le_sin hy0.le hy1
  have hlow : 0 < 2 / π * y := mul_pos h2pi hy0
  have hs0 : 0 < Real.sin y := lt_of_lt_of_le hlow hsin
  have h1 := h (U + Real.log (Real.sin y))
  have e1 : Real.exp (U + Real.log (Real.sin y)) = Real.exp U * Real.sin y := by
    rw [Real.exp_add, Real.exp_log hs0]
  rw [e1] at h1
  have hlog : Real.log (2 / π) + Real.log y ≤ Real.log (Real.sin y) := by
    have h2 := Real.log_le_log hlow hsin
    rw [Real.log_mul h2pi.ne' hy0.ne'] at h2
    exact h2
  have hexp : Real.exp (-δ * (U + Real.log (Real.sin y)))
      ≤ Real.exp (-δ * U + (-δ * Real.log (2 / π) + -δ * Real.log y)) := by
    apply Real.exp_le_exp.mpr
    have h3 := mul_le_mul_of_nonneg_left hlog hδ.le
    linarith
  have e2 : Real.exp (-δ * U + (-δ * Real.log (2 / π) + -δ * Real.log y))
      = Real.exp (-δ * U)
        * (Real.exp (-δ * Real.log (2 / π)) * Real.exp (-δ * Real.log y)) := by
    rw [Real.exp_add, Real.exp_add]
  have e3 : y ^ (-δ) = Real.exp (-δ * Real.log y) := by
    rw [Real.rpow_def_of_pos hy0, mul_comm (Real.log y) (-δ)]
  have h4 := mul_le_mul_of_nonneg_left hexp hC
  rw [e2] at h4
  have e4 : C * (Real.exp (-δ * U)
        * (Real.exp (-δ * Real.log (2 / π)) * Real.exp (-δ * Real.log y)))
      = C * Real.exp (-δ * Real.log (2 / π)) * Real.exp (-δ * U) * y ^ (-δ) := by
    rw [e3]
    ring
  rw [e4] at h4
  exact le_trans h1 h4

end Tower.RV6
