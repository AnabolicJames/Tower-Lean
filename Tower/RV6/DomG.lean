      - 64 * t ^ 4 * (thG1 t + 2 * thG0 t)) (Set.Ioi 0) := by
    have c0 := continuousOn_thG0
    have c1 := continuousOn_thG1
    have c2 := continuousOn_thG2
    have c3 := continuousOn_thG3
    fun_prop
  exact hc.congr (fun t ht => (hfun t ht).symm)

