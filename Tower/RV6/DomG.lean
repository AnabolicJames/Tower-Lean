/-- `16t²(θ+2)g - P₃(θ)g = -θ⁵g/(4t²)`. -/
noncomputable def gR (t : ℝ) : ℝ := 16 * t ^ 2 * ((2 : ℝ) * thG0 t + (1 : ℝ) * thG1 t) + ((-8 : ℝ) * thG0 t + (-18 : ℝ) * thG1 t + (-15 : ℝ) * thG2 t + (-5 : ℝ) * thG3 t)

/-- `θ gR`. -/
noncomputable def gR1 (t : ℝ) : ℝ := 16 * t ^ 2 * ((4 : ℝ) * thG0 t + (4 : ℝ) * thG1 t + (1 : ℝ) * thG2 t) + ((-8 : ℝ) * thG1 t + (-18 : ℝ) * thG2 t + (-15 : ℝ) * thG3 t + (-5 : ℝ) * thG4 t)

