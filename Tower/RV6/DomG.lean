/-! ## Helpers -/

theorem abs_cmul_leG {c C X B : ℝ} (hc : |c| = C) (hX : |X| ≤ B) : |c * X| ≤ C * B := by
  rw [abs_mul, hc]
  have hC : 0 ≤ C := hc ▸ abs_nonneg c
  exact mul_le_mul_of_nonneg_left hX hC

theorem abs_mul_leG {p r P R : ℝ} (hp : |p| ≤ P) (hr : |r| ≤ R) : |p * r| ≤ P * R := by
  rw [abs_mul]
  exact mul_le_mul hp hr (abs_nonneg _) ((abs_nonneg _).trans hp)

/-- `pB4 = θ pB3`. -/
noncomputable def pB4 (t : ℝ) : ℝ := 8 * t ^ 2 * (pB0 t + pB1 t) + 4 * t ^ 2 * (pB1 t + pB2 t)

/-- `pB5 = θ pB4`. -/
noncomputable def pB5 (t : ℝ) : ℝ :=
  16 * t ^ 2 * (pB0 t + pB1 t) + 16 * t ^ 2 * (pB1 t + pB2 t) + 4 * t ^ 2 * (pB2 t + pB3 t)

theorem thG0_eq_P (t : ℝ) : thG0 t = 1 * (pB0 t * pB0 t) := by
  simp only [thG0, ldG4, ldG3, ldG2, ldG1, ldG0, pB5, pB4, pB3, pB2, pB1, pB0]
  ring

