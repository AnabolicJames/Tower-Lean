/-- `(θ+2)² g`. -/
noncomputable def gQ1 (t : ℝ) : ℝ := (4 : ℝ) * thG0 t + (4 : ℝ) * thG1 t + (1 : ℝ) * thG2 t

/-- `θ (θ+2)² g`. -/
noncomputable def gQ1a (t : ℝ) : ℝ := (4 : ℝ) * thG1 t + (4 : ℝ) * thG2 t + (1 : ℝ) * thG3 t

/-- `θ² (θ+2)² g`. -/
noncomputable def gQ1b (t : ℝ) : ℝ := (4 : ℝ) * thG2 t + (4 : ℝ) * thG3 t + (1 : ℝ) * thG4 t

/-- `(θ+2)³ g`. -/
