theorem sqrt_mul_one_add_log_sq_le {t : ℝ} (ht : 0 < t) (ht1 : t ≤ 1) :
    Real.sqrt t * (Real.exp 1 * (1 + Real.log (2 / t))) ^ 2 ≤ Real.exp 1 ^ 2 * (343 * Real.sqrt 2) := by
  have h := sqrt_mul_one_add_log_cube_le ht ht1
  have hL : 1 ≤ 1 + Real.log (2 / t) := by
    have : 0 ≤ Real.log (2 / t) := Real.log_nonneg (by rw [le_div_iff₀ ht]; linarith)
    linarith
  have hs := Real.sqrt_nonneg t
  have h2 : (1 + Real.log (2 / t)) ^ 2 ≤ (1 + Real.log (2 / t)) ^ 3 := by
    have := pow_le_pow_right₀ hL (by norm_num : 2 ≤ 3)
    exact this
  have h3 : Real.sqrt t * (1 + Real.log (2 / t)) ^ 2 ≤ 343 * Real.sqrt 2 :=
    le_trans (mul_le_mul_of_nonneg_left h2 hs) h
  have e : Real.sqrt t * (Real.exp 1 * (1 + Real.log (2 / t))) ^ 2
      = Real.exp 1 ^ 2 * (Real.sqrt t * (1 + Real.log (2 / t)) ^ 2) := by ring
  rw [e]
  exact mul_le_mul_of_nonneg_left h3 (sq_nonneg _)

