    funext x
    unfold gQ1
    ring
  rw [hfun]
  refine h0.congr_deriv ?_
  have hti : t * t⁻¹ = 1 := mul_inv_cancel₀ ht.ne'
  unfold gQ1a
  linear_combination (0) * hti

