  have e : t * pB4 t = (8 : ℝ) * (t ^ 3 * (pB0 t + pB1 t)) + (4 : ℝ) * (t ^ 3 * (pB1 t + pB2 t)) := by
    unfold pB4
    ring
  rw [e]
  have b0 : |(8 : ℝ) * (t ^ 3 * (pB0 t + pB1 t))| ≤ 8 * 124 := abs_cmul_leG (by norm_num) h1
  have b1 : |(4 : ℝ) * (t ^ 3 * (pB1 t + pB2 t))| ≤ 4 * 1014 := abs_cmul_leG (by norm_num) h2
