import Mathlib
import Tower.RV6.BesselL5
import Tower.RV6.HankelDomF
import Tower.RV6.HankelIBP

/-!
# The linear relation among `hk(θᵏ f)` at fixed `x ≥ 0`

With `A_k = hk thF_k x`, `B_k = hk (t² thF_k) x`, `C_k = hk (t⁴ thF_k) x`:

* `hk_rel_a0 … hk_rel_a3`: `A_{k+2} + 4A_{k+1} + 4A_k = -x² B_k` (`hk_theta2` on the chain of `θᵏ f`);
* `hk_rel_b0`, `hk_rel_b1`: `B_{k+2} + 8B_{k+1} + 16B_k = -x² C_k` (`hk_theta2` on `t² θᵏ f`, since
  `(θ + 2)² t² = t² (θ + 4)²`);
* `hk_rel_L5`: `A₅ - 20B₃ - 60B₂ - 72B₁ - 32B₀ + 64C₁ + 128C₀ = 0` (`hk` of `L5_thF`);
* **`hk_relation_F`**: eliminating `B` and `C`,
  `(x⁴ + 20x² + 64) A₅ + (140x² + 896) A₄ + (392x² + 4864) A₃ + (560x² + 12800) A₂
    + (416x² + 16384) A₁ + (128x² + 8192) A₀ = 0`.

With `A_k = (-(ϑ + 2))ᵏ hjF` (the derivative in `x`, next) this is `-(ϑ - 2)² L₃′ hjF = 0`.
Generated by `tools/gen_hankelrelf.py`, which computes the cofactors of the last step and checks
them in exact arithmetic.
-/

namespace Tower.RV6


theorem hchain_thF0 : HChain thF0 thF1 :=
  ⟨hdom_thF0, hdom_thF1, fun _ ht => hasDerivAt_thF0 ht⟩

theorem hchain_thF1 : HChain thF1 thF2 :=
  ⟨hdom_thF1, hdom_thF2, fun _ ht => hasDerivAt_thF1 ht⟩

theorem hchain_thF2 : HChain thF2 thF3 :=
  ⟨hdom_thF2, hdom_thF3, fun _ ht => hasDerivAt_thF2 ht⟩

theorem hchain_thF3 : HChain thF3 thF4 :=
  ⟨hdom_thF3, hdom_thF4, fun _ ht => hasDerivAt_thF3 ht⟩

theorem hchain_thF4 : HChain thF4 thF5 :=
  ⟨hdom_thF4, hdom_thF5, fun _ ht => hasDerivAt_thF4 ht⟩

theorem hk_rel_a0 {x : ℝ} (hx : 0 ≤ x) :
    hk thF2 x + 4 * hk thF1 x + 4 * hk thF0 x = -(x ^ 2 * hk (fun t => t ^ 2 * thF0 t) x) := by
  have h : hk (fun t => thF2 t + 4 * thF1 t + 4 * thF0 t) x
      = -(x ^ 2 * hk (fun t => t ^ 2 * thF0 t) x) :=
    hk_theta2 hchain_thF0 hchain_thF1 hx
  rw [hk_add_cmul (hdom_add hdom_thF2 (hdom_const_mul 4 hdom_thF1)) hdom_thF0 4 hx,
    hk_add_cmul hdom_thF2 hdom_thF1 4 hx] at h
  exact h

theorem hk_rel_a1 {x : ℝ} (hx : 0 ≤ x) :
    hk thF3 x + 4 * hk thF2 x + 4 * hk thF1 x = -(x ^ 2 * hk (fun t => t ^ 2 * thF1 t) x) := by
  have h : hk (fun t => thF3 t + 4 * thF2 t + 4 * thF1 t) x
      = -(x ^ 2 * hk (fun t => t ^ 2 * thF1 t) x) :=
    hk_theta2 hchain_thF1 hchain_thF2 hx
  rw [hk_add_cmul (hdom_add hdom_thF3 (hdom_const_mul 4 hdom_thF2)) hdom_thF1 4 hx,
    hk_add_cmul hdom_thF3 hdom_thF2 4 hx] at h
  exact h

theorem hk_rel_a2 {x : ℝ} (hx : 0 ≤ x) :
    hk thF4 x + 4 * hk thF3 x + 4 * hk thF2 x = -(x ^ 2 * hk (fun t => t ^ 2 * thF2 t) x) := by
  have h : hk (fun t => thF4 t + 4 * thF3 t + 4 * thF2 t) x
      = -(x ^ 2 * hk (fun t => t ^ 2 * thF2 t) x) :=
    hk_theta2 hchain_thF2 hchain_thF3 hx
  rw [hk_add_cmul (hdom_add hdom_thF4 (hdom_const_mul 4 hdom_thF3)) hdom_thF2 4 hx,
    hk_add_cmul hdom_thF4 hdom_thF3 4 hx] at h
  exact h

theorem hk_rel_a3 {x : ℝ} (hx : 0 ≤ x) :
    hk thF5 x + 4 * hk thF4 x + 4 * hk thF3 x = -(x ^ 2 * hk (fun t => t ^ 2 * thF3 t) x) := by
  have h : hk (fun t => thF5 t + 4 * thF4 t + 4 * thF3 t) x
      = -(x ^ 2 * hk (fun t => t ^ 2 * thF3 t) x) :=
    hk_theta2 hchain_thF3 hchain_thF4 hx
  rw [hk_add_cmul (hdom_add hdom_thF5 (hdom_const_mul 4 hdom_thF4)) hdom_thF3 4 hx,
    hk_add_cmul hdom_thF5 hdom_thF4 4 hx] at h
  exact h

theorem hk_rel_b0 {x : ℝ} (hx : 0 ≤ x) :
    hk (fun t => t ^ 2 * thF2 t) x + 8 * hk (fun t => t ^ 2 * thF1 t) x
      + 16 * hk (fun t => t ^ 2 * thF0 t) x = -(x ^ 2 * hk (fun t => t ^ 4 * thF0 t) x) := by
  have hc0 := hchain_tsq hchain_thF0
  have hc1 := hchain_tsq (hchain_add hchain_thF1 (hchain_const_mul 2 hchain_thF0))
  have h : hk (fun t => t ^ 2 * (thF2 t + 2 * thF1 t + 2 * (thF1 t + 2 * thF0 t))
        + 4 * (t ^ 2 * (thF1 t + 2 * thF0 t)) + 4 * (t ^ 2 * thF0 t)) x
      = -(x ^ 2 * hk (fun t => t ^ 2 * (t ^ 2 * thF0 t)) x) := hk_theta2 hc0 hc1 hx
  have e1 : hk (fun t => t ^ 2 * (thF2 t + 2 * thF1 t + 2 * (thF1 t + 2 * thF0 t))
        + 4 * (t ^ 2 * (thF1 t + 2 * thF0 t)) + 4 * (t ^ 2 * thF0 t)) x
      = hk (fun t => t ^ 2 * thF2 t + 8 * (t ^ 2 * thF1 t) + 16 * (t ^ 2 * thF0 t)) x :=
    hk_congr (fun t => by beta_reduce; ring) x
  have e2 : hk (fun t => t ^ 2 * (t ^ 2 * thF0 t)) x = hk (fun t => t ^ 4 * thF0 t) x :=
    hk_congr (fun t => by beta_reduce; ring) x
  rw [e1, e2, hk_add_cmul (hdom_add (hdom_pow_mul 2 hdom_thF2)
      (hdom_const_mul 8 (hdom_pow_mul 2 hdom_thF1))) (hdom_pow_mul 2 hdom_thF0) 16 hx,
    hk_add_cmul (hdom_pow_mul 2 hdom_thF2) (hdom_pow_mul 2 hdom_thF1) 8 hx] at h
  exact h

theorem hk_rel_b1 {x : ℝ} (hx : 0 ≤ x) :
    hk (fun t => t ^ 2 * thF3 t) x + 8 * hk (fun t => t ^ 2 * thF2 t) x
      + 16 * hk (fun t => t ^ 2 * thF1 t) x = -(x ^ 2 * hk (fun t => t ^ 4 * thF1 t) x) := by
  have hc0 := hchain_tsq hchain_thF1
  have hc1 := hchain_tsq (hchain_add hchain_thF2 (hchain_const_mul 2 hchain_thF1))
  have h : hk (fun t => t ^ 2 * (thF3 t + 2 * thF2 t + 2 * (thF2 t + 2 * thF1 t))
        + 4 * (t ^ 2 * (thF2 t + 2 * thF1 t)) + 4 * (t ^ 2 * thF1 t)) x
      = -(x ^ 2 * hk (fun t => t ^ 2 * (t ^ 2 * thF1 t)) x) := hk_theta2 hc0 hc1 hx
  have e1 : hk (fun t => t ^ 2 * (thF3 t + 2 * thF2 t + 2 * (thF2 t + 2 * thF1 t))
        + 4 * (t ^ 2 * (thF2 t + 2 * thF1 t)) + 4 * (t ^ 2 * thF1 t)) x
      = hk (fun t => t ^ 2 * thF3 t + 8 * (t ^ 2 * thF2 t) + 16 * (t ^ 2 * thF1 t)) x :=
    hk_congr (fun t => by beta_reduce; ring) x
  have e2 : hk (fun t => t ^ 2 * (t ^ 2 * thF1 t)) x = hk (fun t => t ^ 4 * thF1 t) x :=
    hk_congr (fun t => by beta_reduce; ring) x
  rw [e1, e2, hk_add_cmul (hdom_add (hdom_pow_mul 2 hdom_thF3)
      (hdom_const_mul 8 (hdom_pow_mul 2 hdom_thF2))) (hdom_pow_mul 2 hdom_thF1) 16 hx,
    hk_add_cmul (hdom_pow_mul 2 hdom_thF3) (hdom_pow_mul 2 hdom_thF2) 8 hx] at h
  exact h

theorem hk_rel_L5 {x : ℝ} (hx : 0 ≤ x) :
    hk thF5 x
      + (-20) * hk (fun t => t ^ 2 * thF3 t) x
      + (-60) * hk (fun t => t ^ 2 * thF2 t) x
      + (-72) * hk (fun t => t ^ 2 * thF1 t) x
      + (-32) * hk (fun t => t ^ 2 * thF0 t) x
      + 64 * hk (fun t => t ^ 4 * thF1 t) x
      + 128 * hk (fun t => t ^ 4 * thF0 t) x = 0 := by
  have h0 : hk (fun t => thF5 t + (-20) * (t ^ 2 * thF3 t) + (-60) * (t ^ 2 * thF2 t) + (-72) * (t ^ 2 * thF1 t) + (-32) * (t ^ 2 * thF0 t) + 64 * (t ^ 4 * thF1 t) + 128 * (t ^ 4 * thF0 t)) x
      = hk (fun _ => 0) x := hk_congr (fun t => by beta_reduce; linear_combination L5_thF t) x
  rw [hk_zero] at h0
  rw [hk_add_cmul (hdom_add (hdom_add (hdom_add (hdom_add (hdom_add hdom_thF5 (hdom_const_mul (-20) (hdom_pow_mul 2 hdom_thF3))) (hdom_const_mul (-60) (hdom_pow_mul 2 hdom_thF2))) (hdom_const_mul (-72) (hdom_pow_mul 2 hdom_thF1))) (hdom_const_mul (-32) (hdom_pow_mul 2 hdom_thF0))) (hdom_const_mul (64) (hdom_pow_mul 4 hdom_thF1))) (hdom_pow_mul 4 hdom_thF0) (128) hx,
    hk_add_cmul (hdom_add (hdom_add (hdom_add (hdom_add hdom_thF5 (hdom_const_mul (-20) (hdom_pow_mul 2 hdom_thF3))) (hdom_const_mul (-60) (hdom_pow_mul 2 hdom_thF2))) (hdom_const_mul (-72) (hdom_pow_mul 2 hdom_thF1))) (hdom_const_mul (-32) (hdom_pow_mul 2 hdom_thF0))) (hdom_pow_mul 4 hdom_thF1) (64) hx,
    hk_add_cmul (hdom_add (hdom_add (hdom_add hdom_thF5 (hdom_const_mul (-20) (hdom_pow_mul 2 hdom_thF3))) (hdom_const_mul (-60) (hdom_pow_mul 2 hdom_thF2))) (hdom_const_mul (-72) (hdom_pow_mul 2 hdom_thF1))) (hdom_pow_mul 2 hdom_thF0) (-32) hx,
    hk_add_cmul (hdom_add (hdom_add hdom_thF5 (hdom_const_mul (-20) (hdom_pow_mul 2 hdom_thF3))) (hdom_const_mul (-60) (hdom_pow_mul 2 hdom_thF2))) (hdom_pow_mul 2 hdom_thF1) (-72) hx,
    hk_add_cmul (hdom_add hdom_thF5 (hdom_const_mul (-20) (hdom_pow_mul 2 hdom_thF3))) (hdom_pow_mul 2 hdom_thF2) (-60) hx,
    hk_add_cmul hdom_thF5 (hdom_pow_mul 2 hdom_thF3) (-20) hx] at h0
  exact h0

/-- **The relation among `hk(θᵏ f)`** at fixed `x ≥ 0` (`= -(ϑ - 2)² L₃′ hjF` once `ϑ` acts). -/
theorem hk_relation_F {x : ℝ} (hx : 0 ≤ x) :
    (x ^ 4 + 20 * x ^ 2 + 64) * hk thF5 x + (140 * x ^ 2 + 896) * hk thF4 x
      + (392 * x ^ 2 + 4864) * hk thF3 x + (560 * x ^ 2 + 12800) * hk thF2 x
      + (416 * x ^ 2 + 16384) * hk thF1 x + (128 * x ^ 2 + 8192) * hk thF0 x = 0 := by
  have hL := hk_rel_L5 hx
  have ha0 := hk_rel_a0 hx
  have ha1 := hk_rel_a1 hx
  have ha2 := hk_rel_a2 hx
  have ha3 := hk_rel_a3 hx
  have hb0 := hk_rel_b0 hx
  have hb1 := hk_rel_b1 hx
  linear_combination x ^ 4 * hL + (20 * x ^ 2 + 64) * ha3 + (60 * x ^ 2 + 640) * ha2
    + (72 * x ^ 2 + 2048) * ha1 + (32 * x ^ 2 + 2048) * ha0 + (-64 * x ^ 2) * hb1
    + (-128 * x ^ 2) * hb0

end Tower.RV6
