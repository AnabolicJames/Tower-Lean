import Mathlib
import Tower.RV6.HankelDeriv

/-!
# `L₃′ hjF = x² (c₁ + c₂ log x)` on `(0, ∞)`

With `A_k = hk(θᵏ f)(x)` and `ϑ A_k = -2A_k - A_{k+1}` (`hasDerivAt_hk_thF0 … 4`):

* `uF = -(x⁴ + 20x² + 64) A₃ - (60x² + 384) A₂ - (72x² + 768) A₁ - (32x² + 512) A₀`, which is `L₃′ hjF`
  (`L₃′` with `ϑ ↦ -(2 + S)`, `S A_k = A_{k+1}`);
* `wF = (ϑ - 2) uF = (x⁴ + 20x² + 64) A₄ + (100x² + 640) A₃ + (192x² + 2304) A₂ + (176x² + 3584) A₁
  + (64x² + 2048) A₀` (`uF_ode`), and `(ϑ - 2) wF = 0` (`wF_ode`, from `hk_relation_F`);
* `ode_theta_two`, `ode_theta_two_log`: `x g' = 2g` gives `g = c x²`; `x u' - 2u = c x²` gives
  `u = x² (d + c log x)`;
* **`uF_eq`**: `L₃′ hjF = x² (c₁ + c₂ log x)` on `(0, ∞)` for some constants `c₁`, `c₂`.

That `c₁ = c₂ = 0` is the next step (`x → 0+`).  Generated by `tools/gen_hankelodef.py`.
-/

namespace Tower.RV6

/-- A function with derivative `0` on `(0, ∞)` is constant there. -/
theorem eq_one_of_hasDerivAt_zero {φ : ℝ → ℝ} (hd : ∀ z : ℝ, 0 < z → HasDerivAt φ 0 z)
    {x : ℝ} (hx : 0 < x) : φ x = φ 1 := by
  rcases le_total x 1 with h | h
  · have hcont : ContinuousOn φ (Set.Icc x 1) := fun z hz =>
      (hd z (lt_of_lt_of_le hx hz.1)).continuousAt.continuousWithinAt
    have hderiv : ∀ z ∈ Set.Ico x 1, HasDerivWithinAt φ 0 (Set.Ici z) z := fun z hz =>
      (hd z (lt_of_lt_of_le hx hz.1)).hasDerivWithinAt
    exact (constant_of_has_deriv_right_zero hcont hderiv 1 ⟨h, le_rfl⟩).symm
  · have hcont : ContinuousOn φ (Set.Icc 1 x) := fun z hz =>
      (hd z (lt_of_lt_of_le one_pos hz.1)).continuousAt.continuousWithinAt
    have hderiv : ∀ z ∈ Set.Ico 1 x, HasDerivWithinAt φ 0 (Set.Ici z) z := fun z hz =>
      (hd z (lt_of_lt_of_le one_pos hz.1)).hasDerivWithinAt
    exact constant_of_has_deriv_right_zero hcont hderiv x ⟨h, le_rfl⟩

/-- `x g' - 2g = 0` on `(0, ∞)` gives `g = c x²`. -/
theorem ode_theta_two {g g' : ℝ → ℝ} (hg : ∀ x : ℝ, 0 < x → HasDerivAt g (g' x) x)
    (h : ∀ x : ℝ, 0 < x → x * g' x - 2 * g x = 0) :
    ∃ c : ℝ, ∀ x : ℝ, 0 < x → g x = c * x ^ 2 := by
  have hd : ∀ z : ℝ, 0 < z → HasDerivAt (fun y : ℝ => g y / y ^ 2) 0 z := by
    intro z hz
    have h0 := (hg z hz).div (hasDerivAt_sqx z) (pow_ne_zero 2 hz.ne')
    have h1 : HasDerivAt (fun y : ℝ => g y / y ^ 2)
        ((g' z * z ^ 2 - g z * (2 * z)) / (z ^ 2) ^ 2) z := h0
    refine h1.congr_deriv ?_
    have hn : g' z * z ^ 2 - g z * (2 * z) = 0 := by linear_combination z * h z hz
    rw [hn, zero_div]
  refine ⟨g 1 / 1 ^ 2, fun x hx => ?_⟩
  have e := eq_one_of_hasDerivAt_zero hd hx
  have e' : g x / x ^ 2 = g 1 / 1 ^ 2 := e
  rw [div_eq_iff (pow_ne_zero 2 hx.ne')] at e'
  exact e'

/-- `x u' - 2u = c x²` on `(0, ∞)` gives `u = x² (d + c log x)`. -/
theorem ode_theta_two_log {u u' : ℝ → ℝ} {c : ℝ} (hu : ∀ x : ℝ, 0 < x → HasDerivAt u (u' x) x)
    (h : ∀ x : ℝ, 0 < x → x * u' x - 2 * u x = c * x ^ 2) :
    ∃ d : ℝ, ∀ x : ℝ, 0 < x → u x = x ^ 2 * (d + c * Real.log x) := by
  have hd : ∀ z : ℝ, 0 < z →
      HasDerivAt (fun y : ℝ => u y / y ^ 2 - c * Real.log y) 0 z := by
    intro z hz
    have h0 := ((hu z hz).div (hasDerivAt_sqx z) (pow_ne_zero 2 hz.ne')).sub
      ((Real.hasDerivAt_log hz.ne').const_mul c)
    have h1 : HasDerivAt (fun y : ℝ => u y / y ^ 2 - c * Real.log y)
        ((u' z * z ^ 2 - u z * (2 * z)) / (z ^ 2) ^ 2 - c * z⁻¹) z := h0
    refine h1.congr_deriv ?_
    have hn : u' z * z ^ 2 - u z * (2 * z) = c * z ^ 3 := by linear_combination z * h z hz
    have hinv : z * z⁻¹ = 1 := mul_inv_cancel₀ hz.ne'
    have e : c * z ^ 3 / (z ^ 2) ^ 2 = c * z⁻¹ := by
      rw [div_eq_iff (pow_ne_zero 2 (pow_ne_zero 2 hz.ne'))]
      linear_combination (-(c * z ^ 3)) * hinv
    rw [hn, e, sub_self]
  refine ⟨u 1 / 1 ^ 2 - c * Real.log 1, fun x hx => ?_⟩
  have e := eq_one_of_hasDerivAt_zero hd hx
  have e' : u x / x ^ 2 - c * Real.log x = u 1 / 1 ^ 2 - c * Real.log 1 := e
  have e2 : u x / x ^ 2 = u 1 / 1 ^ 2 - c * Real.log 1 + c * Real.log x := by linarith
  rw [div_eq_iff (pow_ne_zero 2 hx.ne')] at e2
  rw [e2]
  ring

theorem hasDerivAt_quart (a b c x : ℝ) :
    HasDerivAt (fun y : ℝ => a * y ^ 4 + b * y ^ 2 + c) (a * (4 * x ^ 3) + b * (2 * x)) x := by
  have h := (((hasDerivAt_powfour x).const_mul a).add ((hasDerivAt_sqx x).const_mul b)).add_const c
  have h' : HasDerivAt (fun y : ℝ => a * y ^ 4 + b * y ^ 2 + c)
      (a * (4 * x ^ 3) + b * (2 * x)) x := h
  exact h'


/-- `L₃′ hjF` in terms of `A_k = hk(θᵏ f)`. -/
noncomputable def uF (x : ℝ) : ℝ :=
  ((-1) * x ^ 4 + (-20) * x ^ 2 + (-64)) * hk thF3 x +
    (0 * x ^ 4 + (-60) * x ^ 2 + (-384)) * hk thF2 x +
    (0 * x ^ 4 + (-72) * x ^ 2 + (-768)) * hk thF1 x +
    (0 * x ^ 4 + (-32) * x ^ 2 + (-512)) * hk thF0 x

noncomputable def duF (x : ℝ) : ℝ :=
  ((-1) * (4 * x ^ 3) + (-20) * (2 * x)) * hk thF3 x + ((-1) * x ^ 4 + (-20) * x ^ 2 + (-64)) * (-(2 * hk thF3 x + hk thF4 x) / x) +
    ((0 * (4 * x ^ 3) + (-60) * (2 * x)) * hk thF2 x + (0 * x ^ 4 + (-60) * x ^ 2 + (-384)) * (-(2 * hk thF2 x + hk thF3 x) / x)) +
    ((0 * (4 * x ^ 3) + (-72) * (2 * x)) * hk thF1 x + (0 * x ^ 4 + (-72) * x ^ 2 + (-768)) * (-(2 * hk thF1 x + hk thF2 x) / x)) +
    ((0 * (4 * x ^ 3) + (-32) * (2 * x)) * hk thF0 x + (0 * x ^ 4 + (-32) * x ^ 2 + (-512)) * (-(2 * hk thF0 x + hk thF1 x) / x))

theorem hasDerivAt_uF {x : ℝ} (hx : 0 < x) : HasDerivAt uF (duF x) x := by
  have m1 := (hasDerivAt_quart (-1) (-20) (-64) x).mul (hasDerivAt_hk_thF3 hx)
  have m2 := (hasDerivAt_quart (0) (-60) (-384) x).mul (hasDerivAt_hk_thF2 hx)
  have m3 := (hasDerivAt_quart (0) (-72) (-768) x).mul (hasDerivAt_hk_thF1 hx)
  have m4 := (hasDerivAt_quart (0) (-32) (-512) x).mul (hasDerivAt_hk_thF0 hx)
  have h := ((m1.add m2).add m3).add m4
  have hfun : uF = fun y : ℝ =>
      ((-1) * y ^ 4 + (-20) * y ^ 2 + (-64)) * hk thF3 y +
        (0 * y ^ 4 + (-60) * y ^ 2 + (-384)) * hk thF2 y +
        (0 * y ^ 4 + (-72) * y ^ 2 + (-768)) * hk thF1 y +
        (0 * y ^ 4 + (-32) * y ^ 2 + (-512)) * hk thF0 y := rfl
  rw [hfun]
  exact h

/-- `(ϑ - 2) L₃′ hjF` in terms of `A_k`. -/
noncomputable def wF (x : ℝ) : ℝ :=
  (1 * x ^ 4 + 20 * x ^ 2 + 64) * hk thF4 x +
    (0 * x ^ 4 + 100 * x ^ 2 + 640) * hk thF3 x +
    (0 * x ^ 4 + 192 * x ^ 2 + 2304) * hk thF2 x +
    (0 * x ^ 4 + 176 * x ^ 2 + 3584) * hk thF1 x +
    (0 * x ^ 4 + 64 * x ^ 2 + 2048) * hk thF0 x

noncomputable def dwF (x : ℝ) : ℝ :=
  (1 * (4 * x ^ 3) + 20 * (2 * x)) * hk thF4 x + (1 * x ^ 4 + 20 * x ^ 2 + 64) * (-(2 * hk thF4 x + hk thF5 x) / x) +
    ((0 * (4 * x ^ 3) + 100 * (2 * x)) * hk thF3 x + (0 * x ^ 4 + 100 * x ^ 2 + 640) * (-(2 * hk thF3 x + hk thF4 x) / x)) +
    ((0 * (4 * x ^ 3) + 192 * (2 * x)) * hk thF2 x + (0 * x ^ 4 + 192 * x ^ 2 + 2304) * (-(2 * hk thF2 x + hk thF3 x) / x)) +
    ((0 * (4 * x ^ 3) + 176 * (2 * x)) * hk thF1 x + (0 * x ^ 4 + 176 * x ^ 2 + 3584) * (-(2 * hk thF1 x + hk thF2 x) / x)) +
    ((0 * (4 * x ^ 3) + 64 * (2 * x)) * hk thF0 x + (0 * x ^ 4 + 64 * x ^ 2 + 2048) * (-(2 * hk thF0 x + hk thF1 x) / x))

theorem hasDerivAt_wF {x : ℝ} (hx : 0 < x) : HasDerivAt wF (dwF x) x := by
  have m1 := (hasDerivAt_quart (1) (20) (64) x).mul (hasDerivAt_hk_thF4 hx)
  have m2 := (hasDerivAt_quart (0) (100) (640) x).mul (hasDerivAt_hk_thF3 hx)
  have m3 := (hasDerivAt_quart (0) (192) (2304) x).mul (hasDerivAt_hk_thF2 hx)
  have m4 := (hasDerivAt_quart (0) (176) (3584) x).mul (hasDerivAt_hk_thF1 hx)
  have m5 := (hasDerivAt_quart (0) (64) (2048) x).mul (hasDerivAt_hk_thF0 hx)
  have h := (((m1.add m2).add m3).add m4).add m5
  have hfun : wF = fun y : ℝ =>
      (1 * y ^ 4 + 20 * y ^ 2 + 64) * hk thF4 y +
        (0 * y ^ 4 + 100 * y ^ 2 + 640) * hk thF3 y +
        (0 * y ^ 4 + 192 * y ^ 2 + 2304) * hk thF2 y +
        (0 * y ^ 4 + 176 * y ^ 2 + 3584) * hk thF1 y +
        (0 * y ^ 4 + 64 * y ^ 2 + 2048) * hk thF0 y := rfl
  rw [hfun]
  exact h

/-- `(ϑ - 2) uF = wF`: `x uF' - 2 uF = wF`. -/
theorem uF_ode {x : ℝ} (hx : 0 < x) : x * duF x - 2 * uF x = wF x := by
  have hinv : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  unfold duF uF wF
  linear_combination (((-1) * x ^ 4 + (-20) * x ^ 2 + (-64)) * (-(2 * hk thF3 x + hk thF4 x)) + (0 * x ^ 4 + (-60) * x ^ 2 + (-384)) * (-(2 * hk thF2 x + hk thF3 x)) + (0 * x ^ 4 + (-72) * x ^ 2 + (-768)) * (-(2 * hk thF1 x + hk thF2 x)) + (0 * x ^ 4 + (-32) * x ^ 2 + (-512)) * (-(2 * hk thF0 x + hk thF1 x))) * hinv

/-- `(ϑ - 2) wF = 0` (it is minus the relation `hk_relation_F`). -/
theorem wF_ode {x : ℝ} (hx : 0 < x) : x * dwF x - 2 * wF x = 0 := by
  have hinv : x * x⁻¹ = 1 := mul_inv_cancel₀ hx.ne'
  have hrel := hk_relation_F hx.le
  unfold dwF wF
  linear_combination (-1 : ℝ) * hrel + ((1 * x ^ 4 + 20 * x ^ 2 + 64) * (-(2 * hk thF4 x + hk thF5 x)) + (0 * x ^ 4 + 100 * x ^ 2 + 640) * (-(2 * hk thF3 x + hk thF4 x)) + (0 * x ^ 4 + 192 * x ^ 2 + 2304) * (-(2 * hk thF2 x + hk thF3 x)) + (0 * x ^ 4 + 176 * x ^ 2 + 3584) * (-(2 * hk thF1 x + hk thF2 x)) + (0 * x ^ 4 + 64 * x ^ 2 + 2048) * (-(2 * hk thF0 x + hk thF1 x))) * hinv

/-- **`L₃′ hjF = x² (c₁ + c₂ log x)`** on `(0, ∞)`. -/
theorem uF_eq : ∃ c1 c2 : ℝ, ∀ x : ℝ, 0 < x → uF x = x ^ 2 * (c1 + c2 * Real.log x) := by
  obtain ⟨c2, hc2⟩ := ode_theta_two (g := wF) (g' := dwF) (fun x hx => hasDerivAt_wF hx)
    (fun x hx => wF_ode hx)
  obtain ⟨c1, hc1⟩ := ode_theta_two_log (u := uF) (u' := duF) (c := c2)
    (fun x hx => hasDerivAt_uF hx) (fun x hx => by rw [uF_ode hx, hc2 x hx])
  exact ⟨c1, c2, hc1⟩

end Tower.RV6
