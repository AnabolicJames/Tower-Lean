  -- the whole line, and its two halves
  have hcomp : (∫ u : ℝ, (Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6)) = ∫ t in Set.Ioi (0 : ℝ), (Real.exp (-t) - besselJ0 t ^ 6) / t := integral_walk_exp
  have hsplit : (∫ u in Set.Ioi (0 : ℝ), (Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6)) + (∫ u in (Set.Ioi (0 : ℝ))ᶜ, (Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6))
      = ∫ u : ℝ, (Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6) :=
    integral_add_compl measurableSet_Ioi integrable_walk_exp
  rw [Set.compl_Ioi] at hsplit
  -- `u > 0`
  have hXfun : (fun u : ℝ => Real.exp (-(1 * Real.exp u))) = fun u : ℝ => Real.exp (-Real.exp u) := by
    funext u
    show Real.exp (-(1 * Real.exp u)) = Real.exp (-Real.exp u)
    rw [one_mul]
  have hX : Integrable (fun u : ℝ => Real.exp (-Real.exp u)) (volume.restrict (Set.Ioi (0 : ℝ))) := by
    rw [← hXfun]
    exact integrable_expE one_pos
  have hE1 : expE 1 = ∫ u in Set.Ioi (0 : ℝ), Real.exp (-Real.exp u) := by
    show (∫ u in Set.Ioi (0 : ℝ), Real.exp (-(1 * Real.exp u))) = ∫ u in Set.Ioi (0 : ℝ), Real.exp (-Real.exp u)
    rw [hXfun]
  have hU : (∫ u in Set.Ioi (0 : ℝ), (Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6))
      = (∫ u in Set.Ioi (0 : ℝ), Real.exp (-Real.exp u)) - ∫ u in Set.Ioi (0 : ℝ), besselJ0 (Real.exp u) ^ 6 :=
    integral_sub hX integrableOn_besselJ0_pow_six_Ioi
  -- `u ≤ 0`
  have hAdd : (∫ u in Set.Iic (0 : ℝ), ((besselJ0 (Real.exp u) ^ 6 - 1) + (1 - Real.exp (-Real.exp u))))
      = (∫ u in Set.Iic (0 : ℝ), (besselJ0 (Real.exp u) ^ 6 - 1)) + ∫ u in Set.Iic (0 : ℝ), (1 - Real.exp (-Real.exp u)) :=
    integral_add integrableOn_besselJ0_pow_six_sub_one_Iic integrableOn_one_sub_exp_neg_exp_Iic
  have hLfun : (fun u : ℝ => Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6) = fun u : ℝ => -((besselJ0 (Real.exp u) ^ 6 - 1) + (1 - Real.exp (-Real.exp u))) := by
    funext u
    show Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6 = -((besselJ0 (Real.exp u) ^ 6 - 1) + (1 - Real.exp (-Real.exp u)))
    ring
  have hneg : (∫ u in Set.Iic (0 : ℝ), -((besselJ0 (Real.exp u) ^ 6 - 1) + (1 - Real.exp (-Real.exp u))))
      = -∫ u in Set.Iic (0 : ℝ), ((besselJ0 (Real.exp u) ^ 6 - 1) + (1 - Real.exp (-Real.exp u))) :=
    integral_neg (fun u : ℝ => (besselJ0 (Real.exp u) ^ 6 - 1) + (1 - Real.exp (-Real.exp u)))
  have hL : (∫ u in Set.Iic (0 : ℝ), (Real.exp (-Real.exp u) - besselJ0 (Real.exp u) ^ 6))
      = -((∫ u in Set.Iic (0 : ℝ), (besselJ0 (Real.exp u) ^ 6 - 1)) + ∫ u in Set.Iic (0 : ℝ), (1 - Real.exp (-Real.exp u))) := by
    rw [hLfun, hneg, hAdd]
  -- the change of variables `w = e^u` on `u ≤ 0`
  have hPsi : (∫ u in Set.Iic (0 : ℝ), (1 - Real.exp (-Real.exp u))) = ∫ w in (0 : ℝ)..1, psiE w :=
    integral_one_sub_exp_neg_exp_Iic
  linear_combination hW - hEW - hcomp - hsplit - hE1 + hU + hL - hPsi

/-! ## The sub-rung -/

/-- **Sub-rung A2N.** `N(s) - 1/s → eulerW - (walkSide - log 2)` as `s → 0+`. -/
theorem rungA2N : RungA2N := by
  unfold RungA2N
  have hmem : Set.Ioo (0 : ℝ) 3 ∈ nhdsWithin (0 : ℝ) (Set.Ioi 0) :=
    Ioo_mem_nhdsGT (by norm_num : (0 : ℝ) < 3)
  have hev : Filter.EventuallyEq (nhdsWithin (0 : ℝ) (Set.Ioi 0))
      (fun s : ℝ => (∫ u in Set.Iic (0 : ℝ), (besselJ0 (Real.exp u) ^ 6 - 1) * Real.exp (s * u))
        + ∫ u in Set.Ioi (0 : ℝ), besselJ0 (Real.exp u) ^ 6 * Real.exp (s * u))
      (fun s : ℝ => mellN s - 1 / s) := by
    filter_upwards [hmem] with s hs
    exact (mellN_sub_inv_eq hs.1 hs.2).symm
  have hsum : Filter.Tendsto
      (fun s : ℝ => (∫ u in Set.Iic (0 : ℝ), (besselJ0 (Real.exp u) ^ 6 - 1) * Real.exp (s * u))
        + ∫ u in Set.Ioi (0 : ℝ), besselJ0 (Real.exp u) ^ 6 * Real.exp (s * u))
      (nhdsWithin (0 : ℝ) (Set.Ioi 0))
      (nhds ((∫ u in Set.Iic (0 : ℝ), (besselJ0 (Real.exp u) ^ 6 - 1)) + (∫ u in Set.Ioi (0 : ℝ), besselJ0 (Real.exp u) ^ 6))) :=
    tendsto_integral_Iic_besselJ0.add tendsto_integral_Ioi_besselJ0
  rw [walk_AB_eq] at hsum
  exact Filter.Tendsto.congr' hev hsum

/-- **The six-step theorem from sub-rung A2R and Rung B.** -/
theorem rv6_of_A2R_B (hR : RungA2R) (hB : RungB) : mu6 = 648 / π ^ 6 * Lf5 :=
  rv6_of_A2RN_B hR rungA2N hB

end Tower.RV6
