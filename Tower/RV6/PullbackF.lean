/-- `A₀ / Z`. -/
noncomputable def hF0 (y : ℝ) : ℝ := hk thF0 (xm y) * (Zax y)⁻¹

/-- `D (A₀ / Z)`. -/
noncomputable def hF1 (y : ℝ) : ℝ :=
  ((2 : ℝ) * π) * (hk thF0 (xm y) * Eax y * (Zax y)⁻¹) +
    ((1 / 2 : ℝ) * π) * (hk thF0 (xm y) * Pax y * (Zax y)⁻¹) +
    ((1 / 4 : ℝ) * π) * (hk thF1 (xm y) * Pax y * (Zax y)⁻¹)

/-- `D² (A₀ / Z)`. -/
noncomputable def hF2 (y : ℝ) : ℝ :=
  ((2 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Eax y * Eax y * (Zax y)⁻¹) +
    ((1 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Pax y * Eax y * (Zax y)⁻¹) +
    ((1 / 4 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Pax y * Pax y * (Zax y)⁻¹) +
    ((-24 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Uax y) +
    ((-128 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Uax y * Uax y * (Zax y)⁻¹) +
    ((1 / 2 : ℝ) * π ^ 2) * (hk thF1 (xm y) * Pax y * Eax y * (Zax y)⁻¹) +
    ((1 / 4 : ℝ) * π ^ 2) * (hk thF1 (xm y) * Pax y * Pax y * (Zax y)⁻¹) +
    ((-20 : ℝ) * π ^ 2) * (hk thF1 (xm y) * Uax y) +
    ((-128 : ℝ) * π ^ 2) * (hk thF1 (xm y) * Uax y * Uax y * (Zax y)⁻¹) +
    ((1 / 16 : ℝ) * π ^ 2) * (hk thF2 (xm y) * Pax y * Pax y * (Zax y)⁻¹)

theorem hasDerivAt_hF0 {y : ℝ} (hy : 0 < y) : HasDerivAt hF0 (hF1 y) y := by
  have hinv : Zax y * (Zax y)⁻¹ = 1 := mul_inv_cancel₀ (Zax_pos hy).ne'
  have dA0 := hasDerivAt_hkxm_thF0 hy
  have dW := (hasDerivAt_Zax hy).inv (Zax_pos hy).ne'
  have h := dA0.mul dW
  exact h.congr_deriv (by
    unfold hF1
    linear_combination (((2 : ℝ) * π) * (hk thF0 (xm y) * Eax y * (Zax y)⁻¹)) * hinv)

theorem hasDerivAt_hF1 {y : ℝ} (hy : 0 < y) : HasDerivAt hF1 (hF2 y) y := by
  have hinv : Zax y * (Zax y)⁻¹ = 1 := mul_inv_cancel₀ (Zax_pos hy).ne'
  have dA0 := hasDerivAt_hkxm_thF0 hy
  have dA1 := hasDerivAt_hkxm_thF1 hy
  have dP := hasDerivAt_Pax hy
  have dE := hasDerivAt_Eax hy
  have dW := (hasDerivAt_Zax hy).inv (Zax_pos hy).ne'
  have m1 := ((dA0.mul dE).mul dW).const_mul ((2 : ℝ) * π)
  have m2 := ((dA0.mul dP).mul dW).const_mul ((1 / 2 : ℝ) * π)
  have m3 := ((dA1.mul dP).mul dW).const_mul ((1 / 4 : ℝ) * π)
  have h := (m1.add m2).add m3
  exact h.congr_deriv (by
    unfold hF2
    simp only [Pi.mul_apply, Pi.inv_apply]
    linear_combination (((4 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Eax y * Eax y * (Zax y)⁻¹) + ((1 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Pax y * Eax y * (Zax y)⁻¹) + ((-24 : ℝ) * π ^ 2) * (hk thF0 (xm y) * Uax y) + ((1 / 2 : ℝ) * π ^ 2) * (hk thF1 (xm y) * Pax y * Eax y * (Zax y)⁻¹) + ((-20 : ℝ) * π ^ 2) * (hk thF1 (xm y) * Uax y)) * hinv)

/-- **`D³ (A₀ / Z) = -(π³/256) P Z uF(x)`**. -/
