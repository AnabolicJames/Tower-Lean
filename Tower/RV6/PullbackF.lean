  have m7 := (((dA1.mul dP).mul dP).mul dW).const_mul ((1 / 4 : ℝ) * π ^ 2)
  have m8 := (dA1.mul dU).const_mul ((-20 : ℝ) * π ^ 2)
  have m9 := (((dA1.mul dU).mul dU).mul dW).const_mul ((-128 : ℝ) * π ^ 2)
  have m10 := (((dA2.mul dP).mul dP).mul dW).const_mul ((1 / 16 : ℝ) * π ^ 2)
  have h := ((((((((m1.add m2).add m3).add m4).add m5).add m6).add m7).add m8).add m9).add m10
  exact h.congr_deriv (by
    unfold uF
    simp only [Pi.mul_apply, Pi.inv_apply]
    linear_combination (((4 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Eax y * Eax y * Eax y * (Zax y)⁻¹) + ((-48 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Eax y * Uax y) + ((256 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Eax y * Uax y * Uax y * (Zax y)⁻¹) + ((2 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Pax y * Eax y * Eax y * (Zax y)⁻¹) + ((2 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Pax y * Zax y) + ((160 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Zax y * Eax y * Uax y * (Zax y)⁻¹) + ((8 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Zax y * Zax y * Eax y * (Zax y)⁻¹) + ((-40 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Eax y * Uax y) + ((256 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Eax y * Uax y * Uax y * (Zax y)⁻¹) + ((1 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Pax y * Eax y * Eax y * (Zax y)⁻¹) + ((6 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Pax y * Uax y) + ((3 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Pax y * Zax y) + ((160 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Zax y * Eax y * Uax y * (Zax y)⁻¹) + ((8 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Zax y * Zax y * Eax y * (Zax y)⁻¹) + ((128 : ℝ) * π ^ 3) * (hk thF2 (xm y) * Eax y * Uax y * Uax y * (Zax y)⁻¹) + ((5 : ℝ) * π ^ 3) * (hk thF2 (xm y) * Pax y * Uax y) + ((3 / 2 : ℝ) * π ^ 3) * (hk thF2 (xm y) * Pax y * Zax y) + ((40 : ℝ) * π ^ 3) * (hk thF2 (xm y) * Zax y * Eax y * Uax y * (Zax y)⁻¹) + ((2 : ℝ) * π ^ 3) * (hk thF2 (xm y) * Zax y * Zax y * Eax y * (Zax y)⁻¹) + ((-16 : ℝ) * π ^ 3) * (hk thF3 (xm y) * Pax y * Uax y * Uax y * (Zax y)⁻¹) + ((1 / 4 : ℝ) * π ^ 3) * (hk thF3 (xm y) * Pax y * Zax y)) * hinv + (((-1 / 2 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Eax y * (Zax y)⁻¹) + ((1 / 8 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Pax y * (Zax y)⁻¹) + ((1 / 2 : ℝ) * π ^ 3) * (hk thF0 (xm y) * Zax y * Eax y * (Zax y)⁻¹ * (Zax y)⁻¹) + ((-1 / 2 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Eax y * (Zax y)⁻¹) + ((3 / 16 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Pax y * (Zax y)⁻¹) + ((1 / 2 : ℝ) * π ^ 3) * (hk thF1 (xm y) * Zax y * Eax y * (Zax y)⁻¹ * (Zax y)⁻¹) + ((-1 / 8 : ℝ) * π ^ 3) * (hk thF2 (xm y) * Eax y * (Zax y)⁻¹) + ((3 / 32 : ℝ) * π ^ 3) * (hk thF2 (xm y) *