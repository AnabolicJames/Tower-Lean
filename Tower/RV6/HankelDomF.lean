import Mathlib
import Tower.RV6.BesselL5
import Tower.RV6.HankelDom

/-!
# `θᵏ f` is in the class `HDom` (`k ≤ 5`)

`ldF0 … ldF4` (the ladder of `f = I₀ K₀³` in `BesselL5.lean`) are sums of constant multiples of
products of one factor `I₀` or `t I₁` (`ITy`) and three factors `K₀` or `t K₁` (`KTy`), so they lie
in `HDom` (`hdom_prod4`, `hdom_const_mul`, `hdom_add`).  The θ-powers `thF0 … thF5` are sums of
`c tᵐ ldF_j` (`hdom_pow_mul`).  So every integrand `tʲ θᵏf(t) g(t)` of the Hankel dual is integrable
on `(0, ∞)` and every boundary term `t² θᵏf(t) g(t)` vanishes at both ends.

Generated by `tools/gen_hankeldomf.py` from the decompositions of `tools/gen_besselL5.py`.
-/

namespace Tower.RV6


theorem hdom_ldF0 : HDom ldF0 := by
  have m1 := hdom_const_mul (1 : ℝ)
    (hdom_prod4 ity_besselI0 kty_besselK0 kty_besselK0 kty_besselK0)
  have h0 := m1
  have hfun : ldF0 = fun x : ℝ =>
      1 * (besselI0 x * besselK0 x * besselK0 x * besselK0 x) := by
    funext x
    unfold ldF0
    ring
  rw [hfun]
  exact h0

theorem hdom_ldF1 : HDom ldF1 := by
  have m1 := hdom_const_mul (1 : ℝ)
    (hdom_prod4 ity_mul_besselI1 kty_besselK0 kty_besselK0 kty_besselK0)
  have m2 := hdom_const_mul (-3 : ℝ)
    (hdom_prod4 ity_besselI0 kty_besselK0 kty_besselK0 kty_mul_besselK1)
  have h0 := hdom_add m1 m2
  have hfun : ldF1 = fun x : ℝ =>
      1 * ((x * besselI1 x) * besselK0 x * besselK0 x * besselK0 x) +
        (-3) * (besselI0 x * besselK0 x * besselK0 x * (x * besselK1 x)) := by
    funext x
    unfold ldF1
    ring
  rw [hfun]
  exact h0

theorem hdom_ldF2 : HDom ldF2 := by
  have m1 := hdom_const_mul (-3 : ℝ)
    (hdom_prod4 ity_mul_besselI1 kty_besselK0 kty_besselK0 kty_mul_besselK1)
  have m2 := hdom_const_mul (3 : ℝ)
    (hdom_prod4 ity_besselI0 kty_besselK0 kty_mul_besselK1 kty_mul_besselK1)
  have h0 := hdom_add m1 m2
  have hfun : ldF2 = fun x : ℝ =>
      (-3) * ((x * besselI1 x) * besselK0 x * besselK0 x * (x * besselK1 x)) +
        3 * (besselI0 x * besselK0 x * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldF2
    ring
  rw [hfun]
  exact h0

theorem hdom_ldF3 : HDom ldF3 := by
  have m1 := hdom_const_mul (3 : ℝ)
    (hdom_prod4 ity_mul_besselI1 kty_besselK0 kty_mul_besselK1 kty_mul_besselK1)
  have m2 := hdom_const_mul (-1 : ℝ)
    (hdom_prod4 ity_besselI0 kty_mul_besselK1 kty_mul_besselK1 kty_mul_besselK1)
  have h0 := hdom_add m1 m2
  have hfun : ldF3 = fun x : ℝ =>
      3 * ((x * besselI1 x) * besselK0 x * (x * besselK1 x) * (x * besselK1 x)) +
        (-1) * (besselI0 x * (x * besselK1 x) * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldF3
    ring
  rw [hfun]
  exact h0

theorem hdom_ldF4 : HDom ldF4 := by
  have m1 := hdom_const_mul (-1 : ℝ)
    (hdom_prod4 ity_mul_besselI1 kty_mul_besselK1 kty_mul_besselK1 kty_mul_besselK1)
  have h0 := m1
  have hfun : ldF4 = fun x : ℝ =>
      (-1) * ((x * besselI1 x) * (x * besselK1 x) * (x * besselK1 x) * (x * besselK1 x)) := by
    funext x
    unfold ldF4
    ring
  rw [hfun]
  exact h0

theorem hdom_thF0 : HDom thF0 := by
  have hfun : thF0 = ldF0 := rfl
  rw [hfun]
  exact hdom_ldF0

theorem hdom_thF1 : HDom thF1 := by
  have hfun : thF1 = ldF1 := rfl
  rw [hfun]
  exact hdom_ldF1

theorem hdom_thF2 : HDom thF2 := by
  have m1 := hdom_const_mul (2 : ℝ) hdom_ldF2
  have m2 := hdom_const_mul (4 : ℝ) (hdom_pow_mul 2 hdom_ldF0)
  have h0 := hdom_add m1 m2
  have hfun : thF2 = fun x : ℝ =>
      2 * ldF2 x + 4 * (x ^ 2 * ldF0 x) := rfl
  rw [hfun]
  exact h0

theorem hdom_thF3 : HDom thF3 := by
  have m1 := hdom_const_mul (6 : ℝ) hdom_ldF3
  have m2 := hdom_const_mul (10 : ℝ) (hdom_pow_mul 2 hdom_ldF1)
  have m3 := hdom_const_mul (8 : ℝ) (hdom_pow_mul 2 hdom_ldF0)
  have h0 := hdom_add (hdom_add m1 m2) m3
  have hfun : thF3 = fun x : ℝ =>
      6 * ldF3 x + 10 * (x ^ 2 * ldF1 x) + 8 * (x ^ 2 * ldF0 x) := rfl
  rw [hfun]
  exact h0

theorem hdom_thF4 : HDom thF4 := by
  have m1 := hdom_const_mul (24 : ℝ) hdom_ldF4
  have m2 := hdom_const_mul (32 : ℝ) (hdom_pow_mul 2 hdom_ldF2)
  have m3 := hdom_const_mul (28 : ℝ) (hdom_pow_mul 2 hdom_ldF1)
  have m4 := hdom_const_mul (16 : ℝ) (hdom_pow_mul 2 hdom_ldF0)
  have m5 := hdom_const_mul (40 : ℝ) (hdom_pow_mul 4 hdom_ldF0)
  have h0 := hdom_add (hdom_add (hdom_add (hdom_add m1 m2) m3) m4) m5
  have hfun : thF4 = fun x : ℝ =>
      24 * ldF4 x + 32 * (x ^ 2 * ldF2 x) + 28 * (x ^ 2 * ldF1 x) + 16 * (x ^ 2 * ldF0 x) +
        40 * (x ^ 4 * ldF0 x) := rfl
  rw [hfun]
  exact h0

theorem hdom_thF5 : HDom thF5 := by
  have m1 := hdom_const_mul (120 : ℝ) (hdom_pow_mul 2 hdom_ldF3)
  have m2 := hdom_const_mul (120 : ℝ) (hdom_pow_mul 2 hdom_ldF2)
  have m3 := hdom_const_mul (72 : ℝ) (hdom_pow_mul 2 hdom_ldF1)
  have m4 := hdom_const_mul (32 : ℝ) (hdom_pow_mul 2 hdom_ldF0)
  have m5 := hdom_const_mul (136 : ℝ) (hdom_pow_mul 4 hdom_ldF1)
  have m6 := hdom_const_mul (272 : ℝ) (hdom_pow_mul 4 hdom_ldF0)
  have h0 := hdom_add (hdom_add (hdom_add (hdom_add (hdom_add m1 m2) m3) m4) m5) m6
  have hfun : thF5 = fun x : ℝ =>
      120 * (x ^ 2 * ldF3 x) + 120 * (x ^ 2 * ldF2 x) + 72 * (x ^ 2 * ldF1 x) +
        32 * (x ^ 2 * ldF0 x) + 136 * (x ^ 4 * ldF1 x) + 272 * (x ^ 4 * ldF0 x) := rfl
  rw [hfun]
  exact h0

end Tower.RV6
